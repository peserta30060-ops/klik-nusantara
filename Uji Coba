        function switchTab(tabName, fromInternalNavigation = false) {
            const target = document.getElementById('tab-' + tabName);
            if (!target) return false;

            // Jika pindah melalui menu utama/bottom navigation, bersihkan layar overlay
            // agar klik tidak tertinggal pada kategori atau tautan sumber.
            if (!fromInternalNavigation) {
                closeTransientOverlays();
                hideCategoryScreen();
                hideDetailScreen();
            }

            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            target.classList.add('active');

            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('text-[#0f4b9b]', 'font-bold');
                btn.classList.add('text-gray-400', 'font-medium');
                const icon = btn.querySelector('i');
                if (icon && icon.classList.contains('fas') &&
                    !icon.classList.contains('fa-home') &&
                    !icon.classList.contains('fa-trophy') &&
                    !icon.classList.contains('fa-book-open') &&
                    !icon.classList.contains('fa-users')) {
                    icon.classList.replace('fas', 'far');
                }
            });

            const activeBtn = document.querySelector(`.nav-btn[data-target="tab-${tabName}"]`);
            if (activeBtn) {
                activeBtn.classList.remove('text-gray-400', 'font-medium');
                activeBtn.classList.add('text-[#0f4b9b]', 'font-bold');
                const activeIcon = activeBtn.querySelector('i');
                if (activeIcon && activeIcon.classList.contains('far')) {
                    activeIcon.classList.replace('far', 'fas');
                }
            }

            if (tabName === 'beranda' && berandaMap) {
                setTimeout(() => { berandaMap.invalidateSize(); }, 200);
            } else if (tabName === 'peta' && fullMap) {
                setTimeout(() => { fullMap.invalidateSize(); }, 200);
            }

            if (tabName === 'profil') {
                const account = getCurrentAccount();
                if (account) {
                    applyLoggedInUser({ ...account, xp: currentXp });
                    renderClassLeaderboard(account);
                }
            } else if (tabName === 'quiz') {
                const account = getCurrentAccount();
                if (account) renderTeacherAssignments(account);
            } else if (tabName === 'beranda-guru') {
                const account = getCurrentAccount();
                if (account?.role === 'guru') renderTeacherHomeDashboard(account);
            } else if (tabName === 'siswa-guru') {
                const account = getCurrentAccount();
                if (account?.role === 'guru') renderTeacherClassDashboard(account);
            } else if (tabName === 'materi') {
