        async function checkBotAiStatus({ force = false } = {}) {
            const now = Date.now();
            if (!force && botLastHealthCheck && (now - botLastHealthCheck) < 15000) return botAiAvailable;
            botLastHealthCheck = now;

            try {
                const controller = new AbortController();
                const timeout = setTimeout(() => controller.abort(), 8000);
                const res = await fetch(`${BOT_API_BASE}/api/health`, {
                    headers: { 'Accept': 'application/json' },
                    cache: 'no-store',
                    signal: controller.signal
                });
                clearTimeout(timeout);

                if (!res.ok) throw new Error(`health ${res.status}`);
                const data = await res.json();

                if (data.ai === true) {
                    botAiAvailable = true;
                    if (botQuotaLimited) {
                        setBotAiStatus('limited', 'Kuota AI Penuh');
                    } else {
                        setBotAiStatus('online', 'Gemini Online');
                    }
                } else {
                    botAiAvailable = false;
                    setBotAiStatus('demo', 'Mode Demo');
                }
                return botAiAvailable;
            } catch (error) {
                // Jangan langsung turun ke Mode Demo hanya karena koneksi sesaat gagal.
                if (botAiAvailable === true) {
                    setBotAiStatus('online', 'Gemini Online');
                } else if (botAiAvailable === false) {
                    setBotAiStatus('demo', 'Mode Demo');
                } else {
                    setBotAiStatus('online', 'Menghubungkan Gemini…');
                }
                return botAiAvailable;
            }
        }

