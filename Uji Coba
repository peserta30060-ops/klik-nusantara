        function normalizeSearchText(value) {
            return String(value ?? '')
                .toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .replace(/[^a-z0-9\s'-]/g, ' ')
                .replace(/\s+/g, ' ')
                .trim();
        }

        function collectSearchableText(value) {
            if (value == null) return '';
            if (typeof value === 'string' || typeof value === 'number') return String(value);
            if (Array.isArray(value)) return value.map(collectSearchableText).join(' ');
            if (typeof value === 'object') {
                return Object.entries(value)
                    .filter(([key]) => !['url', 'img', 'image'].includes(key))
                    .map(([, val]) => collectSearchableText(val))
                    .join(' ');
            }
            return '';
        }

        function buildGlobalSearchIndex() {
            const index = [];

            Object.entries(dataProvinsi || {}).forEach(([province, data]) => {
                index.push({
                    type: 'province',
                    title: province,
                    description: data.ringkas || `Jelajahi informasi lengkap Provinsi ${province}.`,
                    province,
                    category: null,
                    meta: 'Provinsi',
                    icon: 'fa-map-location-dot',
                    searchText: `${province} ${collectSearchableText(data.ringkas)} ${collectSearchableText(data.identitas?.ibukota)}`
                });

                ['identitas','geografi','masyarakat','budaya','potensi','wisata','lagu','quiz'].forEach(category => {
                    const section = data[category];
                    if (!section) return;
                    const label = searchCategoryLabels[category] || category;
                    index.push({
                        type: 'category',
                        title: `${label} — ${province}`,
                        description: section.ringkas || `Buka materi ${label} untuk ${province}.`,
                        province,
                        category,
                        meta: label,
                        icon: searchCategoryIcons[category] || 'fa-book-open',
                        searchText: `${province} ${label} ${collectSearchableText(section)}`
                    });

                    const items = Array.isArray(section.items) ? section.items : [];
                    items.forEach(item => {
                        const itemTitle = item.nama || item.judul || item.kategori || label;
                        const itemDesc = item.deskripsi || item.lokasi || item.asal || section.ringkas || '';
                        index.push({
                            type: 'content',
                            title: itemTitle,
                            description: itemDesc,
                            province,
                            category,
                            meta: `${label} · ${province}`,
                            icon: item.ikon || searchCategoryIcons[category] || 'fa-book-open',
                            searchText: `${province} ${label} ${collectSearchableText(item)}`
                        });
                    });
                });
            });

            (regionalWords || []).forEach((item, idx) => {
                index.push({
                    type: 'regional-word',
                    title: item.word,
                    description: item.meaning,
                    province: item.region,
                    category: null,
                    wordIndex: idx,
                    meta: `${item.language} · ${item.region}`,
                    icon: 'fa-comments',
                    searchText: `${item.word} ${item.meaning} ${item.region} ${item.language} ${item.example} ${item.note}`
                });
            });

            (ipsFacts || []).forEach((item, idx) => {
                index.push({
                    type: 'home-fact',
                    title: item.title,
                    description: item.text,
                    province: item.source,
                    category: null,
                    factIndex: idx,
                    meta: `${item.field} · ${item.source}`,
                    icon: item.icon || 'fa-lightbulb',
                    searchText: `${item.title} ${item.text} ${item.field} ${item.source} ${item.caption || ''}`
                });
            });

            return index;
        }

        function scoreSearchItem(item, query) {
            const q = normalizeSearchText(query);
            const title = normalizeSearchText(item.title);
            const meta = normalizeSearchText(item.meta);
            const text = normalizeSearchText(item.searchText);
            if (!q || !text.includes(q)) return -1;

            let score = 0;
            if (title === q) score += 120;
            else if (title.startsWith(q)) score += 90;
            else if (title.includes(q)) score += 70;
            if (meta.includes(q)) score += 25;
            if (normalizeSearchText(item.province).includes(q)) score += 30;
            if (text.includes(` ${q} `)) score += 15;
            if (item.type === 'content') score += 8;
            if (item.type === 'regional-word') score += 7;
            return score;
        }

        function escapeSearchHtml(str) {
            return String(str ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function highlightSearchMatch(text, query) {
            const safe = escapeSearchHtml(text);
            const q = String(query || '').trim();
            if (!q) return safe;
            const escaped = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            try {
                return safe.replace(new RegExp(`(${escaped})`, 'ig'), '<span class="search-match">$1</span>');
            } catch (_) {
                return safe;
            }
        }

        function performGlobalSearch(query) {
            const q = normalizeSearchText(query);
            if (!q) return [];
            const source = buildGlobalSearchIndex();
            return source
                .map(item => ({ item, score: scoreSearchItem(item, q) }))
                .filter(entry => entry.score >= 0)
                .sort((a, b) => b.score - a.score || a.item.title.localeCompare(b.item.title, 'id'))
                .slice(0, 12)
                .map(entry => entry.item);
        }

        function setGlobalSearchLayer(active) {
            const header = document.getElementById('main-header');
            if (header) header.classList.toggle('search-layer-active', !!active);
