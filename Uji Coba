    window.gradeTeacherSubmission = function(submissionId) {
        const teacher = getCurrentAccount();
        let submissions = getLmsSubmissions();
        const sub = submissions.find(s => String(s.id) === String(submissionId));
        if (!sub) return;
        const task = getTeacherAssignments().find(t => String(t.id) === String(sub.assignmentId));
        if (!task || !lmsTeacherOwnsTask(task, teacher)) return;
        const max = Math.max(1, Number(task.maxScore) || 100);
        const raw = document.getElementById(`grade-${submissionId}`)?.value;
        const score = Number(raw);
        if (!Number.isFinite(score) || score < 0 || score > max) {
            return showToast?.(`Nilai harus antara 0 dan ${max}.`, 'bg-red-600');
        }
        const feedback = String(document.getElementById(`feedback-${submissionId}`)?.value || '').trim();

        // XP diberikan proporsional terhadap nilai dan dapat disesuaikan saat penilaian ulang.
        const newAward = Math.round((Math.max(0, Math.min(max, score)) / max) * (Number(task.xpReward) || 0));
        const oldAward = Number(sub.xpAwardedAmount) || 0;
        const delta = newAward - oldAward;
        if (delta !== 0 && typeof getLocalAccounts === 'function' && typeof saveLocalAccounts === 'function') {
            const accounts = getLocalAccounts();
            const idx = accounts.findIndex(a => String(a.id) === String(sub.studentId));
            if (idx >= 0) {
                accounts[idx].xp = Math.max(0, (Number(accounts[idx].xp) || 0) + delta);
                saveLocalAccounts(accounts);
            }
        }

        submissions = submissions.map(s => String(s.id) === String(submissionId) ? {
            ...s,
            status:'graded',
            grade:score,
            feedback,
            gradedAt:new Date().toISOString(),
            gradedById:teacher.id,
            gradedByName:teacher.name || 'Guru',
            xpAwardedAmount:newAward
        } : s);
        saveLmsSubmissions(submissions);
        openTeacherLmsReview(task.id, false);
        renderTeacherLms();
        showToast?.('Nilai dan feedback berhasil disimpan.', 'bg-violet-600');
    };

    window.returnTeacherSubmission = function(submissionId) {
        const teacher = getCurrentAccount();
        let submissions = getLmsSubmissions();
        const sub = submissions.find(s => String(s.id) === String(submissionId));
        if (!sub) return;
        const task = getTeacherAssignments().find(t => String(t.id) === String(sub.assignmentId));
        if (!task || !lmsTeacherOwnsTask(task, teacher)) return;
        if (!confirm('Kembalikan tugas ini ke siswa untuk diperbaiki dan dikumpulkan ulang?')) return;
        const feedback = String(document.getElementById(`feedback-${submissionId}`)?.value || sub.feedback || '').trim();
        submissions = submissions.map(s => String(s.id) === String(submissionId) ? {
            ...s, status:'returned', feedback, returnedAt:new Date().toISOString()
        } : s);
        saveLmsSubmissions(submissions);
        openTeacherLmsReview(task.id, false);
        renderTeacherLms();
        showToast?.('Tugas dikembalikan ke siswa untuk revisi.', 'bg-amber-600');
    };

