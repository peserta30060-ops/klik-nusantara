        function renderGlobalSearchResults(query) {
            const panel = document.getElementById('search-results-panel');
            const clearBtn = document.getElementById('search-clear-btn');
            if (!panel) return;

            const raw = String(query || '').trim();
            if (clearBtn) clearBtn.classList.toggle('hidden', !raw);

            if (!raw) {
                panel.classList.remove('show');
                panel.innerHTML = '';
                globalSearchResults = [];
                globalSearchActiveIndex = -1;
                setGlobalSearchLayer(false);
                return;
            }

            setGlobalSearchLayer(true);

            globalSearchResults = performGlobalSearch(raw);
            globalSearchActiveIndex = -1;

            const header = `
                <div class="search-panel-head">
                    <div>
                        <p class="text-[8px] uppercase tracking-[0.14em] font-black text-blue-500">Hasil Pencarian</p>
                        <p class="text-[10px] font-extrabold text-gray-700 mt-0.5">“${escapeSearchHtml(raw)}”</p>
                    </div>
                    <span class="text-[8px] font-bold text-gray-400">${globalSearchResults.length} hasil</span>
                </div>`;

            if (!globalSearchResults.length) {
                panel.innerHTML = header + `
                    <div class="search-empty">
                        <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-500 flex items-center justify-center mx-auto text-lg">
                            <i class="fas fa-search"></i>
                        </div>
                        <p class="text-[11px] font-extrabold text-gray-700 mt-3">Belum ada hasil yang cocok</p>
                        <p class="text-[9px] mt-1">Coba kata seperti <b>Mahakam</b>, <b>Angklung</b>, <b>Bali</b>, <b>Sentani</b>, atau <b>Sampurasun</b>.</p>
                    </div>`;
                panel.classList.add('show');
                return;
            }

            const items = globalSearchResults.map((item, idx) => `
                <button type="button" class="search-result-item" data-search-index="${idx}" onclick="openGlobalSearchResult(${idx})" role="option">
                    <span class="search-result-icon"><i class="fas ${escapeSearchHtml(item.icon || 'fa-search')}"></i></span>
                    <span class="min-w-0 flex-1">
                        <span class="search-result-title block">${highlightSearchMatch(item.title, raw)}</span>
                        <span class="search-result-desc block">${highlightSearchMatch(item.description || '', raw)}</span>
                        <span class="search-result-meta">
                            <span class="search-result-chip">${escapeSearchHtml(item.meta || 'Klik Nusantara')}</span>
                        </span>
                    </span>
                    <i class="fas fa-chevron-right text-[9px] text-gray-300 mt-3"></i>
                </button>`).join('');

            panel.innerHTML = header + items;
            panel.classList.add('show');
        }

