        function exportTeacherStudentProgress() {
            const teacher = getCurrentAccount();
            const active = getActiveTeacherClass(teacher);
            if (!active) return showToast('Belum ada kelas untuk diekspor.', 'bg-amber-600');
            const students = getStudentsForClass(active.classCode);
            if (!students.length) return showToast('Belum ada siswa pada kelas ini.', 'bg-amber-600');
            const rows = [['Nama Siswa','Nama Kelas','Kode Kelas','Kuis Provinsi Selesai','Total Kuis Provinsi','Progress (%)','XP']];
            students.forEach(student => {
                const p = getStudentProvinceQuizProgress(student.id);
                rows.push([student.name, active.className, active.classCode, p.completed, p.total, p.pct, Number(student.xp)||0]);
            });
            const csv = rows.map(row => row.map(cell => `"${String(cell ?? '').replace(/"/g, '""')}"`).join(',')).join('\r\n');
            const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `pantauan-${active.classCode}.csv`;
            document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url);
        }

