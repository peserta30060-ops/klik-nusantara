                        </div>
                    </div>
                    <span class="lms-status-pill ${statusCls} shrink-0"><i class="fas ${statusIcon}"></i>${statusText}</span>
                </div>
                <div class="grid grid-cols-3 gap-2 mt-4">
                    <div class="rounded-xl bg-slate-50 p-2.5 text-center"><p class="text-[8px] text-slate-400 font-bold">Bagian</p><p class="text-xs font-black text-slate-800 mt-0.5">${Number(task.questionCount)||1}</p></div>
                    <div class="rounded-xl bg-amber-50 p-2.5 text-center"><p class="text-[8px] text-amber-600 font-bold">Bonus</p><p class="text-xs font-black text-amber-700 mt-0.5">+${Number(task.xpReward)||0} XP</p></div>
                    <div class="rounded-xl ${overdue ? 'bg-rose-50' : 'bg-blue-50'} p-2.5 text-center"><p class="text-[8px] ${overdue ? 'text-rose-500' : 'text-blue-500'} font-bold">Tenggat</p><p class="text-[8.5px] font-black ${overdue ? 'text-rose-700' : 'text-blue-700'} mt-0.5 leading-tight">${lmsEsc(lmsDeadlineLabel(task))}</p></div>
                </div>
                <div class="mt-3 pt-3 border-t border-slate-100 flex items-center justify-between gap-3">
                    <p class="text-[8.5px] text-slate-400">${task.attachmentName ? `<i class="fas fa-paperclip mr-1"></i>${lmsEsc(task.attachmentName)}` : '<i class="fas fa-align-left mr-1"></i>Materi & instruksi tersedia'}</p>
                    <button type="button" onclick="openTeacherAssignment('${lmsEsc(task.id)}')" class="rounded-xl bg-emerald-600 text-white px-3 py-2 text-[9px] font-black hover:bg-emerald-700 active:scale-95">${sub?.status === 'graded' ? 'Lihat Nilai' : 'Buka Tugas'} <i class="fas fa-arrow-right ml-1"></i></button>
                </div>
            </article>`;
        }).join('');
    };

    function studentSubmissionUi(task, account, sub) {
        const requires = task.requiresSubmission !== false;
        if (!requires) {
            return `<div class="student-submission-status bg-blue-50 border-blue-100 mt-4">
                <p class="text-[9px] font-black text-blue-700"><i class="fas fa-book-open mr-1.5"></i>Materi Bacaan</p>
                <p class="text-[9.5px] text-blue-700/80 mt-1">Guru tidak mewajibkan pengumpulan pada materi ini.</p>
            </div>`;
        }

        if (sub?.status === 'graded') {
            return `<div class="student-submit-box mt-4">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <p class="text-[8px] uppercase tracking-[0.14em] font-black text-violet-600">Penilaian Guru</p>
                        <h4 class="text-base font-black text-slate-900 mt-1">Nilai ${Number(sub.grade) || 0} / ${Number(task.maxScore) || 100}</h4>
                        <p class="text-[8.5px] text-slate-400 mt-1">Dinilai ${sub.gradedAt ? new Date(sub.gradedAt).toLocaleString('id-ID') : ''} · XP diperoleh ${Number(sub.xpAwardedAmount)||0}</p>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-violet-100 text-violet-700 flex items-center justify-center"><i class="fas fa-medal text-xl"></i></div>
                </div>
                <div class="mt-3 rounded-xl bg-white border border-violet-100 p-3">
                    <p class="text-[8px] font-black uppercase tracking-wider text-violet-500">Feedback Guru</p>
                    <p class="text-[10px] text-slate-700 leading-relaxed whitespace-pre-wrap mt-1.5">${lmsEsc(sub.feedback || 'Guru belum menambahkan komentar.')}</p>
                </div>
                <div class="mt-3 rounded-xl bg-white/70 border border-slate-200 p-3">
                    <p class="text-[8px] font-black uppercase text-slate-400">Jawaban yang Dikumpulkan</p>
                    <p class="text-[9.5px] text-slate-700 whitespace-pre-wrap mt-1">${lmsEsc(sub.answerText || 'Tidak ada jawaban teks.')}</p>
                    ${sub.fileName ? `<button onclick="downloadStudentSubmissionFile('${lmsEsc(sub.id)}')" class="mt-2 rounded-lg bg-blue-600 text-white px-3 py-2 text-[8px] font-black"><i class="fas fa-download mr-1"></i>${lmsEsc(sub.fileName)}</button>` : ''}
                </div>
            </div>`;
        }

        if (sub?.status === 'submitted') {
            return `<div class="student-submit-box mt-4">
                <div class="flex items-start gap-3">
                    <div class="w-11 h-11 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center"><i class="fas fa-circle-check"></i></div>
                    <div class="flex-1">
                        <p class="text-[9px] font-black text-emerald-700">${sub.submittedLate ? 'Tugas sudah dikumpulkan terlambat' : 'Tugas sudah dikumpulkan'}</p>
                        <p class="text-[8.5px] text-slate-500 mt-1">${sub.submittedAt ? new Date(sub.submittedAt).toLocaleString('id-ID') : ''} · Menunggu penilaian guru.</p>
                    </div>
                </div>
                <div class="mt-3 rounded-xl bg-white border border-slate-200 p-3">
                    <p class="text-[8px] font-black uppercase text-slate-400">Jawaban</p>
                    <p class="text-[9.5px] text-slate-700 whitespace-pre-wrap mt-1">${lmsEsc(sub.answerText || 'Tidak ada jawaban teks.')}</p>
                    ${sub.fileName ? `<button onclick="downloadStudentSubmissionFile('${lmsEsc(sub.id)}')" class="mt-2 rounded-lg bg-blue-600 text-white px-3 py-2 text-[8px] font-black"><i class="fas fa-download mr-1"></i>${lmsEsc(sub.fileName)}</button>` : ''}
                </div>
                ${task.status === 'aktif' ? `<button onclick="withdrawStudentSubmission('${lmsEsc(task.id)}')" class="mt-3 rounded-xl border border-amber-200 bg-amber-50 text-amber-700 px-3.5 py-2.5 text-[8.5px] font-black"><i class="fas fa-rotate-left mr-1"></i>Tarik Kembali untuk Diedit</button>` : ''}
            </div>`;
        }

        const returned = sub?.status === 'returned';
        const overdue = isTaskOverdue(task);
        const blocked = (task.status === 'ditutup' || task.status === 'selesai') || (overdue && task.allowLate === false);
        return `<div class="student-submit-box mt-4">
            ${returned ? `<div class="mb-3 rounded-xl bg-amber-50 border border-amber-100 p-3"><p class="text-[9px] font-black text-amber-700"><i class="fas fa-rotate-left mr-1"></i>Dikembalikan untuk revisi</p><p class="text-[9px] text-amber-700 mt-1 whitespace-pre-wrap">${lmsEsc(sub.feedback || 'Perbaiki tugas lalu kumpulkan kembali.')}</p></div>` : ''}
            ${overdue ? `<div class="mb-3 rounded-xl bg-rose-50 border border-rose-100 p-3 text-[9px] text-rose-700"><i class="fas fa-clock mr-1.5"></i>Tenggat telah lewat.${task.allowLate === false ? ' Pengumpulan sudah ditutup.' : ' Guru masih mengizinkan pengumpulan terlambat.'}</div>` : ''}
            <p class="text-[8px] uppercase tracking-[0.14em] font-black text-indigo-600">Lembar Pengumpulan</p>
            <label class="lms-label mt-3">Jawaban / Catatan Siswa</label>
            <textarea id="student-lms-answer" rows="7" class="lms-input resize-y" placeholder="Tulis jawaban, laporan singkat, tautan karya, atau catatan untuk guru..." ${blocked ? 'disabled' : ''}>${lmsEsc(sub?.answerText || '')}</textarea>
            <label class="lms-label mt-3">Unggah File Jawaban</label>
            <label class="lms-upload-box ${blocked ? 'opacity-60 pointer-events-none' : ''}">
                <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0"><i class="fas fa-file-arrow-up"></i></div>
                <div class="min-w-0 flex-1">
                    <p class="text-[10px] font-black text-slate-700">Pilih file jawaban</p>
                    <p id="student-lms-file-label" class="text-[8.5px] text-slate-400 mt-0.5 truncate">${sub?.fileName ? 'File saat ini: ' + lmsEsc(sub.fileName) : 'PDF, DOCX, gambar, ZIP, atau file lain'}</p>
                </div>
                <input id="student-lms-file" type="file" class="hidden" onchange="syncStudentLmsFileLabel()" ${blocked ? 'disabled' : ''}>
            </label>
            <div id="student-lms-submit-feedback" class="hidden mt-3"></div>
            <div class="mt-4 flex flex-col sm:flex-row gap-2 sm:justify-end">
                <button onclick="saveStudentAssignmentDraft('${lmsEsc(task.id)}')" ${blocked ? 'disabled' : ''} class="rounded-xl bg-white border border-slate-200 text-slate-600 px-4 py-2.5 text-[9px] font-black disabled:opacity-50"><i class="fas fa-floppy-disk mr-1"></i>Simpan Draft</button>
                <button onclick="submitStudentAssignment('${lmsEsc(task.id)}')" ${blocked ? 'disabled' : ''} class="rounded-xl bg-emerald-600 text-white px-5 py-2.5 text-[9px] font-black shadow-sm disabled:opacity-50"><i class="fas fa-paper-plane mr-1.5"></i>Kumpulkan Tugas</button>
            </div>
        </div>`;
    }

    openTeacherAssignment = window.openTeacherAssignment = function(id) {
        const account = getCurrentAccount();
        if (!account || account.role !== 'siswa') return;
        const task = getTeacherAssignments().find(t => String(t.id) === String(id));
        if (!task) return showToast?.('Tugas tidak ditemukan.', 'bg-red-600');
        const stage = document.getElementById('teacher-assignment-detail-stage');
        const detail = document.getElementById('teacher-assignment-detail-screen');
        const list = document.getElementById('teacher-assignments-section');
        if (!stage || !detail) return;
        const sub = getLmsSubmission(task.id, account.id);
        const overdue = isTaskOverdue(task);
        const closed = task.status === 'ditutup' || task.status === 'selesai';

        stage.innerHTML = `
            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
                <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap gap-1.5">
                        <span class="lms-status-pill bg-violet-50 text-violet-700 border-violet-100">${lmsEsc(taskTypeLabel(task.assignmentType))}</span>
                        <span class="lms-status-pill ${closed ? 'bg-slate-100 text-slate-600 border-slate-200' : 'bg-emerald-50 text-emerald-700 border-emerald-100'}">${closed ? '<i class="fas fa-lock"></i>Ditutup' : '<i class="fas fa-circle-check"></i>Aktif'}</span>
                        ${overdue ? '<span class="lms-status-pill bg-rose-50 text-rose-700 border-rose-100"><i class="fas fa-clock"></i>Lewat Tenggat</span>' : ''}
                    </div>
                    <p class="text-[9px] uppercase tracking-[0.14em] font-black text-teal-600 mt-4">${lmsEsc(task.subject || 'IPS')}</p>
                    <h3 class="text-xl sm:text-2xl font-black text-slate-900 leading-tight mt-1">${lmsEsc(task.title || 'Tugas Guru')}</h3>
                    <p class="text-[9px] text-slate-400 mt-2"><i class="fas fa-chalkboard-user mr-1"></i>${lmsEsc(task.teacher || 'Guru')} · ${lmsEsc(task.className || task.classCode || '')}</p>
                </div>
                <div class="w-16 h-16 rounded-[20px] bg-gradient-to-br from-emerald-50 to-blue-100 border border-emerald-100 text-emerald-600 flex items-center justify-center shrink-0"><i class="fas fa-file-circle-check text-2xl"></i></div>
            </div>

            <div class="grid grid-cols-2 lg:grid-cols-4 gap-2 mt-5">
                <div class="rounded-xl bg-slate-50 border border-slate-100 p-3"><p class="text-[8px] uppercase font-black text-slate-400">Tenggat</p><p class="text-[9px] font-black text-slate-800 mt-1">${lmsEsc(lmsDeadlineLabel(task))}</p></div>
                <div class="rounded-xl bg-violet-50 border border-violet-100 p-3"><p class="text-[8px] uppercase font-black text-violet-400">Nilai Maks.</p><p class="text-sm font-black text-violet-700 mt-1">${Number(task.maxScore)||100}</p></div>
                <div class="rounded-xl bg-amber-50 border border-amber-100 p-3"><p class="text-[8px] uppercase font-black text-amber-500">Bonus XP</p><p class="text-sm font-black text-amber-700 mt-1">+${Number(task.xpReward)||0}</p></div>
                <div class="rounded-xl bg-blue-50 border border-blue-100 p-3"><p class="text-[8px] uppercase font-black text-blue-400">Bagian</p><p class="text-sm font-black text-blue-700 mt-1">${Number(task.questionCount)||1}</p></div>
            </div>

            <div class="mt-4 rounded-2xl bg-slate-50 border border-slate-200 p-4">
                <p class="text-[8px] font-black uppercase tracking-[0.14em] text-slate-400">Materi & Instruksi Guru</p>
                <p class="text-[10.5px] text-slate-700 leading-relaxed whitespace-pre-wrap mt-2">${lmsEsc(task.instructions || task.description || 'Tidak ada instruksi tambahan.')}</p>
            </div>

            ${task.attachmentName ? `<div class="mt-3 rounded-2xl border border-blue-100 bg-blue-50/70 p-3 flex items-center justify-between gap-3"><div class="min-w-0"><p class="text-[8px] font-black uppercase text-blue-500">Lampiran Guru</p><p class="text-[9.5px] font-bold text-slate-800 mt-1 truncate"><i class="fas fa-paperclip text-blue-500 mr-1"></i>${lmsEsc(task.attachmentName)}</p></div><button onclick="downloadLmsAssignmentAttachment('${lmsEsc(task.id)}')" class="rounded-xl bg-blue-600 text-white px-3 py-2 text-[8px] font-black"><i class="fas fa-download mr-1"></i>Buka</button></div>` : ''}

            ${studentSubmissionUi(task, account, sub)}

            <div class="mt-5 pt-4 border-t border-slate-100">
                <button onclick="closeTeacherAssignmentDetail()" class="rounded-xl bg-white border border-slate-200 text-slate-600 px-4 py-2.5 text-[9px] font-black"><i class="fas fa-arrow-left mr-1.5"></i>Kembali ke Daftar Tugas</button>
            </div>
        `;
        list?.classList.add('hidden');
        detail.classList.remove('hidden');
        const scroller = detail.querySelector('.quiz-page-content'); if (scroller) scroller.scrollTop = 0;
    };

    window.syncStudentLmsFileLabel = function() {
        const input = document.getElementById('student-lms-file');
        const label = document.getElementById('student-lms-file-label');
        if (!label) return;
        const file = input?.files?.[0];
        if (file) label.textContent = `${file.name} • ${Math.max(1, Math.round(file.size/1024))} KB`;
    };

    function setStudentSubmitFeedback(message, error=false) {
        const el = document.getElementById('student-lms-submit-feedback');
        if (!el) return;
        if (!message) { el.classList.add('hidden'); el.innerHTML=''; return; }
        el.className = `mt-3 rounded-xl px-3 py-2 text-[9px] ${error ? 'bg-red-50 border border-red-100 text-red-700' : 'bg-emerald-50 border border-emerald-100 text-emerald-700'}`;
        el.textContent = message;
    }

    async function collectStudentSubmission(task, finalSubmit) {
        const account = getCurrentAccount();
        if (!account || account.role !== 'siswa') return;
        const answer = String(document.getElementById('student-lms-answer')?.value || '').trim();
        const file = document.getElementById('student-lms-file')?.files?.[0] || null;
        const existing = getLmsSubmission(task.id, account.id);
        if (finalSubmit && !answer && !file && !existing?.fileName) {
            return setStudentSubmitFeedback('Tuliskan jawaban atau unggah file sebelum mengumpulkan.', true);
        }
        const result = await lmsFileToDataUrl(file);
        let submissions = getLmsSubmissions();
        const record = {
            ...(existing || {}),
            id: existing?.id || `SUB-${task.id}-${account.id}-${Date.now()}`,
            assignmentId: task.id,
            studentId: account.id,
            studentName: account.name || 'Siswa',
            classCode: account.classCode || task.classCode,
            className: account.className || task.className,
            answerText: answer,
            fileName: file ? file.name : (existing?.fileName || ''),
            fileType: file ? file.type : (existing?.fileType || ''),
            fileSize: file ? file.size : (existing?.fileSize || 0),
            fileData: file ? result.data : (existing?.fileData || null),
            status: finalSubmit ? 'submitted' : 'draft',
            updatedAt: new Date().toISOString(),
            submittedAt: finalSubmit ? new Date().toISOString() : (existing?.submittedAt || null),
            submittedLate: finalSubmit ? isTaskOverdue(task) : (existing?.submittedLate || false)
        };
        if (existing) submissions = submissions.map(s => String(s.id) === String(existing.id) ? record : s);
        else submissions.unshift(record);
        saveLmsSubmissions(submissions);
        if (finalSubmit) {
            setStudentSubmitFeedback(result.oversized ? 'Tugas berhasil dikumpulkan. File besar dicatat namanya, tetapi untuk penyimpanan file penuh lintas perangkat diperlukan backend.' : 'Tugas berhasil dikumpulkan.', false);
            showToast?.('Tugas berhasil dikumpulkan ke guru.', 'bg-emerald-600');
            setTimeout(() => openTeacherAssignment(task.id), 250);
        } else {
            setStudentSubmitFeedback(result.oversized ? 'Draft tersimpan. File besar hanya dicatat namanya pada prototype.' : 'Draft berhasil disimpan.', false);
            showToast?.('Draft tersimpan.', 'bg-blue-600');
        }
        renderTeacherAssignments(account);
    }

    window.saveStudentAssignmentDraft = function(taskId) {
        const task = getTeacherAssignments().find(t => String(t.id) === String(taskId));
        if (!task) return;
        collectStudentSubmission(task, false);
    };

    window.submitStudentAssignment = function(taskId) {
        const task = getTeacherAssignments().find(t => String(t.id) === String(taskId));
        if (!task) return;
        if ((task.status === 'ditutup' || task.status === 'selesai')) return showToast?.('Tugas sudah ditutup oleh guru.', 'bg-amber-600');
        if (isTaskOverdue(task) && task.allowLate === false) return showToast?.('Tenggat sudah lewat dan pengumpulan ditutup.', 'bg-red-600');
        if (!confirm('Kumpulkan tugas sekarang? Guru akan dapat melihat jawaban dan file yang kamu kirim.')) return;
        collectStudentSubmission(task, true);
    };

    window.withdrawStudentSubmission = function(taskId) {
        const account = getCurrentAccount();
        let submissions = getLmsSubmissions();
        const sub = submissions.find(s => String(s.assignmentId) === String(taskId) && String(s.studentId) === String(account?.id));
        if (!sub || sub.status !== 'submitted') return;
        if (!confirm('Tarik kembali pengumpulan agar dapat diedit? Setelah itu kamu harus mengumpulkannya lagi.')) return;
        submissions = submissions.map(s => String(s.id) === String(sub.id) ? {...s, status:'draft', submittedAt:null, updatedAt:new Date().toISOString()} : s);
        saveLmsSubmissions(submissions);
        openTeacherAssignment(taskId);
        renderTeacherAssignments(account);
        showToast?.('Pengumpulan ditarik kembali menjadi draft.', 'bg-amber-600');
    };

    // Saat membuka panel Tugas Guru siswa, refresh status LMS.
    openTeacherAssignmentsPanel = window.openTeacherAssignmentsPanel = function() {
        const account = getCurrentAccount();
        if (!account || account.role !== 'siswa') {
            showToast?.('Tugas Guru tersedia setelah masuk sebagai siswa.', 'bg-amber-600');
            return;
        }
        renderTeacherAssignments(account);
        ['quick-quiz-screen','image-quiz-screen','matching-quiz-screen','time-challenge-screen','teacher-lms-screen','teacher-assignment-detail-screen']
            .forEach(id => document.getElementById(id)?.classList.add('hidden'));
        const screen = document.getElementById('teacher-assignments-section');
        screen?.classList.remove('hidden');
        const scroller = screen?.querySelector('.quiz-page-content'); if (scroller) scroller.scrollTop = 0;
    };

})();
</script>


<script>
(function(){
    function kmEsc(value){
        if (typeof escapeHtml === 'function') return escapeHtml(value ?? '');
        const d=document.createElement('div'); d.textContent=String(value ?? ''); return d.innerHTML;
    }

    function getStudentClassMaterials(account = getCurrentAccount()){
        if (!account || account.role !== 'siswa') return [];
        const code=String(account.classCode || '').trim().toUpperCase();
        if (!code) return [];
        return getTeacherDistributions()
            .filter(item => String(item.classCode || '').trim().toUpperCase() === code && item.type === 'materi')
            .sort((a,b)=> String(b.createdAt || '').localeCompare(String(a.createdAt || '')));
    }

    function materialDateLabel(value){
        if (!value) return 'Materi Guru';
        const d=new Date(value);
        if (Number.isNaN(d.getTime())) return 'Materi Guru';
        try { return new Intl.DateTimeFormat('id-ID',{day:'numeric',month:'short',year:'numeric'}).format(d); }
        catch(e){ return 'Materi Guru'; }
    }

    window.renderTeacherMaterialCollection = function(account = getCurrentAccount()){
        const host=document.getElementById('teacher-material-collection-cards');
        const totalEl=document.getElementById('materi-total-available');
        const countEl=document.getElementById('materi-section-count');
        if (!host) return;
        if (!account || account.role !== 'siswa') {
            host.innerHTML='';
            if(totalEl) totalEl.textContent='2';
            if(countEl) countEl.textContent='2 Modul';
            return;
        }
        const materials=getStudentClassMaterials(account);
        if(totalEl) totalEl.textContent=String(2 + materials.length);
        if(countEl) countEl.textContent=`${2 + materials.length} Modul`;

        const icons=['fa-chalkboard-user','fa-book-open-reader','fa-file-lines','fa-lightbulb','fa-earth-asia','fa-landmark'];
        host.innerHTML=materials.map((item,index)=>{
            const number=String(index+3).padStart(2,'0');
            const icon=icons[index % icons.length];
            const desc=String(item.message || (item.fileName ? `Materi dilengkapi lampiran ${item.fileName}.` : 'Materi khusus yang dikirim oleh guru untuk kelasmu.'));
            return `<article onclick="openTeacherMaterialCollection('${kmEsc(item.id)}')" class="materi-card materi-card-teacher cursor-pointer">
                <div class="materi-card-visual">
                    <div class="materi-card-pattern"></div>
                    <div class="materi-card-icon"><i class="fas ${icon}"></i></div>
                    <span class="materi-card-number">${number}</span>
                </div>
                <div class="materi-card-body">
                    <div class="flex flex-wrap items-center gap-1.5 mb-2">
                        <div class="materi-card-tag"><i class="fas fa-chalkboard-user"></i> Dari Guru</div>
                        <span class="materi-teacher-badge"><i class="fas fa-users"></i>${kmEsc(item.className || item.classCode || 'Kelas')}</span>
                    </div>
                    <h3>${kmEsc(item.title || 'Materi dari Guru')}</h3>
                    <p>${kmEsc(desc)}</p>
                    <div class="materi-card-meta">
                        <span><i class="fas fa-user-tie"></i> ${kmEsc(item.teacherName || 'Guru')}</span>
                        <span><i class="fas ${item.fileName ? 'fa-paperclip' : 'fa-file-lines'}"></i> ${item.fileName ? 'Ada Lampiran' : 'Materi Teks'}</span>
                    </div>
                    <div class="materi-card-action">
                        <span>Buka Materi</span>
                        <div><i class="fas fa-arrow-right"></i></div>
                    </div>
                </div>
            </article>`;
        }).join('');
    };

    window.openTeacherMaterialCollection = function(id){
        const account=getCurrentAccount();
        if (!account || account.role !== 'siswa') return;
        const item=getTeacherDistributions().find(entry => String(entry.id) === String(id));
        if (!item || item.type !== 'materi') return showToast?.('Materi tidak ditemukan.', 'bg-red-600');
        if (String(item.classCode || '').toUpperCase() !== String(account.classCode || '').toUpperCase()) return;

        genericCategoryReturnTab='materi';
        provinceNavigationLevel='category';
        currentProvinceCategory=null;
        document.getElementById('cat-province').innerText='Koleksi Materi · Dari Guru';
        document.getElementById('cat-title').innerText=item.title || 'Materi dari Guru';
        document.getElementById('cat-icon').className='fas fa-chalkboard-user text-violet-600';
