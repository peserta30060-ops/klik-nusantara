        async function requestGeminiChat(payload, attempt = 0) {
            const controller = new AbortController();
            const timeout = setTimeout(() => controller.abort(), 45000);
            try {
                const res = await fetch(`${BOT_API_BASE}/api/chat`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    cache: 'no-store',
                    signal: controller.signal,
                    body: JSON.stringify(payload)
                });

                const data = await res.json().catch(() => ({}));
                if (!res.ok) {
                    const err = new Error(data.error || `Gemini gagal (${res.status})`);
                    err.status = res.status;
                    throw err;
                }
                return data;
            } catch (error) {
                // Satu retry untuk gangguan sementara, timeout, atau error server.
                const retryable = attempt === 0 && (!error.status || error.status >= 500 || error.name === 'AbortError');
                if (retryable) {
                    await new Promise(resolve => setTimeout(resolve, 900));
                    return requestGeminiChat(payload, 1);
                }
                throw error;
            } finally {
                clearTimeout(timeout);
            }
        }

        async function sendChatMessage() {
            if (botRequestInFlight) return;
            const inputEl = document.getElementById('chat-input');
            const message = inputEl?.value.trim();
            if (!message) return;

            appendChatBubble('user', message);
            inputEl.value = '';
            botConversation.push({ role: 'user', content: message });
            if (botConversation.length > 12) botConversation.splice(0, botConversation.length - 12);

            botRequestInFlight = true;
            inputEl.disabled = true;
            showBotTyping();

            try {
                const data = await requestGeminiChat({
                    message,
                    history: botConversation.slice(0, -1),
                    context: getBotPageContext()
                });

                const reply = (data.reply || '').trim() || 'Maaf, saya belum mendapatkan jawaban.';
                removeBotTyping();
                appendChatBubble('assistant', reply);
                botConversation.push({ role: 'assistant', content: reply });
                if (botConversation.length > 12) botConversation.splice(0, botConversation.length - 12);

                botAiAvailable = true;
                botQuotaLimited = false;
                botLastHealthCheck = Date.now();
                setBotAiStatus('online', 'Gemini Online');
            } catch (error) {
                removeBotTyping();

                const errorText = String(error?.message || '').toLowerCase();
                const isQuotaError = error?.status === 429 ||
                    /quota|exceeded|resource_exhausted|rate limit|too many requests/.test(errorText);

                if (isQuotaError) {
                    // Backend dan Gemini tetap terhubung, tetapi batas pemakaian API sedang tercapai.
                    botAiAvailable = true;
                    botQuotaLimited = true;
                    setBotAiStatus('limited', 'Kuota AI Penuh');
