<script>
(function(){
    function tqEsc(value) {
        if (typeof escapeHtml === 'function') return escapeHtml(value ?? '');
        const d = document.createElement('div');
        d.textContent = String(value ?? '');
        return d.innerHTML;
    }

    window.openTeacherQuizMain = function(event) {
        if (typeof goToMainMenu === 'function') goToMainMenu('quiz', event);
        setTimeout(() => {
            renderTeacherQuizWorkspace();
            const tab = document.getElementById('tab-quiz');
            if (tab) tab.scrollTop = 0;
        }, 0);
        return false;
    };

    function setTeacherQuizFeedback(message='', error=false) {
        const el = document.getElementById('teacher-quiz-feedback');
        if (!el) return;
        if (!message) {
            el.classList.add('hidden');
            el.textContent = '';
            return;
        }
        el.className = `mt-3 rounded-xl px-3 py-2 text-[9.5px] ${error ? 'bg-red-50 border border-red-100 text-red-700' : 'bg-emerald-50 border border-emerald-100 text-emerald-700'}`;
        el.textContent = message;
    }

    window.syncTeacherQuizFileLabel = function() {
        const file = document.getElementById('teacher-quiz-file')?.files?.[0];
        const label = document.getElementById('teacher-quiz-file-label');
        if (!label) return;
        label.textContent = file ? `${file.name} • ${Math.max(1, Math.round(file.size/1024))} KB` : 'Pilih file';
    };

    window.renderTeacherQuizWorkspace = function(teacher = (typeof getCurrentAccount === 'function' ? getCurrentAccount() : null)) {
        const panel = document.getElementById('teacher-quiz-management-panel');
        if (!panel) return;

        const isTeacher = teacher?.role === 'guru';
        panel.classList.toggle('hidden', !isTeacher);
        if (!isTeacher) return;

        const classSelect = document.getElementById('teacher-quiz-class-select');
        const classes = typeof getTeacherManagedClasses === 'function' ? getTeacherManagedClasses(teacher) : [];
        const active = typeof getActiveTeacherClass === 'function' ? getActiveTeacherClass(teacher) : null;

        if (classSelect) {
            const oldValue = classSelect.value;
            classSelect.innerHTML = classes.length
                ? classes.map(c => `<option value="${tqEsc(c.classCode)}">${tqEsc(c.className)} (${tqEsc(c.classCode)})</option>`).join('')
                : '<option value="">Belum ada kelas</option>';

            if (oldValue && classes.some(c => c.classCode === oldValue)) classSelect.value = oldValue;
            else if (active?.classCode) classSelect.value = active.classCode;
        }

        renderTeacherQuizHistory(teacher);
    };

    window.renderTeacherQuizHistory = function(teacher = getCurrentAccount()) {
        const history = document.getElementById('teacher-quiz-history');
        const count = document.getElementById('teacher-quiz-history-count');
        if (!history || !teacher || teacher.role !== 'guru') return;

        const items = getTeacherDistributions()
            .filter(item => item.teacherId === teacher.id && item.type === 'kuis')
            .slice(0, 12);

        if (count) count.textContent = `${items.length} Quiz`;

        if (!items.length) {
            history.innerHTML = `
                <div class="rounded-xl bg-slate-50 border border-dashed border-slate-200 p-4 text-center">
                    <i class="fas fa-file-circle-question text-slate-300 text-xl"></i>
                    <p class="text-[9.5px] text-slate-500 mt-2">Belum ada quiz khusus yang dikirim ke kelas.</p>
                </div>`;
            return;
        }

        history.innerHTML = items.map(item => `
            <article class="teacher-quiz-history-card">
                <div class="flex items-start justify-between gap-3">
                    <div class="flex items-start gap-3 min-w-0">
                        <div class="w-9 h-9 rounded-xl bg-violet-100 text-violet-700 flex items-center justify-center shrink-0">
                            <i class="fas fa-file-circle-question"></i>
                        </div>
                        <div class="min-w-0">
                            <div class="flex flex-wrap gap-1.5 items-center">
                                <span class="text-[7.5px] font-black uppercase tracking-wider text-violet-600">Quiz Guru</span>
                                <span class="text-[8px] text-slate-400">• ${tqEsc(item.className || item.classCode)}</span>
                            </div>
                            <h4 class="text-[10.5px] font-black text-slate-800 mt-1">${tqEsc(item.title || 'Quiz')}</h4>
                            <p class="text-[8.5px] text-slate-500 mt-1 line-clamp-2">${tqEsc(item.message || '')}</p>
                            <div class="flex flex-wrap gap-3 mt-2 text-[8px] font-bold text-slate-500">
                                <span><i class="fas fa-list-check text-violet-500 mr-1"></i>${Number(item.questionCount)||0} soal</span>
                                <span><i class="fas fa-star text-amber-500 mr-1"></i>${Number(item.xpReward)||0} XP</span>
                                <span><i class="fas fa-calendar text-rose-400 mr-1"></i>${tqEsc(typeof formatDistributionDeadline === 'function' ? formatDistributionDeadline(item.deadline || '') : (item.deadline || '-'))}</span>
                                ${item.fileName ? `<span><i class="fas fa-paperclip text-blue-500 mr-1"></i>${tqEsc(item.fileName)}</span>` : ''}
                            </div>
                        </div>
                    </div>
                    <button type="button" onclick="deleteTeacherQuizSeparate('${tqEsc(item.id)}')"
                            class="w-8 h-8 rounded-lg bg-rose-50 border border-rose-100 text-rose-600 flex items-center justify-center shrink-0"
                            title="Hapus quiz">
                        <i class="fas fa-trash text-[9px]"></i>
                    </button>
                </div>
            </article>
        `).join('');
    };

    window.sendTeacherQuizSeparate = async function() {
        const teacher = getCurrentAccount();
        if (!teacher || teacher.role !== 'guru') {
            return setTeacherQuizFeedback('Masuk sebagai guru untuk mengirim quiz.', true);
        }

        const classCode = String(document.getElementById('teacher-quiz-class-select')?.value || '').trim().toUpperCase();
        const targetClass = getTeacherManagedClasses(teacher)
            .find(c => String(c.classCode || '').trim().toUpperCase() === classCode);

        const title = String(document.getElementById('teacher-quiz-title')?.value || '').trim();
        const message = String(document.getElementById('teacher-quiz-message')?.value || '').trim();
        const questionCount = Math.max(0, Number(document.getElementById('teacher-quiz-question-count')?.value) || 0);
        const xpReward = Math.max(0, Number(document.getElementById('teacher-quiz-xp')?.value) || 0);
        const deadline = document.getElementById('teacher-quiz-deadline')?.value || '';
        const file = document.getElementById('teacher-quiz-file')?.files?.[0] || null;

        if (!targetClass) return setTeacherQuizFeedback('Pilih atau buat kelas terlebih dahulu.', true);
        if (!title) return setTeacherQuizFeedback('Judul quiz wajib diisi.', true);
        if (!message && !file) return setTeacherQuizFeedback('Tuliskan petunjuk quiz atau unggah lampiran.', true);

        const fileData = typeof fileToDataUrl === 'function' ? await fileToDataUrl(file) : null;
        const item = {
            id: `DIST-QUIZ-${Date.now()}`,
            teacherId: teacher.id,
            teacherName: teacher.name || 'Guru',
            classCode: targetClass.classCode,
            className: targetClass.className,
            type: 'kuis',
            title,
            message,
            questionCount,
            xpReward,
            deadline,
            fileName: file?.name || '',
            fileType: file?.type || '',
            fileSize: file?.size || 0,
            fileData,
            createdAt: new Date().toISOString()
        };

        const distributions = getTeacherDistributions();
        distributions.unshift(item);
        localStorage.setItem(TEACHER_DISTRIBUTIONS_STORAGE_KEY, JSON.stringify(distributions.slice(0,100)));

        const assignments = getTeacherAssignments();
        assignments.unshift({
            id: `TUGAS-QUIZ-${Date.now()}`,
            teacherId: teacher.id,
            classCode: targetClass.classCode,
            className: targetClass.className,
            title,
            teacher: teacher.name || 'Guru',
            subject: 'IPS',
            assignmentType: 'kuis',
            description: message || (file ? `Kuis terlampir: ${file.name}` : 'Quiz tambahan dari guru.'),
            instructions: message,
            questionCount,
            deadline: typeof formatDistributionDeadline === 'function' ? formatDistributionDeadline(deadline) : deadline,
            deadlineIso: deadline ? new Date(`${deadline}T23:59:00`).toISOString() : '',
            xpReward,
            maxScore: 100,
            requiresSubmission: true,
            allowLate: true,
            status: 'aktif',
            sourceDistributionId: item.id,
            attachmentName: item.fileName || '',
            attachmentType: item.fileType || '',
            attachmentSize: item.fileSize || 0,
            attachmentData: item.fileData || null,
            createdAt: new Date().toISOString(),
            updatedAt: new Date().toISOString()
        });
        localStorage.setItem(TEACHER_ASSIGNMENTS_STORAGE_KEY, JSON.stringify(assignments));

        document.getElementById('teacher-quiz-title').value = '';
        document.getElementById('teacher-quiz-message').value = '';
        document.getElementById('teacher-quiz-question-count').value = '10';
        document.getElementById('teacher-quiz-xp').value = '100';
        document.getElementById('teacher-quiz-deadline').value = '';
        const fileInput = document.getElementById('teacher-quiz-file');
        if (fileInput) fileInput.value = '';
        syncTeacherQuizFileLabel();

        setTeacherQuizFeedback(`Quiz berhasil dikirim ke ${targetClass.className} (${targetClass.classCode}).${file && !fileData ? ' File besar hanya dicatat namanya pada prototype.' : ''}`);
        renderTeacherQuizWorkspace(teacher);
        if (typeof renderTeacherHomeDashboard === 'function') renderTeacherHomeDashboard(teacher);
        if (typeof showToast === 'function') showToast(`Quiz dikirim ke ${targetClass.className}.`, 'bg-violet-600');
    };

    window.deleteTeacherQuizSeparate = function(id) {
        const teacher = getCurrentAccount();
        const quiz = getTeacherDistributions().find(x => x.id === id && x.type === 'kuis');
        if (!quiz || quiz.teacherId !== teacher?.id) return;
        if (!confirm(`Hapus quiz “${quiz.title}” dari riwayat dan daftar tugas siswa?`)) return;

        const distributions = getTeacherDistributions().filter(x => x.id !== id);
        localStorage.setItem(TEACHER_DISTRIBUTIONS_STORAGE_KEY, JSON.stringify(distributions));

        const assignments = getTeacherAssignments().filter(x => x.sourceDistributionId !== id);
        localStorage.setItem(TEACHER_ASSIGNMENTS_STORAGE_KEY, JSON.stringify(assignments));

        if (typeof getLmsSubmissions === 'function') {
            const removedTaskIds = getTeacherAssignments()
                .filter(x => x.sourceDistributionId === id)
                .map(x => String(x.id));
            const submissions = getLmsSubmissions().filter(s => !removedTaskIds.includes(String(s.assignmentId)));
            localStorage.setItem('klikNusantaraLmsSubmissionsV2', JSON.stringify(submissions));
        }

        renderTeacherQuizWorkspace(teacher);
        if (typeof showToast === 'function') showToast('Quiz berhasil dihapus.', 'bg-rose-600');
    };

    // Sinkronkan panel Quiz saat role/login berubah.
    if (typeof syncRoleSpecificWorkspace === 'function') {
        const oldSyncRoleSpecificWorkspace = syncRoleSpecificWorkspace;
        syncRoleSpecificWorkspace = function(account = getCurrentAccount()) {
            oldSyncRoleSpecificWorkspace(account);
            const isTeacher = account?.role === 'guru';
            document.getElementById('teacher-quiz-management-panel')?.classList.toggle('hidden', !isTeacher);
            if (isTeacher) renderTeacherQuizWorkspace(account);
        };
    }

    // Saat halaman pertama kali siap, tampilkan/hide panel sesuai akun aktif.
    document.addEventListener('DOMContentLoaded', () => {
        const account = typeof getCurrentAccount === 'function' ? getCurrentAccount() : null;
        document.getElementById('teacher-quiz-management-panel')?.classList.toggle('hidden', account?.role !== 'guru');
        if (account?.role === 'guru') renderTeacherQuizWorkspace(account);
    });
})();
</script>


<script>
(function(){
    let blindMapQuestions = [];
    let blindMapIndex = 0;
    let blindMapCorrect = 0;
    let blindMapXp = 0;
    let blindMapLocked = false;
    let blindMapRewardClaimed = false;

    function blindShuffle(arr) {
        const copy = [...arr];
        for (let i = copy.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [copy[i], copy[j]] = [copy[j], copy[i]];
        }
        return copy;
    }

    function blindEscape(value) {
        if (typeof escapeHtml === 'function') return escapeHtml(value ?? '');
        const d = document.createElement('div');
        d.textContent = String(value ?? '');
        return d.innerHTML;
    }

    function getBlindMapFeatures() {
        const data = window.indonesiaGeoJSONData;
        if (!data || !Array.isArray(data.features)) return [];

        return data.features
            .filter(f => f && f.geometry && f.properties && f.properties.name)
            .map(f => ({
                name: String(f.properties.name || '').trim(),
                geometry: f.geometry
            }))
            .filter(x => x.name && x.geometry);
    }

    function blindMapGeometryRings(geometry) {
        if (!geometry) return [];
        if (geometry.type === 'Polygon') {
            return geometry.coordinates?.[0] ? [geometry.coordinates[0]] : [];
        }
        if (geometry.type === 'MultiPolygon') {
            return (geometry.coordinates || [])
                .map(poly => poly?.[0])
                .filter(Boolean);
        }
        return [];
    }

    function makeBlindMapSvg(feature) {
        if (!feature?.geometry) {
            return `
                <div class="text-center text-slate-400">
                    <i class="fas fa-map text-6xl"></i>
                    <p class="text-[9px] font-bold mt-3">Siluet peta belum tersedia</p>
                </div>`;
        }

        const rings = blindMapGeometryRings(feature.geometry);
        if (!rings.length) return '<div class="text-slate-400"><i class="fas fa-map text-6xl"></i></div>';

        const points = rings.flat().filter(p => Array.isArray(p) && p.length >= 2);
        if (!points.length) return '<div class="text-slate-400"><i class="fas fa-map text-6xl"></i></div>';

        const xs = points.map(p => Number(p[0])).filter(Number.isFinite);
        const ys = points.map(p => Number(p[1])).filter(Number.isFinite);
        if (!xs.length || !ys.length) return '<div class="text-slate-400"><i class="fas fa-map text-6xl"></i></div>';

        const minX = Math.min(...xs), maxX = Math.max(...xs);
        const minY = Math.min(...ys), maxY = Math.max(...ys);
        const spanX = Math.max(maxX - minX, 0.0001);
        const spanY = Math.max(maxY - minY, 0.0001);

        const W = 520, H = 260, pad = 30;
        const scale = Math.min((W - pad * 2) / spanX, (H - pad * 2) / spanY);
        const drawW = spanX * scale;
        const drawH = spanY * scale;
        const ox = (W - drawW) / 2;
        const oy = (H - drawH) / 2;

        const paths = rings.map(ring => {
            const commands = ring
                .filter(p => Array.isArray(p) && p.length >= 2)
                .map((p, i) => {
                    const x = ox + (Number(p[0]) - minX) * scale;
                    const y = H - (oy + (Number(p[1]) - minY) * scale);
                    return `${i === 0 ? 'M' : 'L'} ${x.toFixed(2)} ${y.toFixed(2)}`;
                }).join(' ');
            return commands ? commands + ' Z' : '';
        }).filter(Boolean).join(' ');

        return `
            <svg viewBox="0 0 ${W} ${H}" class="blind-map-svg" role="img" aria-label="Siluet provinsi tanpa nama">
                <defs>
                    <linearGradient id="blindMapFill" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="#334155"/>
                        <stop offset="100%" stop-color="#0f766e"/>
                    </linearGradient>
                </defs>
                <path d="${paths}"
                      fill="url(#blindMapFill)"
                      stroke="#0f172a"
                      stroke-width="2.4"
                      stroke-linejoin="round"
                      vector-effect="non-scaling-stroke"/>
            </svg>`;
    }

    function buildBlindMapQuestions() {
        const features = getBlindMapFeatures();
        if (features.length < 4) return [];

        const selected = blindShuffle(features).slice(0, Math.min(6, features.length));
        const allNames = features.map(f => f.name);

        return selected.map(feature => {
            const distractors = blindShuffle(allNames.filter(n => n !== feature.name)).slice(0, 3);
            const options = blindShuffle([feature.name, ...distractors]);
            return {
                feature,
                answer: feature.name,
                options,
                correct: options.indexOf(feature.name)
            };
        });
    }

    function hideOtherQuizScreensForBlindMap() {
        [
            'quick-quiz-screen',
            'image-quiz-screen',
            'matching-quiz-screen',
            'time-challenge-screen',
            'teacher-assignments-section',
            'teacher-assignment-detail-screen',
            'teacher-lms-screen'
        ].forEach(id => document.getElementById(id)?.classList.add('hidden'));

        if (typeof stopTimeChallengeTimer === 'function') stopTimeChallengeTimer();
    }

    window.openBlindMapPanel = function() {
        const screen = document.getElementById('blind-map-screen');
        if (!screen) return;

        hideOtherQuizScreensForBlindMap();
        screen.classList.remove('hidden');
        renderBlindMapIntro();

        const scroller = screen.querySelector('.quiz-page-content');
        if (scroller) scroller.scrollTop = 0;
    };

    window.closeBlindMapPanel = function() {
        document.getElementById('blind-map-screen')?.classList.add('hidden');
    };

    function renderBlindMapIntro() {
        const stage = document.getElementById('blind-map-stage');
        if (!stage) return;

        const available = getBlindMapFeatures().length;

        stage.innerHTML = `
            <div class="text-center py-3 sm:py-5">
                <div class="w-20 h-20 rounded-[24px] bg-gradient-to-br from-teal-50 to-cyan-100 text-teal-600 flex items-center justify-center mx-auto shadow-inner border border-teal-100">
                    <i class="fas fa-map-location-dot text-3xl"></i>
                </div>
                <p class="text-[9px] uppercase tracking-[0.16em] font-extrabold text-teal-600 mt-4">Blind Map Challenge</p>
