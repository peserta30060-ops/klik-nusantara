        #search-results-panel.show {
            display: block;
            animation: searchPanelIn .20s ease-out;
        }

        @keyframes searchPanelIn {
            from { opacity: 0; transform: translateY(-6px) scale(.99); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

