        #regional-word-card {
            min-width: 0;
            background:
                radial-gradient(circle at 88% 18%, rgba(14,165,233,.12), transparent 24%),
                radial-gradient(circle at 10% 90%, rgba(99,102,241,.10), transparent 28%),
                linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        }

        .regional-word-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 16px;
            align-items: center;
        }

        .regional-word-main {
            position: relative;
            overflow: hidden;
            border-radius: 22px;
            padding: 18px;
            min-height: 158px;
            color: white;
            background: linear-gradient(145deg, #0f4b9b, #2563eb 58%, #4338ca);
            box-shadow: 0 14px 30px rgba(15,75,155,.16);
        }

        .regional-word-main::after {
            content: 'Aa';
            position: absolute;
            right: 18px;
            bottom: -12px;
            font-size: 82px;
            line-height: 1;
            font-weight: 900;
            color: rgba(255,255,255,.07);
            pointer-events: none;
        }

        .regional-word-word {
            font-size: 28px;
            line-height: 1.05;
            font-weight: 900;
            letter-spacing: -.03em;
            margin-top: 10px;
        }

        .regional-word-meaning {
            margin-top: 7px;
            font-size: 11px;
            line-height: 1.55;
            color: #dbeafe;
            max-width: 34rem;
        }

        .regional-word-example {
            border: 1px solid #dbeafe;
            background: rgba(239,246,255,.82);
            border-radius: 18px;
            padding: 15px 16px;
        }

        .regional-word-slide-content {
            transition: opacity .9s cubic-bezier(.22,.61,.36,1), transform .9s cubic-bezier(.22,.61,.36,1), filter .9s ease;
        }

        #regional-word-card.is-changing .regional-word-slide-content {
            opacity: 0;
            transform: translateX(-10px) translateY(2px) scale(.992);
            filter: blur(.7px);
        }

        #regional-word-card.is-entering .regional-word-slide-content {
            animation: regionalWordEnter 1s cubic-bezier(.16,1,.3,1) both;
        }

        @keyframes regionalWordEnter {
            from { opacity: 0; transform: translateX(12px) translateY(3px) scale(.992); filter: blur(.7px); }
            to { opacity: 1; transform: translateX(0) translateY(0) scale(1); filter: blur(0); }
        }

        .regional-word-auto-bar {
            height: 4px;
            border-radius: 999px;
            background: #dbeafe;
            overflow: hidden;
        }

        .regional-word-auto-progress {
            width: 0%;
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(90deg, #0ea5e9, #2563eb, #4f46e5);
        }

        .regional-word-auto-progress.playing {
            animation: regionalWordProgress 14s linear forwards;
        }

        @keyframes regionalWordProgress {
            from { width: 0%; }
            to { width: 100%; }
        }

        .regional-word-live-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 9px;
            border-radius: 999px;
            background: #eff6ff;
            border: 1px solid #dbeafe;
            color: #2563eb;
            font-size: 8px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .08em;
            white-space: nowrap;
        }

        .regional-word-live-dot {
            width: 7px;
            height: 7px;
            border-radius: 999px;
            background: #22c55e;
            box-shadow: 0 0 0 4px rgba(34,197,94,.12);
            animation: regionalWordPulse 1.7s ease-in-out infinite;
        }

        @keyframes regionalWordPulse {
            0%, 100% { transform: scale(.9); opacity: .75; }
            50% { transform: scale(1.12); opacity: 1; }
        }

        @media (min-width: 640px) {
            .regional-word-grid {
                grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
                gap: 18px;
            }
