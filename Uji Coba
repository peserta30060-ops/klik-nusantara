<script>
(function(){
    let wholeBlindQuestions = [];
    let wholeBlindIndex = 0;
    let wholeBlindCorrect = 0;
    let wholeBlindXp = 0;
    let wholeBlindLocked = false;
    let wholeBlindRewardClaimed = false;

    function wbEsc(value) {
        if (typeof escapeHtml === 'function') return escapeHtml(value ?? '');
        const d = document.createElement('div');
        d.textContent = String(value ?? '');
        return d.innerHTML;
    }

    function wbShuffle(arr) {
        const copy = [...arr];
        for (let i = copy.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [copy[i], copy[j]] = [copy[j], copy[i]];
        }
        return copy;
    }

    function getBlindWholeFeatures() {
        const data = window.indonesiaGeoJSONData;
        if (!data || !Array.isArray(data.features)) return [];
        return data.features
            .filter(f => f && f.geometry && f.properties && f.properties.name)
            .map(f => ({
                name: String(f.properties.name || '').trim(),
                geometry: f.geometry
            }))
            .filter(x => x.name && x.geometry);
    }

    function geometryRings(geometry) {
        if (!geometry) return [];
        if (geometry.type === 'Polygon') {
            return geometry.coordinates?.[0] ? [geometry.coordinates[0]] : [];
        }
        if (geometry.type === 'MultiPolygon') {
            return (geometry.coordinates || []).map(poly => poly?.[0]).filter(Boolean);
        }
        return [];
    }

    function flattenPoints(features) {
        const pts = [];
        features.forEach(feature => {
            geometryRings(feature.geometry).forEach(ring => {
                ring.forEach(p => {
                    if (Array.isArray(p) && p.length >= 2 && Number.isFinite(+p[0]) && Number.isFinite(+p[1])) {
                        pts.push([+p[0], +p[1]]);
                    }
                });
            });
        });
        return pts;
    }

    function wholeMapProjector(features, W=1000, H=460, pad=26) {
        const pts = flattenPoints(features);
        if (!pts.length) {
            return {
                project: ([x,y]) => [x,y],
                W, H
            };
        }
        const xs = pts.map(p => p[0]);
        const ys = pts.map(p => p[1]);
        const minX = Math.min(...xs), maxX = Math.max(...xs);
        const minY = Math.min(...ys), maxY = Math.max(...ys);
        const spanX = Math.max(maxX - minX, 0.0001);
        const spanY = Math.max(maxY - minY, 0.0001);

        // Sedikit perlebar untuk bentuk Indonesia yang sangat horizontal.
        const scale = Math.min((W - pad*2) / spanX, (H - pad*2) / spanY);
        const drawW = spanX * scale;
        const drawH = spanY * scale;
        const ox = (W - drawW) / 2;
        const oy = (H - drawH) / 2;

        return {
            W, H,
            project: ([lng, lat]) => {
                const x = ox + (lng - minX) * scale;
                const y = H - (oy + (lat - minY) * scale);
                return [x, y];
            }
        };
    }

    function makeWholeMapSvg(features, selectedName='', resultName='', wasCorrect=false) {
        const proj = wholeMapProjector(features);
        const paths = features.map(feature => {
            const rings = geometryRings(feature.geometry);
            const d = rings.map(ring => {
                return ring
                    .filter(p => Array.isArray(p) && p.length >= 2)
                    .map((p, i) => {
                        const [x,y] = proj.project([+p[0], +p[1]]);
                        return `${i===0 ? 'M' : 'L'} ${x.toFixed(2)} ${y.toFixed(2)}`;
                    }).join(' ') + ' Z';
            }).join(' ');

            let cls = 'blind-map-region';
            if (selectedName) {
                if (feature.name === selectedName) {
                    cls += wasCorrect ? ' is-correct' : ' is-wrong';
                } else if (feature.name === resultName) {
                    cls += ' is-correct';
                } else {
                    cls += ' is-dimmed';
                }
            }

            return `<path class="${cls}" data-name="${wbEsc(feature.name)}" d="${d}"></path>`;
        }).join('');

        return `
            <div class="blind-map-whole-wrap">
                <svg viewBox="0 0 ${proj.W} ${proj.H}" class="blind-map-whole-svg" role="img" aria-label="Peta Indonesia untuk kuis peta buta">
                    ${paths}
                </svg>
            </div>
        `;
    }

    function buildWholeBlindQuestions() {
        const features = getBlindWholeFeatures();
        if (features.length < 5) return [];
        const selected = wbShuffle(features).slice(0, Math.min(6, features.length));
        return selected.map(feature => ({
            targetName: feature.name
        }));
    }

    function hideOtherQuizScreensForWholeBlind() {
        [
            'quick-quiz-screen',
            'image-quiz-screen',
            'matching-quiz-screen',
            'time-challenge-screen',
            'teacher-assignments-section',
            'teacher-assignment-detail-screen',
            'teacher-lms-screen'
        ].forEach(id => document.getElementById(id)?.classList.add('hidden'));

        if (typeof stopTimeChallengeTimer === 'function') stopTimeChallengeTimer();
    }

    window.openBlindMapPanel = function() {
        const screen = document.getElementById('blind-map-screen');
        if (!screen) return;
        hideOtherQuizScreensForWholeBlind();
        screen.classList.remove('hidden');
        renderWholeBlindIntro();
        const scroller = screen.querySelector('.quiz-page-content');
        if (scroller) scroller.scrollTop = 0;
    };

    window.closeBlindMapPanel = function() {
        document.getElementById('blind-map-screen')?.classList.add('hidden');
    };

    function renderWholeBlindIntro() {
        const stage = document.getElementById('blind-map-stage');
        if (!stage) return;
        const available = getBlindWholeFeatures().length;

        stage.innerHTML = `
            <div class="text-center py-3 sm:py-5">
                <div class="w-20 h-20 rounded-[24px] bg-gradient-to-br from-teal-50 to-cyan-100 text-teal-600 flex items-center justify-center mx-auto shadow-inner border border-teal-100">
                    <i class="fas fa-map text-3xl"></i>
                </div>
                <p class="text-[9px] uppercase tracking-[0.16em] font-extrabold text-teal-600 mt-4">Blind Map · Peta Utuh</p>
                <h3 class="font-black text-xl text-gray-800 mt-1">Klik Provinsi pada Peta Indonesia</h3>
                <p class="text-xs text-gray-500 leading-relaxed max-w-lg mx-auto mt-2">
                    Nanti akan muncul nama provinsi, misalnya <b>Aceh</b>. Tugasmu adalah
                    <b>mengklik wilayah provinsi tersebut langsung pada peta Indonesia yang utuh</b>.
                </p>

                <div class="grid grid-cols-3 gap-2 max-w-md mx-auto mt-5">
                    <div class="blind-map-mini-stat">
                        <i class="fas fa-map-location-dot text-teal-600"></i>
                        <p class="font-black text-sm text-teal-900 mt-1">Utuh</p>
                        <p class="text-[8px] text-teal-700 font-bold">Peta RI</p>
                    </div>
                    <div class="blind-map-mini-stat">
                        <i class="fas fa-hand-pointer text-blue-600"></i>
                        <p class="font-black text-sm text-blue-900 mt-1">Klik</p>
                        <p class="text-[8px] text-blue-700 font-bold">Provinsi</p>
                    </div>
                    <div class="blind-map-mini-stat">
                        <i class="fas fa-star text-amber-500"></i>
                        <p class="font-black text-sm text-amber-900 mt-1">+15</p>
                        <p class="text-[8px] text-amber-700 font-bold">XP / Benar</p>
                    </div>
                </div>

                ${available >= 5 ? `
                <button type="button" onclick="startBlindMapQuiz()"
                        class="mt-6 inline-flex items-center justify-center bg-teal-600 hover:bg-teal-700 text-white font-extrabold text-xs px-7 py-3.5 rounded-xl shadow-md shadow-teal-100 active:scale-95 transition">
                    Mulai Blind Map <i class="fas fa-play ml-2"></i>
                </button>` : `
                <div class="mt-6 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-[10px] text-amber-700 max-w-md mx-auto">
                    <i class="fas fa-triangle-exclamation mr-1.5"></i>
                    Data peta provinsi belum siap. Buka halaman Peta terlebih dahulu lalu kembali ke Quiz.
                </div>`}
            </div>
        `;
    }

    window.startBlindMapQuiz = function() {
        wholeBlindQuestions = buildWholeBlindQuestions();
        if (wholeBlindQuestions.length < 5) {
            if (typeof showToast === 'function') showToast('Data peta provinsi belum siap.', 'bg-amber-600');
            renderWholeBlindIntro();
            return;
        }
        wholeBlindIndex = 0;
        wholeBlindCorrect = 0;
        wholeBlindXp = 0;
        wholeBlindLocked = false;
        wholeBlindRewardClaimed = false;
        renderWholeBlindQuestion();
    };

    function attachWholeBlindMapClicks(targetName) {
        const features = getBlindWholeFeatures();
        const svg = document.querySelector('#blind-map-stage .blind-map-whole-svg');
        if (!svg) return;

        svg.querySelectorAll('.blind-map-region').forEach(path => {
            path.addEventListener('click', () => {
                if (wholeBlindLocked) return;
                const clicked = path.getAttribute('data-name') || '';
                answerWholeBlindMap(clicked, targetName);
            });
        });
    }

    function renderWholeBlindQuestion(selectedName='', wasCorrect=False, feedbackHtml='') {
        const stage = document.getElementById('blind-map-stage');
        if (!stage || !wholeBlindQuestions.length) return;

        if (wholeBlindIndex >= wholeBlindQuestions.length) {
            finishWholeBlindQuiz();
            return;
        }

        const q = wholeBlindQuestions[wholeBlindIndex];
        const allFeatures = getBlindWholeFeatures();
        const number = wholeBlindIndex + 1;
        const total = wholeBlindQuestions.length;
        const progress = Math.round(((number - 1) / total) * 100);

        stage.innerHTML = `
            <div>
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                    <div>
                        <p class="text-[8px] uppercase tracking-[0.16em] font-black text-teal-600">Klik Wilayah yang Benar</p>
                        <h3 class="text-sm sm:text-base font-black text-slate-900 mt-1">Provinsi mana yang dimaksud?</h3>
                    </div>
                    <div class="rounded-xl bg-teal-50 border border-teal-100 px-3 py-2 text-center shrink-0">
                        <p class="text-[8px] text-teal-600 font-bold">Soal</p>
                        <p class="text-xs font-black text-teal-800">${number}/${total}</p>
                    </div>
                </div>

                <div class="blind-map-progress mt-3">
                    <div style="width:${progress}%"></div>
                </div>

                <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
                    <div class="blind-map-target-pill">
                        <i class="fas fa-location-crosshairs"></i>
                        Klik provinsi: <b>${wbEsc(q.targetName)}</b>
                    </div>
                    <p class="text-[8.5px] font-black text-amber-600">
                        <i class="fas fa-star mr-1"></i>${wholeBlindXp} XP
                    </p>
                </div>

                <div class="blind-map-canvas whole-map-mode mt-4">
                    ${makeWholeMapSvg(allFeatures, selectedName, q.targetName, wasCorrect)}
                </div>

                <div class="mt-3 blind-map-legend">
                    <span><i class="legend-normal"></i>Wilayah biasa</span>
                    <span><i class="legend-hover"></i>Arahkan / siap diklik</span>
                    <span><i class="legend-correct"></i>Jawaban benar</span>
                    <span><i class="legend-wrong"></i>Pilihan salah</span>
                </div>

                <div id="blind-map-feedback" class="mt-3">${feedbackHtml}</div>
            </div>
        `;

        if (!selectedName) {
            attachWholeBlindMapClicks(q.targetName);
        }
    }

    function answerWholeBlindMap(clickedName, targetName) {
        if (wholeBlindLocked) return;
        wholeBlindLocked = true;
        const isCorrect = String(clickedName).trim() === String(targetName).trim();
        if (isCorrect) {
            wholeBlindCorrect += 1;
            wholeBlindXp += 15;
        }

        const isLast = wholeBlindIndex === wholeBlindQuestions.length - 1;
        const feedbackHtml = `
