        function buildTeacherProvinceProgress(students = []) {
            if (!students.length) return [];
            const store = getQuizProgressStore();
            const provinceSet = new Set();
            students.forEach(student => Object.keys(store[student.id] || {}).forEach(name => provinceSet.add(name)));
            return Array.from(provinceSet).map(name => {
                let sum = 0;
                let participants = 0;
                students.forEach(student => {
                    const rec = store[student.id]?.[name];
                    if (rec) participants += 1;
                    sum += Math.max(0, Math.min(100, Number(rec?.pct) || 0));
                });
                return {
                    name,
                    avg: Math.round(sum / students.length),
                    participants,
                    total: students.length
                };
            }).sort((a, b) => b.avg - a.avg || b.participants - a.participants || a.name.localeCompare(b.name, 'id')).slice(0, 7);
        }

