        /* Kompas simpel tanpa frame / background */
        .klik-compass {
            width: 58px;
            height: 58px;
            position: relative;
            background: transparent !important;
            border: 0 !important;
            box-shadow: none !important;
            user-select: none;
            pointer-events: auto;
            filter: drop-shadow(0 2px 4px rgba(255,255,255,.95));
        }

        .klik-compass-mini {
            width: 50px;
            height: 50px;
        }

        .klik-compass .compass-label {
            position: absolute;
            z-index: 3;
            font-family: inherit;
            font-weight: 900;
            font-size: 9px;
            line-height: 1;
            color: #0f172a;
            text-shadow: 0 1px 2px rgba(255,255,255,.95), 0 0 5px rgba(255,255,255,.9);
        }

        .klik-compass-mini .compass-label {
            font-size: 8px;
        }

        .klik-compass .north {
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            color: #dc2626;
        }

        .klik-compass .south {
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
        }

        .klik-compass .east {
            right: 0;
            top: 50%;
            transform: translateY(-50%);
        }

        .klik-compass .west {
            left: 0;
            top: 50%;
            transform: translateY(-50%);
        }

        .klik-compass .compass-axis-v,
        .klik-compass .compass-axis-h {
            position: absolute;
            left: 50%;
            top: 50%;
            background: #0f172a;
            transform: translate(-50%, -50%);
            border-radius: 999px;
            opacity: .88;
        }

        .klik-compass .compass-axis-v {
            width: 1.5px;
            height: 34px;
        }

        .klik-compass .compass-axis-h {
            width: 34px;
            height: 1.5px;
        }

        .klik-compass-mini .compass-axis-v { height: 29px; }
        .klik-compass-mini .compass-axis-h { width: 29px; }

        .klik-compass .compass-arrow-n {
            position: absolute;
            left: 50%;
            top: 11px;
            transform: translateX(-50%);
            width: 0;
            height: 0;
            border-left: 4px solid transparent;
            border-right: 4px solid transparent;
            border-bottom: 10px solid #dc2626;
            z-index: 2;
        }

