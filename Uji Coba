        function makeClassToken(className = '') {
            const raw = String(className || '').toUpperCase();
            const match = raw.match(/(\d{1,2})\s*([A-Z])/);
            if (match) return `${match[1]}${match[2]}`;
            const digits = raw.match(/\d{1,2}/)?.[0] || 'X';
            const letters = raw.replace(/[^A-Z]/g, '').replace(/^KELAS/, '').slice(-1) || 'A';
            return `${digits}${letters}`.replace(/[^A-Z0-9]/g, '').slice(0, 4) || 'KLS';
        }

        function generateUniqueClassCode(className = '') {
            const token = makeClassToken(className);
            const alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
            const existing = new Set(getTeacherClasses().map(item => String(item.classCode || '').toUpperCase()));
            for (let attempt = 0; attempt < 200; attempt++) {
                let suffix = '';
                for (let i = 0; i < 3; i++) suffix += alphabet[Math.floor(Math.random() * alphabet.length)];
                const code = `KLS-${token}-${suffix}`;
                if (!existing.has(code)) return code;
            }
            return `KLS-${token}-${Date.now().toString(36).slice(-3).toUpperCase()}`;
        }

