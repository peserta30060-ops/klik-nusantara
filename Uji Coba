                        </button>
                    </div>
                </div>`;
        }
    };

    window.nextBlindMapQuestion = function() {
        blindMapIndex += 1;
        blindMapLocked = false;
        renderBlindMapQuestion();
    };

    function finishBlindMapQuiz() {
