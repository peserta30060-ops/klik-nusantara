    <script>
        let currentRole = 'siswa'; // Role default


        let currentXp = 1250;
        let previousTabBeforeProvince = 'beranda';
        let currentProvinceCategory = null;
        let provinceNavigationLevel = 'main'; // main | province | category | culture-detail
        let genericCategoryReturnTab = null; // contoh: 'materi' jika category-screen dibuka dari menu utama

        let internalNavigationLock = false;

        function getActiveMainTab() {
            const active = document.querySelector('.tab-content.active');
            if (!active || !active.id || !active.id.startsWith('tab-')) return 'beranda';
            return active.id.replace(/^tab-/, '');
        }

        function stopInternalNavigationEvent(event) {
            if (!event) return;
            if (typeof event.preventDefault === 'function') event.preventDefault();
            if (typeof event.stopPropagation === 'function') event.stopPropagation();
            if (typeof event.stopImmediatePropagation === 'function') event.stopImmediatePropagation();
        }

        function closeTransientOverlays() {
            const ids = [
                'regional-song-player',
                'challenge-exit-confirm'
            ];

            ids.forEach(id => {
                const el = document.getElementById(id);
                if (el) el.remove();
            });

            const notification = document.getElementById('notification-panel');
            if (notification) notification.classList.add('hidden');

            const chatModal = document.getElementById('chat-modal');
            if (chatModal && !chatModal.classList.contains('hidden')) {
                chatModal.classList.add('hidden');
                if (typeof isChatOpen !== 'undefined') isChatOpen = false;
            }
        }

        function hideCategoryScreen() {
            const screen = document.getElementById('category-screen');
            if (!screen) return;
            screen.classList.add('hidden');
            screen.classList.remove('flex');
        }

        function hideCultureContentDetail() {
            const screen = document.getElementById('culture-detail-screen');
            if (!screen) return;
            screen.classList.add('hidden');
            screen.classList.remove('flex');
        }

        function hideDetailScreen() {
            const screen = document.getElementById('detail-screen');
            if (!screen) return;
            screen.classList.add('hidden');
            screen.classList.remove('flex');
        }

        function safeBackToProvinceMenu(event = null) {
            stopInternalNavigationEvent(event);

            try {
                if (window.speechSynthesis) window.speechSynthesis.cancel();
                closeTransientOverlays();

                // Tutup halaman fitur/kategori yang sedang terbuka.
                hideCultureContentDetail();
                hideCategoryScreen();
                currentProvinceCategory = null;

                // Jika category-screen dibuka dari menu utama (misalnya Materi),
                // kembalikan pengguna ke tab asal, bukan ke menu provinsi.
                if (genericCategoryReturnTab) {
                    const targetTab = genericCategoryReturnTab;
                    genericCategoryReturnTab = null;
                    hideDetailScreen();
                    provinceNavigationLevel = 'main';
                    switchTab(targetTab, true);
                    return false;
                }

                provinceNavigationLevel = 'province';

                // Untuk kategori provinsi, tampilkan kembali daftar 8 fitur provinsi yang sama.
                const detail = document.getElementById('detail-screen');
                if (detail) {
                    detail.classList.remove('hidden');
                    detail.classList.add('flex');

                    const scroller = detail.querySelector('.overflow-y-auto');
                    if (scroller) scroller.scrollTop = 0;
                }
            } catch (e) {
                console.error('Navigasi kembali ke menu provinsi gagal:', e);
            }

            return false;
        }

        function safeBackToPreviousTab(event = null) {
            stopInternalNavigationEvent(event);

            try {
                if (window.speechSynthesis) window.speechSynthesis.cancel();
                closeTransientOverlays();

                hideCultureContentDetail();
                hideCategoryScreen();
                hideDetailScreen();

                currentProvinceCategory = null;
                provinceNavigationLevel = 'main';

                const target = document.getElementById('tab-' + previousTabBeforeProvince)
                    ? previousTabBeforeProvince
                    : 'beranda';

                switchTab(target, true);
            } catch (e) {
                console.error('Navigasi kembali ke halaman utama gagal:', e);
                switchTab('beranda', true);
            }

            return false;
        }

        function goToMainMenu(tabName = 'beranda', event = null) {
            stopInternalNavigationEvent(event);
            closeTransientOverlays();
            hideCultureContentDetail();
            hideCategoryScreen();
            hideDetailScreen();

            currentProvinceCategory = null;
            genericCategoryReturnTab = null;
            provinceNavigationLevel = 'main';

            const mini = document.getElementById('minigame-screen');
            if (mini) {
                mini.classList.add('hidden');
                mini.classList.remove('flex');
            }

            switchTab(tabName, true);
            return false;
        }



        function updateXP() {
            const xpCounter = document.getElementById('xp-counter');
            const profileXpCounter = document.getElementById('profile-xp-counter');

            if (xpCounter) xpCounter.textContent = `${currentXp} XP`;
            if (profileXpCounter) profileXpCounter.textContent = currentXp;

            try {
                const session = getCurrentSession();
                if (session?.accountId) {
                    const accounts = getLocalAccounts();
                    const index = accounts.findIndex(account => account.id === session.accountId && account.role === 'siswa');
                    if (index >= 0) {
                        accounts[index].xp = currentXp;
                        accounts[index].updatedAt = new Date().toISOString();
                        saveLocalAccounts(accounts);
                        renderClassLeaderboard(accounts[index]);
                    }
                }
                // Legacy key dipertahankan sebagai cadangan migrasi prototype lama.
                localStorage.setItem('klikNusantaraXP', String(currentXp));
            } catch (e) {
                // Tetap berjalan jika penyimpanan browser diblokir.
            }
        }

        function loadSavedXP(accountId = null) {
            try {
                const targetId = accountId || getCurrentSession()?.accountId;
                const account = targetId ? getLocalAccounts().find(item => item.id === targetId && item.role === 'siswa') : null;
                if (account && Number.isFinite(Number(account.xp))) {
                    currentXp = Math.max(0, Number(account.xp));
                } else {
                    const saved = parseInt(localStorage.getItem('klikNusantaraXP'), 10);
                    if (Number.isFinite(saved) && saved >= 0) currentXp = saved;
                }
            } catch (e) {}
            updateXP();
        }

        function renderClassLeaderboard(account = getCurrentAccount()) {
            const list = document.getElementById('class-leaderboard-list');
            if (!list || !account || account.role !== 'siswa') return;

            const classCode = String(account.classCode || '').trim().toUpperCase();
            const className = account.className || deriveClassName(classCode);
            const title = document.getElementById('class-leaderboard-title');
            const rankEl = document.getElementById('profile-class-rank');
            if (title) title.innerHTML = `<i class="fas fa-crown text-yellow-500 mr-1"></i> Leaderboard ${escapeHtml(className)}`;

            if (!classCode) {
                list.innerHTML = `<div class="rounded-xl bg-amber-50 border border-amber-100 p-3 text-[10px] text-amber-700">Akun belum terhubung ke kode kelas. Hubungi guru untuk mendapatkan kode kelas.</div>`;
                if (rankEl) rankEl.textContent = '-';
                return;
            }

            const accountStudents = getLocalAccounts()
                .filter(item => item.role === 'siswa' && String(item.classCode || '').trim().toUpperCase() === classCode)
                .map(item => ({ id: item.id, name: item.name, classCode, className: item.className || className, xp: Number(item.xp) || 0, isCurrent: item.id === account.id }));

            const rosterStudents = getClassRoster()
                .filter(item => String(item.classCode || '').trim().toUpperCase() === classCode)
                .map(item => ({ ...item, xp: Number(item.xp) || 0, isCurrent: false }));

            const merged = [...rosterStudents, ...accountStudents];
            const unique = [];
            const seen = new Set();
            for (const item of merged) {
                const key = item.id || `${String(item.name).toLowerCase()}|${classCode}`;
                if (seen.has(key)) continue;
                seen.add(key);
                unique.push(item);
            }

            if (!unique.some(item => item.isCurrent)) {
                unique.push({ id: account.id, name: account.name || 'Kamu', classCode, className, xp: currentXp, isCurrent: true });
            }

            unique.sort((a, b) => b.xp - a.xp || String(a.name).localeCompare(String(b.name), 'id'));
            const currentIndex = unique.findIndex(item => item.isCurrent);
            if (rankEl) rankEl.textContent = currentIndex >= 0 ? `#${currentIndex + 1}` : '-';

            list.innerHTML = unique.slice(0, 10).map((item, index) => {
                const current = item.isCurrent;
                const rowClass = current
                    ? 'bg-blue-50 border-blue-200 shadow-sm relative'
                    : index === 0 ? 'bg-yellow-50 border-yellow-100' : 'bg-slate-50 border-slate-100';
                const rankClass = current ? 'text-blue-700' : index === 0 ? 'text-yellow-600' : 'text-slate-500';
                const nameClass = current ? 'text-blue-900' : 'text-slate-800';
                const xpClass = current ? 'text-blue-700' : index === 0 ? 'text-yellow-600' : 'text-slate-600';
                return `
                    <div class="flex items-center justify-between p-2.5 rounded-xl border ${rowClass}">
                        ${current ? '<div class="absolute -left-1 top-1/2 -translate-y-1/2 w-1.5 h-6 bg-blue-600 rounded-r-full"></div>' : ''}
                        <div class="flex items-center gap-3 ${current ? 'ml-2' : ''}">
                            <span class="font-black ${rankClass} w-5 text-center text-xs">${index + 1}</span>
                            <div>
                                <p class="text-xs font-bold ${nameClass}">${escapeHtml(item.name || 'Siswa')}${current ? ' <span class="text-[9px] font-black text-blue-600">(Kamu)</span>' : ''}</p>
                                <p class="text-[8px] text-slate-400">${escapeHtml(classCode)}</p>
                            </div>
                        </div>
                        <span class="text-[10px] font-black ${xpClass}">${item.xp} XP</span>
                    </div>`;
            }).join('');
        }

        function renderTeacherAssignments(account = getCurrentAccount()) {
            const list = document.getElementById('teacher-assignment-list');
            if (!list || !account || account.role !== 'siswa') return;

            const classCode = String(account.classCode || '').trim().toUpperCase();
            const className = account.className || deriveClassName(classCode);
            const assignments = getTeacherAssignments().filter(item => String(item.classCode || '').trim().toUpperCase() === classCode);
            const activeAssignments = assignments.filter(item => item.status !== 'selesai');

            const badge = document.getElementById('teacher-assignment-badge');
            const classShort = document.getElementById('teacher-assignment-class-short');
            const classLabel = document.getElementById('teacher-assignment-class-label');
            if (badge) badge.innerHTML = `<i class="fas fa-paper-plane mr-1.5"></i>${activeAssignments.length} Tugas`;
            if (classShort) classShort.textContent = className;
            if (classLabel) classLabel.textContent = `${className} (${classCode || 'tanpa kode'})`;

            if (!classCode) {
                list.innerHTML = `<div class="rounded-2xl border border-amber-100 bg-amber-50 p-4"><p class="text-xs font-black text-amber-800">Belum terhubung ke kelas</p><p class="text-[10px] text-amber-700 mt-1">Masukkan nama dan kode kelas pada akun siswa agar tugas dari guru dapat ditampilkan.</p></div>`;
                return;
            }

            if (!assignments.length) {
                list.innerHTML = `<div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 text-center"><div class="w-12 h-12 mx-auto rounded-2xl bg-white border border-slate-200 flex items-center justify-center text-slate-400"><i class="fas fa-inbox"></i></div><p class="text-xs font-black text-slate-700 mt-3">Belum ada tugas baru</p><p class="text-[10px] text-slate-500 mt-1">Kuis yang dikirim guru ke ${escapeHtml(className)} akan muncul di sini.</p></div>`;
                return;
            }

            list.innerHTML = assignments.map((task, index) => `
                <article class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                    <div class="flex items-start justify-between gap-3">
                        <div class="flex items-start gap-3 min-w-0">
                            <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0"><i class="fas fa-file-circle-question"></i></div>
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="text-[8px] font-black uppercase tracking-wider rounded-full bg-emerald-50 text-emerald-700 px-2 py-1">${escapeHtml(task.subject || 'IPS')}</span>
                                    <span class="text-[8px] font-bold text-slate-400">${escapeHtml(task.teacher || 'Guru')}</span>
                                </div>
                                <h4 class="text-sm font-black text-slate-900 mt-2">${escapeHtml(task.title)}</h4>
                                <p class="text-[10px] leading-relaxed text-slate-500 mt-1">${escapeHtml(task.description || '')}</p>
                            </div>
                        </div>
                        <span class="shrink-0 inline-flex rounded-full bg-blue-50 border border-blue-100 px-2 py-1 text-[8px] font-black text-blue-700">Baru</span>
                    </div>
                    <div class="grid grid-cols-3 gap-2 mt-4">
                        <div class="rounded-xl bg-slate-50 p-2.5 text-center"><p class="text-[8px] text-slate-400 font-bold">Soal</p><p class="text-xs font-black text-slate-800 mt-0.5">${Number(task.questionCount) || 0}</p></div>
                        <div class="rounded-xl bg-amber-50 p-2.5 text-center"><p class="text-[8px] text-amber-600 font-bold">Bonus</p><p class="text-xs font-black text-amber-700 mt-0.5">+${Number(task.xpReward) || 0} XP</p></div>
                        <div class="rounded-xl bg-rose-50 p-2.5 text-center"><p class="text-[8px] text-rose-500 font-bold">Tenggat</p><p class="text-[9px] font-black text-rose-700 mt-0.5 leading-tight">${escapeHtml(task.deadline || '-')}</p></div>
                    </div>
                    <div class="mt-3 pt-3 border-t border-slate-100 flex items-center justify-between gap-3">
                        <p class="text-[8.5px] text-slate-400"><i class="fas fa-lock mr-1"></i>Khusus ${escapeHtml(className)}</p>
                        <button type="button" onclick="openTeacherAssignment('${escapeHtml(task.id)}')" class="rounded-xl bg-emerald-600 text-white px-3 py-2 text-[9px] font-black hover:bg-emerald-700 active:scale-95">Buka Tugas <i class="fas fa-arrow-right ml-1"></i></button>
                    </div>
                </article>`).join('');
        }

        function openTeacherAssignmentsPanel() {
            const account = getCurrentAccount();
            renderTeacherAssignments(account);
            const panel = document.getElementById('teacher-assignments-section');
            if (!panel) return;
            panel.classList.remove('hidden');
            setTimeout(() => panel.scrollIntoView({ behavior: 'smooth', block: 'start' }), 40);
        }

        function closeTeacherAssignmentsPanel() {
            const panel = document.getElementById('teacher-assignments-section');
            if (panel) panel.classList.add('hidden');
        }

        let isChatOpen = false;
        let quizAnswered = false;
        let mapsInitialized = false;
        let berandaMap, fullMap;
        let currentProvince = 'Jawa Barat';

        const dataProvinsi = {
            "Jambi": {
                "completedFeatures": [
                                "identitas",
                                "geografi",
                                "masyarakat",
                                "budaya",
                                "potensi",
                                "wisata",
                                "lagu",
                                "quiz"
                ],
                "ringkas": "Jambi adalah provinsi di bagian tengah Pulau Sumatra yang membentang dari pegunungan Bukit Barisan dan dataran tinggi Kerinci di barat hingga dataran rendah, lahan basah, sungai, dan pesisir timur di Tanjung Jabung. Sungai Batanghari menjadi poros sejarah, permukiman, perdagangan, dan kebudayaan. Provinsi ini menyimpan jejak penting peradaban Melayu melalui Kawasan Cagar Budaya Nasional Muaro Jambi, sejarah Kesultanan Jambi, Keris Siginjai, serta tradisi lisan dan adat Melayu. Di bagian barat, Kerinci dan Sungai Penuh memiliki bahasa, aksara, tradisi, dan lanskap pegunungan yang khas. Gunung Kerinci, Danau Gunung Tujuh, Danau Kerinci, Kebun Teh Kayu Aro, Taman Nasional Kerinci Seblat, Merangin Jambi UNESCO Global Geopark, hutan dataran rendah, perkebunan, pertambangan, dan wilayah pesisir memperlihatkan hubungan yang kuat antara alam, masyarakat, budaya, dan ekonomi Jambi.",
                "identitas": {
                                "namaResmi": "Provinsi Jambi",
                                "singkatan": "Jambi",
                                "ibukota": "Jambi",
                                "julukan": "Bumi Sepucuk Jambi Sembilan Lurah",
                                "pulau": "Sumatra",
                                "zonaWaktu": "Waktu Indonesia Barat (WIB / UTC+7)",
                                "koordinat": "0°45′–2°45′ LS dan 101°10′–104°55′ BT",
                                "luasDaratan": "Sekitar 50.160,05 km² daratan. Profil Pemerintah Provinsi Jambi mencatat luas keseluruhan sekitar 53.435,72 km² jika wilayah perairan turut dihitung.",
                                "penduduk": "Sekitar 3,8 juta jiwa pada pertengahan dekade 2020-an. Persebarannya tidak merata; Kota Jambi menjadi pusat penduduk perkotaan, sedangkan wilayah lain berkembang mengikuti koridor Batanghari, perkebunan, pegunungan Kerinci, dan kawasan pesisir timur.",
                                "hariJadi": "6 Januari 1957",
                                "dasarPembentukan": "Perjuangan pembentukan provinsi mencapai puncak melalui keputusan BKRD 6 Januari 1957. Dasar hukum nasionalnya diperkuat melalui UU Darurat Nomor 19 Tahun 1957 dan UU Nomor 61 Tahun 1958. Dasar hukum Provinsi Jambi kemudian disempurnakan melalui UU Nomor 18 Tahun 2022, yang menegaskan cakupan 9 kabupaten dan 2 kota dengan ibu kota di Kota Jambi.",
                                "administrasiRingkas": "Provinsi Jambi terdiri atas 11 kabupaten/kota, yaitu 9 kabupaten dan 2 kota. Ibu kota provinsi berada di Kota Jambi. Bentang administrasinya membentang dari kawasan pegunungan Kerinci di barat hingga dataran rendah dan pesisir Tanjung Jabung di timur.",
