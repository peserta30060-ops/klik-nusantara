        function answerImageQuiz(selectedIndex) {
            if (imageQuizLocked) return;
            const q = imageQuizQuestions[imageQuizIndex];
            if (!q) return;

            imageQuizLocked = true;
            const selectedCorrect = selectedIndex === q.correct;
            const buttons = Array.from(document.querySelectorAll('#image-quiz-options .image-quiz-option'));

            buttons.forEach((btn, idx) => {
