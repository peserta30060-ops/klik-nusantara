        function buildTimeChallengeQuestion() {
            if (!timeChallengeQueue.length) {
                timeChallengeQueue = shuffleQuickQuiz(quickQuizBank);
            }

            const base = timeChallengeQueue.shift();
            const indexed = base.options.map((text, idx) => ({
                text,
                isCorrect: idx === base.correct
            }));
            const mixed = shuffleQuickQuiz(indexed);

            return {
                ...base,
                options: mixed.map(item => item.text),
                correct: mixed.findIndex(item => item.isCorrect)
            };
        }

        function startTimeChallenge() {
            stopTimeChallengeTimer();
            const stage = document.getElementById('time-challenge-stage');
            if (stage) delete stage.dataset.finished;

            timeChallengeQueue = shuffleQuickQuiz(quickQuizBank);
            timeChallengeQuestion = null;
            timeChallengeRemaining = TIME_CHALLENGE_SECONDS;
            timeChallengeAnswered = 0;
            timeChallengeCorrect = 0;
            timeChallengeScore = 0;
            timeChallengeXp = 0;
            timeChallengeStreak = 0;
            timeChallengeBestStreak = 0;
            timeChallengeLocked = false;
            timeChallengeRunning = true;
            timeChallengeRewardClaimed = false;
            timeChallengeEndAt = Date.now() + (TIME_CHALLENGE_SECONDS * 1000);

            renderNextTimeChallengeQuestion();
            updateTimeChallengeClock();

            timeChallengeTimerId = setInterval(() => {
                if (!timeChallengeRunning) return;
                updateTimeChallengeClock();
            }, 200);
        }

        function updateTimeChallengeClock() {
            if (!timeChallengeRunning) return;

            const msLeft = Math.max(0, timeChallengeEndAt - Date.now());
            timeChallengeRemaining = Math.ceil(msLeft / 1000);
            const pct = Math.max(0, Math.min(100, (msLeft / (TIME_CHALLENGE_SECONDS * 1000)) * 100));

            const value = document.getElementById('time-challenge-seconds');
            const bar = document.getElementById('time-challenge-progress');
            if (value) value.textContent = String(timeChallengeRemaining);
            if (bar) bar.style.width = `${pct}%`;

            if (msLeft <= 0) {
                finishTimeChallenge();
            }
        }

        function renderNextTimeChallengeQuestion() {
            if (!timeChallengeRunning) return;

            const stage = document.getElementById('time-challenge-stage');
            if (!stage) return;

            timeChallengeLocked = false;
            timeChallengeQuestion = buildTimeChallengeQuestion();
            const q = timeChallengeQuestion;
            const letters = ['A', 'B', 'C', 'D'];

            stage.innerHTML = `
