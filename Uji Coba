                        <p class="font-black text-sm text-emerald-900 mt-1">${blindMapCorrect}/${total}</p>
                        <p class="text-[8px] text-emerald-700 font-bold">Benar</p>
                    </div>
                    <div class="rounded-2xl bg-blue-50 border border-blue-100 p-3">
                        <i class="fas fa-chart-simple text-blue-600"></i>
                        <p class="font-black text-sm text-blue-900 mt-1">${pct}</p>
                        <p class="text-[8px] text-blue-700 font-bold">Skor / 100</p>
                    </div>
                    <div class="rounded-2xl bg-amber-50 border border-amber-100 p-3">
