<script>
(function(){
    const LMS_SUBMISSIONS_KEY = 'klikNusantaraLmsSubmissionsV2';
    window.__knLmsReviewTaskId = null;

    function lmsEsc(value) {
        if (typeof escapeHtml === 'function') return escapeHtml(value ?? '');
        const d = document.createElement('div');
        d.textContent = String(value ?? '');
        return d.innerHTML;
    }

    function getLmsSubmissions() {
        try {
            const parsed = JSON.parse(localStorage.getItem(LMS_SUBMISSIONS_KEY) || '[]');
            return Array.isArray(parsed) ? parsed : [];
        } catch(e) { return []; }
    }
    function saveLmsSubmissions(items) {
        localStorage.setItem(LMS_SUBMISSIONS_KEY, JSON.stringify(Array.isArray(items) ? items : []));
    }
    window.getLmsSubmissions = getLmsSubmissions;

    function getLmsSubmission(taskId, studentId) {
        return getLmsSubmissions().find(s => String(s.assignmentId) === String(taskId) && String(s.studentId) === String(studentId)) || null;
    }

    function getTaskDeadlineDate(task) {
        if (!task?.deadlineIso) return null;
        const d = new Date(task.deadlineIso);
        return Number.isNaN(d.getTime()) ? null : d;
    }

    function lmsDeadlineLabel(task) {
        const d = getTaskDeadlineDate(task);
        if (d) {
            try {
                return new Intl.DateTimeFormat('id-ID', {day:'numeric', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit'}).format(d);
            } catch(e) {}
        }
        return task?.deadline || 'Tanpa tenggat';
    }

    function isTaskOverdue(task) {
        const d = getTaskDeadlineDate(task);
        return !!(d && Date.now() > d.getTime());
    }

    function taskTypeLabel(type) {
        return ({tugas:'Tugas / Proyek', materi_tugas:'Materi + Tugas', kuis:'Kuis / Latihan'})[type] || 'Tugas';
    }

    async function lmsFileToDataUrl(file, maxBytes = 900 * 1024) {
        if (!file) return { data:null, oversized:false };
        if (file.size > maxBytes) return { data:null, oversized:true };
        return await new Promise(resolve => {
            const reader = new FileReader();
            reader.onload = () => resolve({ data: typeof reader.result === 'string' ? reader.result : null, oversized:false });
            reader.onerror = () => resolve({ data:null, oversized:false });
            reader.readAsDataURL(file);
        });
    }

    function lmsTeacherOwnsTask(task, teacher) {
        if (!task || !teacher) return false;
        if (task.teacherId) return String(task.teacherId) === String(teacher.id);
        if (task.sourceDistributionId && typeof getTeacherDistributions === 'function') {
            const src = getTeacherDistributions().find(x => x.id === task.sourceDistributionId);
            if (src?.teacherId) return String(src.teacherId) === String(teacher.id);
        }
        return String(task.teacher || '').trim().toLowerCase() === String(teacher.name || '').trim().toLowerCase();
    }

    function teacherTasks(teacher = getCurrentAccount()) {
        if (!teacher || teacher.role !== 'guru') return [];
        return getTeacherAssignments().filter(t => lmsTeacherOwnsTask(t, teacher));
    }

    function setLmsFeedback(message, error = false) {
        const el = document.getElementById('teacher-lms-form-feedback');
        if (!el) return;
        if (!message) { el.classList.add('hidden'); el.innerHTML=''; return; }
        el.className = `mt-3 rounded-xl px-3 py-2 text-[9.5px] ${error ? 'bg-red-50 border border-red-100 text-red-700' : 'bg-emerald-50 border border-emerald-100 text-emerald-700'}`;
        el.textContent = message;
    }

    function populateLmsClassOptions() {
        const teacher = getCurrentAccount();
        const classes = typeof getTeacherManagedClasses === 'function' ? getTeacherManagedClasses(teacher) : [];
        const formSel = document.getElementById('lms-task-class');
        const filterSel = document.getElementById('teacher-lms-filter-class');
        const active = typeof getActiveTeacherClass === 'function' ? getActiveTeacherClass(teacher) : null;
        const opts = classes.map(c => `<option value="${lmsEsc(c.classCode)}">${lmsEsc(c.className)} (${lmsEsc(c.classCode)})</option>`).join('');
        if (formSel) {
            formSel.innerHTML = opts || '<option value="">Belum ada kelas</option>';
            if (active?.classCode) formSel.value = active.classCode;
        }
        if (filterSel) {
            const previous = filterSel.value;
            filterSel.innerHTML = '<option value="">Semua Kelas</option>' + opts;
            if (previous && classes.some(c => c.classCode === previous)) filterSel.value = previous;
            else if (active?.classCode) filterSel.value = active.classCode;
        }
    }

    window.openTeacherLms = function() {
        const teacher = getCurrentAccount();
        if (!teacher || teacher.role !== 'guru') {
            if (typeof showToast === 'function') showToast('Masuk sebagai guru untuk membuka LMS.', 'bg-amber-600');
            return;
        }
        ['quick-quiz-screen','image-quiz-screen','matching-quiz-screen','time-challenge-screen','teacher-assignments-section','teacher-assignment-detail-screen']
            .forEach(id => document.getElementById(id)?.classList.add('hidden'));
        document.getElementById('teacher-lms-screen')?.classList.remove('hidden');
        populateLmsClassOptions();
        renderTeacherLms();
        const scroller = document.querySelector('#teacher-lms-screen .quiz-page-content');
        if (scroller) scroller.scrollTop = 0;
    };

    window.closeTeacherLms = function() {
        document.getElementById('teacher-lms-screen')?.classList.add('hidden');
        cancelTeacherLmsForm();
        closeTeacherLmsReview();
    };

    window.renderTeacherLms = function() {
        const teacher = getCurrentAccount();
        if (!teacher || teacher.role !== 'guru') return;
        populateLmsClassOptions();
        const tasks = teacherTasks(teacher);
        const taskIds = new Set(tasks.map(t => String(t.id)));
        const subs = getLmsSubmissions().filter(s => taskIds.has(String(s.assignmentId)) && ['submitted','graded'].includes(s.status));
        const ungraded = subs.filter(s => s.status === 'submitted').length;
        const graded = subs.filter(s => s.status === 'graded').length;
        document.getElementById('lms-stat-tasks') && (document.getElementById('lms-stat-tasks').textContent = tasks.length);
        document.getElementById('lms-stat-submissions') && (document.getElementById('lms-stat-submissions').textContent = subs.length);
        document.getElementById('lms-stat-ungraded') && (document.getElementById('lms-stat-ungraded').textContent = ungraded);
        document.getElementById('lms-stat-graded') && (document.getElementById('lms-stat-graded').textContent = graded);
        renderTeacherLmsTaskList();
        if (window.__knLmsReviewTaskId) {
            const stillExists = tasks.some(t => String(t.id) === String(window.__knLmsReviewTaskId));
            if (stillExists) openTeacherLmsReview(window.__knLmsReviewTaskId, false);
            else closeTeacherLmsReview();
        }
    };

    window.startCreateTeacherLmsTask = function() {
        const teacher = getCurrentAccount();
        if (!teacher || teacher.role !== 'guru') return;
        populateLmsClassOptions();
        document.getElementById('lms-edit-assignment-id').value = '';
        document.getElementById('teacher-lms-form-title').textContent = 'Buat Tugas Baru';
        document.getElementById('lms-task-type').value = 'tugas';
        document.getElementById('lms-task-subject').value = 'IPS';
        document.getElementById('lms-task-title').value = '';
        document.getElementById('lms-task-instructions').value = '';
        document.getElementById('lms-task-deadline').value = '';
        document.getElementById('lms-task-max-score').value = '100';
        document.getElementById('lms-task-xp').value = '100';
        document.getElementById('lms-task-question-count').value = '1';
        document.getElementById('lms-task-requires-submission').checked = true;
        document.getElementById('lms-task-allow-late').checked = true;
        const f = document.getElementById('lms-task-file'); if (f) f.value = '';
        syncLmsTaskFileLabel();
        setLmsFeedback('');
        const card = document.getElementById('teacher-lms-form-card');
        card?.classList.remove('hidden');
        card?.scrollIntoView({behavior:'smooth', block:'start'});
    };

    window.cancelTeacherLmsForm = function() {
        document.getElementById('teacher-lms-form-card')?.classList.add('hidden');
        setLmsFeedback('');
    };

    window.syncLmsTaskFileLabel = function() {
        const input = document.getElementById('lms-task-file');
        const label = document.getElementById('lms-task-file-label');
        if (!label) return;
        const file = input?.files?.[0];
        if (file) label.textContent = `${file.name} • ${Math.max(1, Math.round(file.size/1024))} KB`;
        else {
            const editId = document.getElementById('lms-edit-assignment-id')?.value;
            const old = editId ? getTeacherAssignments().find(t => String(t.id) === String(editId)) : null;
            label.textContent = old?.attachmentName ? `Lampiran saat ini: ${old.attachmentName}` : 'PDF, DOCX, PPTX, gambar, atau file lain (file kecil disimpan di prototype)';
        }
    };

    window.editTeacherLmsTask = function(id) {
        const teacher = getCurrentAccount();
        const task = getTeacherAssignments().find(t => String(t.id) === String(id));
        if (!task || !lmsTeacherOwnsTask(task, teacher)) return;
        populateLmsClassOptions();
        document.getElementById('teacher-lms-form-card')?.classList.remove('hidden');
        document.getElementById('teacher-lms-form-title').textContent = 'Edit Tugas';
        document.getElementById('lms-edit-assignment-id').value = task.id;
        document.getElementById('lms-task-class').value = task.classCode || '';
        document.getElementById('lms-task-type').value = task.assignmentType || 'tugas';
        document.getElementById('lms-task-subject').value = task.subject || 'IPS';
        document.getElementById('lms-task-title').value = task.title || '';
        document.getElementById('lms-task-instructions').value = task.instructions || task.description || '';
        document.getElementById('lms-task-deadline').value = task.deadlineIso ? String(task.deadlineIso).slice(0,16) : '';
        document.getElementById('lms-task-max-score').value = Number(task.maxScore) || 100;
        document.getElementById('lms-task-xp').value = Number(task.xpReward) || 0;
        document.getElementById('lms-task-question-count').value = Number(task.questionCount) || 1;
        document.getElementById('lms-task-requires-submission').checked = task.requiresSubmission !== false;
        document.getElementById('lms-task-allow-late').checked = task.allowLate !== false;
        const f = document.getElementById('lms-task-file'); if (f) f.value = '';
        syncLmsTaskFileLabel();
        setLmsFeedback('');
        document.getElementById('teacher-lms-form-card')?.scrollIntoView({behavior:'smooth', block:'start'});
    };

    window.saveTeacherLmsTask = async function() {
        const teacher = getCurrentAccount();
        if (!teacher || teacher.role !== 'guru') return;
        const id = document.getElementById('lms-edit-assignment-id')?.value || '';
        const classCode = String(document.getElementById('lms-task-class')?.value || '').trim().toUpperCase();
        const classes = getTeacherManagedClasses(teacher);
        const cls = classes.find(c => String(c.classCode).toUpperCase() === classCode);
        const title = String(document.getElementById('lms-task-title')?.value || '').trim();
        const instructions = String(document.getElementById('lms-task-instructions')?.value || '').trim();
        if (!cls) return setLmsFeedback('Pilih atau buat kelas terlebih dahulu.', true);
        if (!title) return setLmsFeedback('Judul tugas wajib diisi.', true);
        if (!instructions) return setLmsFeedback('Materi / instruksi tugas wajib diisi.', true);

        const file = document.getElementById('lms-task-file')?.files?.[0] || null;
        const fileResult = await lmsFileToDataUrl(file);
        let tasks = getTeacherAssignments();
        const old = id ? tasks.find(t => String(t.id) === String(id)) : null;
        if (id && (!old || !lmsTeacherOwnsTask(old, teacher))) return setLmsFeedback('Tugas tidak ditemukan atau bukan milik akun guru ini.', true);

        const deadlineValue = document.getElementById('lms-task-deadline')?.value || '';
        const deadlineIso = deadlineValue ? new Date(deadlineValue).toISOString() : '';
        const task = {
            ...(old || {}),
            id: old?.id || `LMS-TUGAS-${Date.now()}`,
            teacherId: teacher.id,
            teacher: teacher.name || 'Guru',
            classCode: cls.classCode,
            className: cls.className,
            assignmentType: document.getElementById('lms-task-type')?.value || 'tugas',
            subject: String(document.getElementById('lms-task-subject')?.value || 'IPS').trim() || 'IPS',
            title,
            description: instructions.length > 180 ? instructions.slice(0,177) + '...' : instructions,
            instructions,
            questionCount: Math.max(0, Number(document.getElementById('lms-task-question-count')?.value) || 0),
            xpReward: Math.max(0, Number(document.getElementById('lms-task-xp')?.value) || 0),
            maxScore: Math.max(1, Number(document.getElementById('lms-task-max-score')?.value) || 100),
            deadlineIso,
            deadline: deadlineValue ? lmsDeadlineLabel({deadlineIso}) : 'Tanpa tenggat',
            requiresSubmission: !!document.getElementById('lms-task-requires-submission')?.checked,
            allowLate: !!document.getElementById('lms-task-allow-late')?.checked,
            status: old?.status === 'ditutup' ? 'ditutup' : 'aktif',
