        /* --- Logika Peta Terintegrasi --- */
        async function initMaps() {
            const geojsonUrl = 'https://raw.githubusercontent.com/AlfianAliM/Indonesia-GeoJSON/master/provinsi.geojson';

            const indonesiaBounds = L.latLngBounds([[-11.5, 94.2], [6.7, 141.5]]);
            const palette = ['#60a5fa', '#34d399', '#fbbf24', '#fb7185', '#a78bfa', '#22c55e', '#38bdf8'];

            function normalizeProvinceName(name) {
                if (!name) return '';
                const trimmed = String(name).trim();
                const key = trimmed.toLowerCase();

                const aliases = {
                    'aceh': 'Aceh',
                    'nanggroe aceh darussalam': 'Aceh',
                    'daerah istimewa aceh': 'Aceh',
                    'jawa barat': 'Jawa Barat',
                    'sumatera barat': 'Sumatera Barat',
                    'bali': 'Bali',
                    'kalimantan timur': 'Kalimantan Timur',
                    'sulawesi selatan': 'Sulawesi Selatan',
                    'papua': 'Papua',
                    'kepulauan bangka belitung': 'Kepulauan Bangka Belitung',
                    'bangka belitung': 'Kepulauan Bangka Belitung',
                    'bangka belitung islands': 'Kepulauan Bangka Belitung',
                    'kep. bangka belitung': 'Kepulauan Bangka Belitung',
                    'kepulauan bangka-belitung': 'Kepulauan Bangka Belitung'
                };

                if (aliases[key]) return aliases[key];

                return trimmed
                    .toLowerCase()
                    .split(' ')
                    .map(word => word ? word.charAt(0).toUpperCase() + word.slice(1) : '')
                    .join(' ');
            }

            function provinceColor(feature) {
                const code = String(feature?.properties?.code || '');
                const seed = [...code].reduce((sum, ch) => sum + ch.charCodeAt(0), 0);
                return palette[seed % palette.length];
            }

            function styleProvince(feature) {
                return {
                    color: '#ffffff',
                    weight: 1.6,
                    opacity: 1,
                    fillColor: provinceColor(feature),
                    fillOpacity: 0.88
                };
            }

            function onEachProvince(feature, layer) {
                const rawName = feature?.properties?.name || 'Provinsi';
                const provinceName = normalizeProvinceName(rawName);

                layer.bindTooltip(provinceName, {
                    sticky: true,
                    direction: 'top',
                    className: 'province-tooltip'
                });

                layer.on({
                    mouseover: function(e) {
                        e.target.setStyle({
                            weight: 2.5,
                            color: '#0f4b9b',
                            fillOpacity: 1
                        });
                        e.target.bringToFront();
                    },
                    mouseout: function(e) {
                        e.target.setStyle(styleProvince(feature));
                    },
                    click: function() {
                        if (dataProvinsi[provinceName]) {
                            openProvinsiPage(provinceName);
                        } else {
                            showToast(`Materi ${provinceName} sedang disiapkan.`, 'bg-blue-600');
                        }
                    }
                });
            }


            function addCompassControl(mapObj, isMini = false) {
                const compass = L.control({ position: 'bottomleft' });

                compass.onAdd = function() {
                    const className = `leaflet-control klik-compass${isMini ? ' klik-compass-mini' : ''}`;
                    const div = L.DomUtil.create('div', className);
                    div.setAttribute('role', 'img');
                    div.setAttribute('aria-label', 'Arah mata angin: Utara, Timur, Selatan, dan Barat');
                    div.setAttribute('title', 'U = Utara, T = Timur, S = Selatan, B = Barat');

                    div.innerHTML = `
                        <span class="compass-label north">U</span>
                        <span class="compass-label east">T</span>
                        <span class="compass-label south">S</span>
                        <span class="compass-label west">B</span>
                        <span class="compass-axis-v" aria-hidden="true"></span>
                        <span class="compass-axis-h" aria-hidden="true"></span>
                        <span class="compass-arrow-n" aria-hidden="true"></span>
                        <span class="compass-center" aria-hidden="true"></span>
                    `;

                    L.DomEvent.disableClickPropagation(div);
                    L.DomEvent.disableScrollPropagation(div);
                    return div;
                };

                compass.addTo(mapObj);
            }

            function addOceanLabels(mapObj, isMini = false) {
                const oceanLabels = [
                    { name: 'Samudra Hindia', coords: [-8.8, 100.2] },
                    { name: 'Samudra Pasifik', coords: [4.2, 136.4] }
                ];

                oceanLabels.forEach((item) => {
                    const icon = L.divIcon({
                        className: 'ocean-label-icon',
                        html: `<span class="ocean-map-label${isMini ? ' ocean-map-label-mini' : ''}">${item.name}</span>`,
                        iconSize: isMini ? [96, 18] : [124, 20],
                        iconAnchor: isMini ? [48, 9] : [62, 10]
                    });

                    L.marker(item.coords, {
                        icon,
                        interactive: false,
                        keyboard: false,
                        zIndexOffset: -500
                    }).addTo(mapObj);
                });
            }

            function getRoundedScaleStep(distance) {
                if (!Number.isFinite(distance) || distance <= 0) return 0;
                const exponent = Math.floor(Math.log10(distance));
                const magnitude = Math.pow(10, exponent);
                const normalized = distance / magnitude;
                let rounded = 1;
                if (normalized >= 5) rounded = 5;
                else if (normalized >= 3) rounded = 3;
                else if (normalized >= 2) rounded = 2;
                return rounded * magnitude;
            }

            function formatScaleLabel(distanceMeters, withUnit = false) {
                const useKilometers = distanceMeters >= 1000;
                const rawValue = useKilometers ? (distanceMeters / 1000) : distanceMeters;
                const roundedValue = rawValue >= 10 ? Math.round(rawValue) : Math.round(rawValue * 10) / 10;
                const valueText = String(roundedValue).replace(/\.0$/, '');
                if (!withUnit) return valueText;
                return `${valueText} ${useKilometers ? 'km' : 'm'}`;
            }

            function renderDynamicScale(mapObj, container, isMini = false) {
                if (!mapObj || !container) return;
                const maxWidth = isMini ? 56 : 76;
                const y = mapObj.getSize().y / 2;
                const start = mapObj.containerPointToLatLng([0, y]);
                const end = mapObj.containerPointToLatLng([maxWidth, y]);
                const maxMeters = mapObj.distance(start, end);
                const totalMeters = getRoundedScaleStep(maxMeters);
                const widthPx = Math.max(36, Math.round(maxWidth * (totalMeters / maxMeters)));
                const label = formatScaleLabel(totalMeters, true);

                container.setAttribute('aria-label', `Skala peta dinamis ${label}`);
                container.innerHTML = `
                    <div class="klik-scale-value">${label}</div>
                    <div class="klik-scale-bar" style="width:${widthPx}px" aria-hidden="true">
                        <span class="klik-scale-line"></span>
                        <span class="klik-scale-tick start"></span>
                        <span class="klik-scale-tick mid"></span>
                        <span class="klik-scale-tick end"></span>
                    </div>
                `;
            }

            function addScaleControl(mapObj, isMini = false) {
                const ScaleControl = L.Control.extend({
                    options: { position: 'bottomleft' },
                    onAdd() {
                        const div = L.DomUtil.create('div', `leaflet-control klik-scale${isMini ? ' klik-scale-mini' : ''}`);
                        div.setAttribute('role', 'img');
                        L.DomEvent.disableClickPropagation(div);
                        L.DomEvent.disableScrollPropagation(div);

                        const update = () => renderDynamicScale(mapObj, div, isMini);
                        update();
                        mapObj.on('zoomend moveend resize', update);
                        return div;
                    }
                });

                new ScaleControl().addTo(mapObj);
            }

            function createMap(targetId, isMini = false) {
                const mapObj = L.map(targetId, {
                    zoomControl: false,
                    attributionControl: false,
                    minZoom: isMini ? 3 : 4,
                    maxZoom: 8,
                    scrollWheelZoom: !isMini,
                    doubleClickZoom: !isMini,
                    boxZoom: false,
                    keyboard: !isMini,
                    dragging: true,
                    maxBounds: indonesiaBounds.pad(0.01),
                    maxBoundsViscosity: 1.0,
                    zoomSnap: 0.25
                });

                mapObj.fitBounds(indonesiaBounds, {
                    paddingTopLeft: isMini ? [6, 6] : [18, 18],
                    paddingBottomRight: isMini ? [6, 6] : [18, 18]
                });

                addScaleControl(mapObj, isMini);
                addCompassControl(mapObj, isMini);
                addOceanLabels(mapObj, isMini);

                return mapObj;
            }

            if (document.getElementById('map-beranda')) {
                berandaMap = createMap('map-beranda', true);
            }

            fullMap = createMap('map-full', false);

            try {
                const response = await fetch(geojsonUrl);
                if (!response.ok) throw new Error('GeoJSON gagal dimuat');
                const indonesiaGeoJSON = await response.json();
                window.indonesiaGeoJSONData = indonesiaGeoJSON;

                const addLayer = (mapObj) => {
                    const layer = L.geoJSON(indonesiaGeoJSON, {
                        style: styleProvince,
                        onEachFeature: onEachProvince
                    }).addTo(mapObj);

                    mapObj.fitBounds(layer.getBounds(), {
                        paddingTopLeft: [10, 10],
                        paddingBottomRight: [10, 10]
                    });
                };

                if (berandaMap) addLayer(berandaMap);
                addLayer(fullMap);

            } catch (error) {
                console.error(error);

                const fallback = `
                    <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-6 bg-blue-50 z-[500]">
                        <div class="w-14 h-14 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center text-2xl mb-3">
                            <i class="fas fa-map"></i>
                        </div>
                        <p class="text-sm font-bold text-[#0f4b9b]">Peta Indonesia</p>
                        <p class="text-[10px] text-gray-500 mt-2 max-w-xs">
                            Peta administratif memerlukan koneksi internet saat pertama kali dibuka.
                        </p>
                    </div>
                `;

                const mini = document.getElementById('map-beranda');
                const full = document.getElementById('map-full');
                if (mini) mini.insertAdjacentHTML('beforeend', fallback);
                if (full) full.insertAdjacentHTML('beforeend', fallback);
            }
        }

