<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Klik Nusantara - Prototype Pembelajaran IPS</title>
    <meta name="theme-color" content="#0f4b9b">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        html, body {
            width: 100%;
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
            background: #ffffff;
        }

        body {
            font-family: 'Inter', sans-serif;
            display: flex;
            justify-content: center;
            align-items: stretch;
            min-height: 100vh;
            min-height: 100dvh;
            overscroll-behavior: none;
            -webkit-tap-highlight-color: transparent;
        }

        .app-container {
            width: 100vw;
            max-width: none;
            height: 100vh;
            height: 100dvh;
            min-height: 100vh;
            min-height: 100dvh;
            max-height: none;
            background-color: #ffffff;
            position: relative;
            overflow: hidden;
            box-shadow: none;
            display: flex;
            flex-direction: column;
        }

        /* Area aman untuk HP yang memiliki notch / home indicator */
        .pb-safe {
            padding-bottom: max(0.5rem, env(safe-area-inset-bottom));
        }

        #main-app,
        #login-screen {
            min-height: 0;
            height: 100%;
        }

        #app-content {
            min-height: 0;
        }

        /* Pada HP: benar-benar memenuhi layar.
           Pada layar desktop/tablet besar tetap tampil seperti aplikasi mobile
           agar desain tidak melebar berlebihan. */
        @media (min-width: 640px) {
            body {
                background: #f3f4f6;
                align-items: center;
                padding: 16px 0;
                box-sizing: border-box;
            }

            .app-container {
                width: min(430px, 100vw);
                height: min(900px, calc(100dvh - 32px));
                min-height: 0;
                border-radius: 28px;
                box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.22);
            }
        }

        @media (max-width: 639px) {
            body {
                background: #ffffff;
                padding: 0;
            }

            .app-container {
                width: 100vw;
                max-width: 100vw;
                height: 100dvh;
                min-height: 100dvh;
                max-height: 100dvh;
                border-radius: 0;
                box-shadow: none;
            }
        }

        @supports not (height: 100dvh) {
            body,
            .app-container {
                height: 100vh;
                min-height: 100vh;
            }
        }
        *, *::before, *::after { box-sizing: border-box; }
        img, video, iframe { max-width: 100%; }
        .tab-content, #category-screen, #detail-screen, #culture-detail-screen { min-width: 0; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .fade-in { animation: fadeIn 0.3s ease-in-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .slide-up { animation: slideUp 0.3s ease-out forwards; }
        .slide-down { animation: slideDown 0.3s ease-in forwards; }
        @keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
        @keyframes slideDown { from { transform: translateY(0); } to { transform: translateY(100%); } }
        .tab-content { display: none; }
        .tab-content.active { display: flex; animation: fadeIn 0.2s ease-in-out; }
        .leaflet-container { z-index: 10 !important; font-family: 'Inter', sans-serif;}
        .leaflet-control-container { z-index: 20 !important; }
        
        
        .custom-div-icon { background: transparent; border: none; }

        .indonesia-map {
            background:
                radial-gradient(circle at 20% 15%, rgba(255,255,255,.7), transparent 26%),
                linear-gradient(180deg, #dff5ff 0%, #bfe9fb 100%);
        }

        .indonesia-map .leaflet-pane,
        .indonesia-map .leaflet-map-pane {
            background: transparent !important;
        }

        .indonesia-map .leaflet-control-zoom {
            border: none !important;
            box-shadow: 0 8px 20px rgba(15,75,155,.14);
        }

        .indonesia-map .leaflet-control-zoom a {
            border: none !important;
            color: #0f4b9b !important;
            background: rgba(255,255,255,.96) !important;
            font-weight: 800;
        }

        .province-tooltip {
            background: #0f4b9b !important;
            color: white !important;
            border: 0 !important;
            border-radius: 10px !important;
            box-shadow: 0 8px 18px rgba(15,75,155,.20) !important;
            font-family: 'Inter', sans-serif !important;
            font-size: 10px !important;
            font-weight: 700 !important;
            padding: 5px 8px !important;
        }

        .province-tooltip::before {
            border-top-color: #0f4b9b !important;
        }

        .map-helper-chip {
            background: rgba(255,255,255,.94);
            color: #0f4b9b;
            border: 1px solid rgba(191,219,254,.95);
            box-shadow: 0 6px 16px rgba(15,75,155,.12);
            backdrop-filter: blur(8px);
        }


    
        /* ============================================================
           RESPONSIVE LAPTOP / DESKTOP
           Mobile tetap full-screen. Desktop memakai sidebar + workspace.
           ============================================================ */

        .desktop-side-brand,
        .desktop-login-visual {
            display: none;
        }

        @media (min-width: 900px) {
            html, body {
                width: 100%;
                height: 100%;
                min-height: 100%;
                overflow: hidden;
                background: #eef3f8;
            }

            body {
                padding: 0;
                align-items: stretch;
            }

            .app-container {
                width: 100vw;
                max-width: none;
                height: 100vh;
                height: 100dvh;
                min-height: 100vh;
                min-height: 100dvh;
                max-height: none;
                border-radius: 0;
                box-shadow: none;
                background: #f6f8fb;
            }

            /* ---------- LOGIN DESKTOP ---------- */
            #login-screen {
                display: flex;
                flex-direction: row;
                align-items: stretch;
                background: #f8fafc;
            }

            #login-screen.hidden {
                display: none !important;
            }

            .desktop-login-visual {
                display: flex;
                width: 52%;
                min-width: 520px;
                position: relative;
                overflow: hidden;
                align-items: center;
                padding: 64px;
                color: white;
                background:
                    radial-gradient(circle at 15% 15%, rgba(56,189,248,.28), transparent 28%),
                    radial-gradient(circle at 80% 80%, rgba(99,102,241,.34), transparent 32%),
                    linear-gradient(145deg, #0b3b7f 0%, #0f4b9b 48%, #1e3a8a 100%);
            }

            .desktop-login-pattern {
                position: absolute;
                border: 1px solid rgba(255,255,255,.12);
                border-radius: 50%;
            }

            .desktop-login-pattern-one {
                width: 460px;
                height: 460px;
                right: -150px;
                top: -120px;
            }

            .desktop-login-pattern-two {
                width: 620px;
                height: 620px;
                left: -280px;
                bottom: -350px;
            }

            #login-screen > .flex-1 {
                width: 48%;
                max-width: 680px;
                min-width: 420px;
                padding: 40px 72px;
                margin: 0 auto;
                justify-content: center;
            }

            #login-screen > .flex-1 > .w-24,
            #login-screen > .flex-1 > h1,
            #login-screen > .flex-1 > p {
                display: none;
            }

            #login-screen > .flex-1 > .w-full {
                max-width: 460px;
                padding: 32px;
                border-radius: 24px;
                box-shadow: 0 18px 60px rgba(15,75,155,.10);
            }

            #login-screen > .py-4 {
                position: absolute;
                right: 0;
                bottom: 18px;
                width: 48%;
            }

            /* ---------- MAIN WORKSPACE ---------- */
            #main-app {
                height: 100%;
                min-height: 0;
                background: #f4f7fb;
            }

            #main-header {
                margin-left: 232px;
                width: calc(100% - 232px);
                border-radius: 0;
                padding: 18px 36px !important;
                min-height: 124px;
                display: flex;
                flex-direction: column;
                justify-content: center;
                box-shadow: 0 8px 24px rgba(15,75,155,.10);
            }

            #main-header > .flex:first-child {
                margin-bottom: 12px;
            }

            #main-header h1 {
                font-size: 20px;
            }

            #main-header .relative.mt-2 {
                max-width: 720px;
                width: min(720px, 60vw);
                margin-top: 0;
            }

            /* Sidebar memanfaatkan navigation yang sama dengan versi HP */
            #nav-siswa,
            #nav-guru {
                position: absolute;
                top: 0;
                bottom: 0;
                left: 0;
                width: 232px;
                height: 100%;
                border: 0;
                padding: 22px 16px 20px;
                background:
                    radial-gradient(circle at 20% 5%, rgba(59,130,246,.28), transparent 24%),
                    linear-gradient(180deg, #0f4b9b 0%, #103c78 100%);
                box-shadow: 10px 0 30px rgba(15,75,155,.10);
                flex-direction: column;
                justify-content: flex-start;
                align-items: stretch;
                gap: 7px;
                z-index: 70;
            }

            #nav-siswa.hidden,
            #nav-guru.hidden {
                display: none !important;
            }

            #nav-siswa:not(.hidden),
            #nav-guru:not(.hidden) {
                display: flex !important;
            }

            .desktop-side-brand {
                display: flex;
                align-items: center;
                gap: 12px;
                color: white;
                padding: 8px 8px 28px;
                margin-bottom: 12px;
                border-bottom: 1px solid rgba(255,255,255,.14);
            }

            .desktop-side-logo {
                width: 44px;
                height: 44px;
                border-radius: 14px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: rgba(255,255,255,.14);
                border: 1px solid rgba(255,255,255,.16);
                font-size: 18px;
                flex: 0 0 auto;
            }

            .desktop-side-title {
                font-size: 13px;
                line-height: 1.2;
                letter-spacing: .06em;
                font-weight: 900;
            }

            .desktop-side-subtitle {
                font-size: 9px;
                margin-top: 4px;
                color: rgba(219,234,254,.82);
                font-weight: 600;
            }

            #nav-siswa .nav-btn,
            #nav-guru .nav-btn {
                width: 100%;
                min-height: 48px;
                padding: 10px 13px !important;
                display: flex;
                flex-direction: row !important;
                justify-content: flex-start;
                align-items: center;
                gap: 12px;
                border-radius: 14px;
                color: rgba(219,234,254,.70) !important;
                transform: none !important;
            }

            #nav-siswa .nav-btn:hover,
            #nav-guru .nav-btn:hover {
                background: rgba(255,255,255,.09);
                color: white !important;
            }

            #nav-siswa .nav-btn.font-bold,
            #nav-guru .nav-btn.font-bold {
                background: rgba(255,255,255,.16);
                color: white !important;
                box-shadow: inset 0 0 0 1px rgba(255,255,255,.12);
            }

            #nav-siswa .nav-btn i,
            #nav-guru .nav-btn i {
                width: 24px;
                margin: 0 !important;
                font-size: 16px !important;
                text-align: center;
            }

            #nav-siswa .nav-btn span,
            #nav-guru .nav-btn span {
                font-size: 11px !important;
                font-weight: 700;
                white-space: nowrap;
            }

            /* Main tabs */
            .tab-content {
                margin-left: 232px;
                width: calc(100% - 232px);
            }

            #tab-beranda,
            #tab-quiz,
            #tab-materi,
            #tab-profil,
            #tab-siswa-guru,
            #tab-profil-guru {
                padding-bottom: 28px !important;
            }

            #tab-beranda > .p-4,
            #tab-quiz > .p-4,
            #tab-materi > .p-4,
            #tab-profil > .p-4,
            #tab-siswa-guru > .p-4,
            #tab-profil-guru > .p-4 {
                max-width: 1280px;
                margin: 0 auto;
                padding: 28px 32px 48px !important;
            }

            /* Beranda lebih lebar dan memanfaatkan dua kolom */
            #tab-beranda > .p-4 {
                display: grid;
                grid-template-columns: minmax(0, 1.25fr) minmax(320px, .75fr);
                gap: 22px;
                align-items: start;
            }

            #tab-beranda > .p-4 > :first-child {
                grid-column: 1 / -1;
            }

            #tab-beranda #map-beranda {
                min-height: 280px;
            }

            #tab-beranda .h-40 {
                height: 300px !important;
            }

            /* Quiz dan materi jadi dua kolom di layar besar */
            #tab-quiz > .p-4,
            #tab-materi > .p-4 {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 20px;
                align-items: start;
            }

            #tab-quiz > .p-4 > :first-child,
            #tab-materi > .p-4 > :first-child {
                grid-column: 1 / -1;
            }

            /* Profil tetap nyaman dibaca */
            #tab-profil > .p-4,
            #tab-profil-guru > .p-4 {
                max-width: 900px;
            }

            /* Full map */
            #tab-peta {
                margin-left: 232px;
                width: calc(100% - 232px);
                padding-bottom: 0 !important;
            }

            #tab-peta > .absolute.top-4 {
                left: 32px;
                right: 32px;
            }

            /* Province detail becomes desktop workspace */
            #detail-screen,
            #category-screen,
            #culture-detail-screen {
                left: 232px !important;
                right: 0 !important;
                top: 0 !important;
                bottom: 0 !important;
                width: calc(100% - 232px);
            }

            #detail-screen > .bg-\[\#0f4b9b\] {
                padding: 22px 36px !important;
            }

            #detail-screen > .flex-1 {
                padding: 28px 36px 46px !important;
            }

            #detail-screen > .flex-1 > * {
                max-width: 1180px;
                margin-left: auto;
                margin-right: auto;
            }

            #detail-screen .grid.grid-cols-2.gap-3 {
                grid-template-columns: repeat(4, minmax(0, 1fr));
                gap: 16px;
            }

            #detail-screen .grid.grid-cols-2.gap-3 > button {
                height: 210px !important;
            }

            #detail-screen .grid.grid-cols-2.gap-3 > button h4 {
                font-size: 14px !important;
            }

            #detail-screen .grid.grid-cols-2.gap-3 > button p {
                font-size: 10px !important;
            }

            #category-header,
            #culture-detail-header {
                padding: 20px 36px !important;
            }

            #category-screen > .flex-1,
            #culture-detail-screen > .flex-1 {
                padding: 26px 36px 48px !important;
            }

            #category-content,
            #culture-detail-content {
                width: min(100%, 1040px);
                margin: 0 auto;
            }

            #category-content img {
                max-height: 470px;
            }

            /* Notification / toast */
            #toast {
                left: calc(232px + (100% - 232px) / 2);
                top: 24px;
            }

            #notification-panel {
                right: 28px;
                left: auto !important;
                width: 380px;
                max-width: calc(100vw - 280px);
            }

            /* Chat button and panel */
            #chat-modal {
                right: 28px;
                left: auto;
                bottom: 28px;
                width: 420px;
                max-width: calc(100vw - 280px);
                height: min(650px, calc(100dvh - 56px));
                border-radius: 24px;
                overflow: hidden;
                box-shadow: 0 24px 70px rgba(15,23,42,.22);
            }

            button[onclick="toggleChat()"] {
                right: 28px !important;
                bottom: 28px !important;
            }

            /* Scrollbar ringan untuk desktop */
            .tab-content::-webkit-scrollbar,
            #detail-screen > .flex-1::-webkit-scrollbar,
            #category-screen > .flex-1::-webkit-scrollbar,
            #culture-detail-screen > .flex-1::-webkit-scrollbar {
                width: 8px;
            }

            .tab-content::-webkit-scrollbar-thumb,
            #detail-screen > .flex-1::-webkit-scrollbar-thumb,
            #category-screen > .flex-1::-webkit-scrollbar-thumb,
            #culture-detail-screen > .flex-1::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 999px;
            }

            .tab-content::-webkit-scrollbar-track,
            #detail-screen > .flex-1::-webkit-scrollbar-track,
            #category-screen > .flex-1::-webkit-scrollbar-track,
            #culture-detail-screen > .flex-1::-webkit-scrollbar-track {
                background: transparent;
            }
        }

        /* Laptop compact / tablet landscape */
        @media (min-width: 900px) and (max-width: 1100px) {
            #nav-siswa,
            #nav-guru {
                width: 196px;
            }

            #main-header,
            .tab-content,
            #tab-peta,
            #detail-screen,
            #category-screen,
            #culture-detail-screen {
                margin-left: 196px;
                width: calc(100% - 196px);
            }

            #detail-screen,
            #category-screen,
            #culture-detail-screen {
                left: 196px !important;
            }

            #detail-screen .grid.grid-cols-2.gap-3 {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            #tab-beranda > .p-4 {
                grid-template-columns: 1fr;
            }

            #tab-beranda > .p-4 > :first-child {
                grid-column: auto;
            }

            #tab-quiz > .p-4,
            #tab-materi > .p-4 {
                grid-template-columns: 1fr;
            }

            #tab-quiz > .p-4 > :first-child,
            #tab-materi > .p-4 > :first-child {
                grid-column: auto;
            }

            #toast {
                left: calc(196px + (100% - 196px) / 2);
            }
        }


        /* Beranda: sapaan dan fakta */
        #student-greeting-card,
        #did-you-know-card {
            min-width: 0;
        }

        @media (min-width: 900px) {
            #student-greeting-card {
                grid-column: 1 / -1;
                padding: 26px 30px;
            }

            #student-greeting-card h2 {
                font-size: 28px;
            }

            #did-you-know-card {
                min-height: 300px;
                display: flex;
                align-items: center;
                padding: 28px;
            }

            #home-exploration-guide {
                grid-column: 1 / -1;
            }
        }


        /* ============================================================
           Beranda visual lebih hidup
           ============================================================ */
        .student-greeting-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 16px;
            align-items: center;
        }

        .student-greeting-visual {
            position: relative;
            min-height: 255px;
            border-radius: 24px;
            background: linear-gradient(145deg, rgba(255,255,255,.14), rgba(255,255,255,.06));
            border: 1px solid rgba(255,255,255,.14);
            overflow: hidden;
            backdrop-filter: blur(8px);
        }

        .student-greeting-bigicon {
            position: absolute;
            top: 16px;
            right: 16px;
            width: 56px;
            height: 56px;
            border-radius: 18px;
            background: rgba(255,255,255,.16);
            border: 1px solid rgba(255,255,255,.16);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: inset 0 0 0 1px rgba(255,255,255,.04);
            z-index: 4;
        }

        .student-greeting-photo {
            position: absolute;
            border-radius: 18px;
            overflow: hidden;
            border: 2px solid rgba(255,255,255,.45);
            box-shadow: 0 12px 28px rgba(0,0,0,.20);
            background: rgba(255,255,255,.18);
        }

        .student-greeting-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .student-greeting-photo span {
            position: absolute;
            left: 10px;
            bottom: 10px;
            background: rgba(0,0,0,.45);
            color: white;
            font-size: 9px;
            font-weight: 800;
            padding: 4px 8px;
            border-radius: 999px;
            letter-spacing: .03em;
        }

        .student-greeting-photo.photo-1 {
            width: 46%;
            height: 118px;
            left: 14px;
            top: 22px;
            transform: rotate(-5deg);
        }

        .student-greeting-photo.photo-2 {
            width: 42%;
            height: 136px;
            right: 18px;
            top: 66px;
            transform: rotate(4deg);
        }

        .student-greeting-photo.photo-3 {
            width: 38%;
            height: 92px;
            left: 84px;
            bottom: 14px;
            transform: rotate(2deg);
        }


        .student-greeting-photo.photo-4 {
            width: 27%;
            height: 72px;
            left: 14px;
            bottom: 54px;
            transform: rotate(-8deg);
        }

        .student-greeting-photo.photo-5 {
            width: 29%;
            height: 74px;
            right: 18px;
            bottom: 50px;
            transform: rotate(6deg);
        }

        .student-greeting-overlay {
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 30% 25%, rgba(255,255,255,.08), transparent 34%),
                        linear-gradient(180deg, rgba(255,255,255,.02), rgba(15,23,42,.08));
            pointer-events: none;
        }

        .student-greeting-gallery-bar {
            position: absolute;
            left: 12px;
            right: 12px;
            bottom: 10px;
            z-index: 6;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 16px;
            background: rgba(15, 23, 42, .28);
            border: 1px solid rgba(255,255,255,.12);
            backdrop-filter: blur(8px);
            box-shadow: 0 8px 24px rgba(0,0,0,.12);
        }

        .student-greeting-gallery-meta {
            min-width: 0;
            flex: 1;
        }

        .student-greeting-gallery-label {
            font-size: 8px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .14em;
            color: rgba(219,234,254,.92);
        }

        .student-greeting-gallery-counter {
            font-size: 8px;
            font-weight: 800;
            color: white;
            margin-top: 3px;
