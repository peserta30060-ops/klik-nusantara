        function matchingThreadPoint(element, containerRect, side = 'bottom') {
            if (!element) return null;
            const anchor = element.querySelector('.matching-thread-anchor');
            const rect = (anchor || element).getBoundingClientRect();
            return {
                x: rect.left + rect.width / 2 - containerRect.left,
                y: rect.top + rect.height / 2 - containerRect.top
            };
        }

        function matchingCurvePath(a, b) {
            const distance = Math.max(55, Math.min(180, Math.abs(b.y - a.y) * .38));
            const c1y = a.y + distance;
            const c2y = b.y - distance;
            return `M ${a.x} ${a.y} C ${a.x} ${c1y}, ${b.x} ${c2y}, ${b.x} ${b.y}`;
        }

        function renderMatchingThreads() {
            const board = document.getElementById('matching-quiz-board-inner');
            const svg = document.getElementById('matching-thread-layer');
            const group = document.getElementById('matching-thread-lines');
            if (!board || !svg || !group) return;

            const boardRect = board.getBoundingClientRect();
            svg.setAttribute('viewBox', `0 0 ${Math.max(1, boardRect.width)} ${Math.max(1, boardRect.height)}`);
            group.innerHTML = '';

            matchingMatchedIds.forEach(id => {
                const item = matchingQuizPairs.find(entry => entry.id === id);
                if (!item) return;
                const source = document.getElementById(`matching-item-${id}`);
                const target = document.getElementById(`matching-province-${slugMatchingProvince(item.province)}`);
                const a = matchingThreadPoint(source, boardRect, 'bottom');
                const b = matchingThreadPoint(target, boardRect, 'top');
                if (!a || !b) return;

                const ns = 'http://www.w3.org/2000/svg';
                const path = document.createElementNS(ns, 'path');
                path.setAttribute('d', matchingCurvePath(a, b));
                path.setAttribute('class', 'matching-thread-path completed');
                group.appendChild(path);

                [a,b].forEach(point => {
                    const circle = document.createElementNS(ns, 'circle');
                    circle.setAttribute('cx', point.x);
                    circle.setAttribute('cy', point.y);
                    circle.setAttribute('r', '5');
                    circle.setAttribute('class', 'matching-thread-node');
                    group.appendChild(circle);
                });
            });
        }

        function ensureMatchingLiveThread() {
            let svg = document.getElementById('matching-live-thread');
            if (svg) return svg;
            svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
            svg.id = 'matching-live-thread';
            svg.setAttribute('viewBox', `0 0 ${window.innerWidth} ${window.innerHeight}`);
            svg.innerHTML = '<path id="matching-live-thread-path"></path><circle id="matching-live-thread-start" r="6"></circle><circle id="matching-live-thread-end" r="6"></circle>';
            document.body.appendChild(svg);
            return svg;
        }

        function updateMatchingLiveThread(clientX, clientY) {
            if (!matchingDragState?.source) return;
            const svg = ensureMatchingLiveThread();
            svg.setAttribute('viewBox', `0 0 ${window.innerWidth} ${window.innerHeight}`);
            const anchor = matchingDragState.source.querySelector('.matching-thread-anchor');
            const r = (anchor || matchingDragState.source).getBoundingClientRect();
            const a = { x: r.left + r.width / 2, y: r.top + r.height / 2 };
            const b = { x: clientX, y: clientY };
            const dy = Math.max(45, Math.min(160, Math.abs(b.y-a.y) * .4));
            const d = `M ${a.x} ${a.y} C ${a.x} ${a.y+dy}, ${b.x} ${b.y-dy}, ${b.x} ${b.y}`;
            document.getElementById('matching-live-thread-path')?.setAttribute('d', d);
            const start = document.getElementById('matching-live-thread-start');
            const end = document.getElementById('matching-live-thread-end');
            if (start) { start.setAttribute('cx', a.x); start.setAttribute('cy', a.y); }
            if (end) { end.setAttribute('cx', b.x); end.setAttribute('cy', b.y); }
        }

        function removeMatchingLiveThread() {
            document.getElementById('matching-live-thread')?.remove();
        }

        function slugMatchingProvince(value) {
            return value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
        }

        function startMatchingDrag(event, id) {
            if (matchingLocked || matchingMatchedIds.has(id)) return;
            if (event.button !== undefined && event.button !== 0) return;

            const item = matchingQuizPairs.find(entry => entry.id === id);
            const source = document.getElementById(`matching-item-${id}`);
            if (!item || !source) return;

            event.preventDefault();
            matchingSelectedItemId = id;
            matchingDragState = { id, pointerId: event.pointerId, source, overSlot: null, ghost: null };
            source.classList.add('dragging-source');
            document.body.classList.add('matching-is-dragging');

            const ghost = source.cloneNode(true);
            ghost.removeAttribute('id');
            ghost.removeAttribute('onpointerdown');
            ghost.classList.remove('dragging-source', 'matched');
            ghost.classList.add('matching-drag-ghost');
            document.body.appendChild(ghost);
            matchingDragState.ghost = ghost;
            moveMatchingGhost(event.clientX, event.clientY);
            updateMatchingLiveThread(event.clientX, event.clientY);

            window.addEventListener('pointermove', moveMatchingDrag, { passive: false });
            window.addEventListener('pointerup', endMatchingDrag, { passive: false, once: true });
            window.addEventListener('pointercancel', cancelMatchingDrag, { passive: false, once: true });
        }

        function moveMatchingGhost(x, y) {
            if (!matchingDragState?.ghost) return;
            matchingDragState.ghost.style.left = `${x}px`;
            matchingDragState.ghost.style.top = `${y}px`;
        }

        function moveMatchingDrag(event) {
            if (!matchingDragState) return;
            event.preventDefault();
            moveMatchingGhost(event.clientX, event.clientY);
            updateMatchingLiveThread(event.clientX, event.clientY);

            const scroller = document.querySelector('#matching-quiz-screen .quiz-page-content');
            if (scroller) {
                const rect = scroller.getBoundingClientRect();
                const edge = Math.min(90, Math.max(56, rect.height * 0.14));
                if (event.clientY > rect.bottom - edge) {
                    scroller.scrollTop += 14;
                } else if (event.clientY < rect.top + edge) {
                    scroller.scrollTop -= 14;
                }
            }

            const element = document.elementFromPoint(event.clientX, event.clientY);
            const slot = element?.closest?.('.matching-drop-slot');
            if (matchingDragState.overSlot && matchingDragState.overSlot !== slot) {
                matchingDragState.overSlot.classList.remove('drag-over');
            }
            if (slot && !slot.classList.contains('filled')) {
                slot.classList.add('drag-over');
                matchingDragState.overSlot = slot;
            } else {
                matchingDragState.overSlot = null;
            }
        }

        function endMatchingDrag(event) {
            if (!matchingDragState) return;
            event.preventDefault();
            const state = matchingDragState;
            const element = document.elementFromPoint(event.clientX, event.clientY);
            const slot = element?.closest?.('.matching-drop-slot');
            const province = slot && !slot.classList.contains('filled') ? slot.dataset.matchingDrop : null;
            cleanupMatchingDrag();

            if (province) {
                handleMatchingDrop(state.id, province);
            } else {
                const feedback = document.getElementById('matching-feedback');
                if (feedback) feedback.innerHTML = `
                    <div class="rounded-xl bg-slate-50 border border-slate-200 px-3 py-2.5 text-[9.5px] font-bold text-slate-600">
                        <i class="fas fa-hand mr-1.5"></i>Lepaskan kartu tepat di dalam kolom kosong salah satu provinsi.
                    </div>`;
            }
        }

        function cancelMatchingDrag(event) {
            if (event) event.preventDefault();
            cleanupMatchingDrag();
        }

        function cleanupMatchingDrag() {
            if (!matchingDragState) return;
            matchingDragState.source?.classList.remove('dragging-source');
            matchingDragState.overSlot?.classList.remove('drag-over');
            matchingDragState.ghost?.remove();
            removeMatchingLiveThread();
            matchingDragState = null;
            matchingSelectedItemId = null;
            document.body.classList.remove('matching-is-dragging');
            window.removeEventListener('pointermove', moveMatchingDrag);
        }

        function handleMatchingDrop(itemId, province) {
            if (matchingLocked || matchingMatchedIds.has(itemId)) return;
            const item = matchingQuizPairs.find(entry => entry.id === itemId);
            if (!item) return;
            matchingAttempts += 1;

            if (item.province === province) {
                matchingMatchedIds.add(item.id);
                matchingXp += 10;

                if (matchingMatchedIds.size === matchingQuizPairs.length) {
                    finishMatchingQuiz();
                } else {
                    renderMatchingQuizBoard(`
                        <div class="rounded-xl bg-emerald-50 border border-emerald-100 px-3 py-2.5 text-[9.5px] font-bold text-emerald-700">
                            <i class="fas fa-circle-check mr-1.5"></i>Cocok! <strong>${item.name}</strong> berasal dari ${province}. <span class="text-amber-600">+10 XP</span>
                        </div>
                    `);
                }
            } else {
                matchingWrong += 1;
                matchingLocked = true;
                const itemEl = document.getElementById(`matching-item-${itemId}`);
                const slotEl = document.getElementById(`matching-drop-${slugMatchingProvince(province)}`);
                if (itemEl) itemEl.classList.add('wrong-pulse');
                if (slotEl) slotEl.classList.add('wrong-pulse');
                const feedback = document.getElementById('matching-feedback');
                if (feedback) feedback.innerHTML = `
                    <div class="rounded-xl bg-rose-50 border border-rose-100 px-3 py-2.5 text-[9.5px] font-bold text-rose-700">
                        <i class="fas fa-xmark mr-1.5"></i>Belum cocok. <strong>${item.name}</strong> bukan berasal dari ${province}. Seret kembali ke provinsi lain.
                    </div>`;
                setTimeout(() => {
                    matchingLocked = false;
                    document.getElementById(`matching-item-${itemId}`)?.classList.remove('wrong-pulse');
                    document.getElementById(`matching-drop-${slugMatchingProvince(province)}`)?.classList.remove('wrong-pulse');
                }, 520);
            }
        }

        window.addEventListener('resize', () => requestAnimationFrame(renderMatchingThreads));
        document.addEventListener('scroll', (event) => {
            if (event.target?.closest?.('#matching-quiz-screen') || event.target?.id === 'matching-quiz-screen') {
                requestAnimationFrame(renderMatchingThreads);
            }
        }, true);

        function finishMatchingQuiz() {
            const stage = document.getElementById('matching-quiz-stage');
            if (!stage) return;

            const perfectBonus = matchingWrong === 0 ? 10 : 0;
            const totalXp = matchingXp + perfectBonus;
            if (totalXp > 0 && !matchingRewardClaimed) {
                addQuickQuizXpToHeader(totalXp);
                matchingRewardClaimed = true;
            }

            let title = 'Semua Pasangan Berhasil!';
            let subtitle = 'Kamu berhasil menghubungkan budaya dan tempat dengan provinsi asalnya.';
            let badge = 'Penjelajah Nusantara';
            if (matchingWrong === 0) {
                title = 'Sempurna! Semua Cocok!';
                subtitle = 'Tanpa satu pun kesalahan. Kamu mendapat bonus +10 XP.';
                badge = 'Master Mencocokkan';
            }

            stage.innerHTML = `
                <div class="text-center py-3 sm:py-5">
                    <div class="w-24 h-24 rounded-full bg-gradient-to-br from-violet-500 to-blue-600 text-white flex items-center justify-center mx-auto shadow-lg shadow-violet-200">
                        <i class="fas fa-link text-4xl"></i>
                    </div>
                    <p class="text-[9px] uppercase tracking-[0.16em] font-extrabold text-violet-500 mt-4">Selesai</p>
                    <h3 class="font-black text-xl text-gray-800 mt-1">${title}</h3>
                    <p class="text-xs text-gray-500 leading-relaxed max-w-md mx-auto mt-2">${subtitle}</p>

                    <div class="grid grid-cols-3 gap-2 max-w-md mx-auto mt-5">
                        <div class="rounded-2xl bg-emerald-50 border border-emerald-100 p-3">
                            <p class="text-lg font-black text-emerald-600">6/6</p>
                            <p class="text-[8px] text-emerald-700 font-bold">Cocok</p>
                        </div>
                        <div class="rounded-2xl bg-rose-50 border border-rose-100 p-3">
                            <p class="text-lg font-black text-rose-500">${matchingWrong}</p>
                            <p class="text-[8px] text-rose-700 font-bold">Salah Coba</p>
                        </div>
                        <div class="rounded-2xl bg-amber-50 border border-amber-100 p-3">
                            <p class="text-lg font-black text-amber-600">+${totalXp}</p>
                            <p class="text-[8px] text-amber-700 font-bold">XP</p>
                        </div>
                    </div>

                    <div class="max-w-md mx-auto mt-4 rounded-2xl bg-violet-50 border border-violet-100 p-4">
                        <i class="fas fa-medal text-violet-600 text-xl"></i>
                        <p class="text-[9px] uppercase tracking-wider font-extrabold text-violet-500 mt-1">Pencapaian</p>
                        <p class="font-black text-sm text-violet-900">${badge}</p>
                    </div>

                    <div class="flex flex-col sm:flex-row gap-2 justify-center mt-5">
                        <button type="button" onclick="startMatchingQuiz()" class="bg-violet-600 hover:bg-violet-700 text-white font-extrabold text-[10px] px-6 py-3 rounded-xl active:scale-95 transition">
                            <i class="fas fa-rotate-right mr-1.5"></i>Main Lagi
                        </button>
                        <button type="button" onclick="closeMatchingQuizPanel()" class="bg-white border border-gray-200 text-gray-600 hover:bg-gray-50 font-extrabold text-[10px] px-6 py-3 rounded-xl active:scale-95 transition">
                            <i class="fas fa-table-cells-large mr-1.5"></i>Pilih Quiz Lain
                        </button>
                    </div>
                </div>
            `;
        }

        function closeAllQuizScreens() {
            document.getElementById('quick-quiz-screen')?.classList.add('hidden');
            document.getElementById('image-quiz-screen')?.classList.add('hidden');
            document.getElementById('matching-quiz-screen')?.classList.add('hidden');
            document.getElementById('time-challenge-screen')?.classList.add('hidden');
            stopTimeChallengeTimer();
            timeChallengeRunning = false;
            cleanupMatchingDrag();
        }

        // Render layar awal mode quiz ketika DOM siap.
        function initQuizModes() {
            initQuickQuiz();
            renderImageQuizIntro();
            renderMatchingQuizIntro();
            renderTimeChallengeIntro();
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initQuizModes, { once: true });
        } else {
            initQuizModes();
        }

</script>

