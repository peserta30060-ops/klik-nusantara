        function handleSearchKeydown(event) {
            if (!event) return;
            if (event.key === 'Escape') {
                closeGlobalSearch();
                event.target.blur();
                return;
            }
            if (!globalSearchResults.length && event.key !== 'Enter') return;

            if (event.key === 'ArrowDown') {
                event.preventDefault();
                globalSearchActiveIndex = Math.min(globalSearchActiveIndex + 1, globalSearchResults.length - 1);
                updateSearchActiveResult();
            } else if (event.key === 'ArrowUp') {
                event.preventDefault();
                globalSearchActiveIndex = Math.max(globalSearchActiveIndex - 1, 0);
                updateSearchActiveResult();
            } else if (event.key === 'Enter') {
                event.preventDefault();
                const targetIndex = globalSearchActiveIndex >= 0 ? globalSearchActiveIndex : 0;
                if (globalSearchResults[targetIndex]) openGlobalSearchResult(targetIndex);
                else renderGlobalSearchResults(event.target.value);
            }
        }

