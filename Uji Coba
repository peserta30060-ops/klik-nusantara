        function getLocalAccounts() {
            try {
                const parsed = JSON.parse(localStorage.getItem(AUTH_STORAGE_KEY) || '[]');
                if (!Array.isArray(parsed)) return [];

                // Migrasi ringan agar akun prototype lama tetap tidak merusak struktur data.
                return parsed.map(account => {
                    const migrated = { ...account };

                    if (!migrated.email && migrated.username) {
                        if (migrated.username === 'guru.demo') migrated.email = 'guru.demo@kliknusantara.local';
                        else if (migrated.username === 'siswa.demo') migrated.email = 'siswa.demo@kliknusantara.local';
                    }

                    if (!migrated.emailKey && migrated.email) {
                        migrated.emailKey = normalizeAuthEmail(migrated.email);
                    }

                    if (migrated.role === 'siswa') {
                        if (!migrated.className && migrated.classCode) migrated.className = deriveClassName(migrated.classCode);
                    }

                    return migrated;
                });
            } catch (error) {
                return [];
            }
        }

