        function answerTimeChallenge(selectedIndex) {
            if (!timeChallengeRunning || timeChallengeLocked || !timeChallengeQuestion) return;
            if (Date.now() >= timeChallengeEndAt) {
                finishTimeChallenge();
                return;
            }

            timeChallengeLocked = true;
            const q = timeChallengeQuestion;
            const isCorrect = selectedIndex === q.correct;
            timeChallengeAnswered += 1;

            if (isCorrect) {
                timeChallengeCorrect += 1;
                timeChallengeStreak += 1;
                timeChallengeBestStreak = Math.max(timeChallengeBestStreak, timeChallengeStreak);
                const streakBonus = Math.min(100, Math.max(0, (timeChallengeStreak - 1) * 10));
                timeChallengeScore += 100 + streakBonus;
                timeChallengeXp += 5;
            } else {
                timeChallengeStreak = 0;
            }

            const buttons = Array.from(document.querySelectorAll('#time-answer-grid .time-answer-btn'));
            buttons.forEach((button, idx) => {
                button.disabled = true;
                const icon = button.querySelector('.time-answer-icon');

                if (idx === q.correct) {
                    button.classList.add('correct');
                    if (icon) icon.className = 'time-answer-icon fas fa-check-circle text-green-600';
                } else if (idx === selectedIndex) {
                    button.classList.add('wrong');
                    if (icon) icon.className = 'time-answer-icon fas fa-times-circle text-rose-500';
                }
            });

            const scoreEl = document.getElementById('time-score-value');
            const correctEl = document.getElementById('time-correct-value');
            const streakEl = document.getElementById('time-streak-value');
            const streakBadge = document.getElementById('time-streak-badge-value');

            if (scoreEl) scoreEl.textContent = String(timeChallengeScore);
            if (correctEl) correctEl.textContent = `${timeChallengeCorrect}/${timeChallengeAnswered}`;
            if (streakEl) streakEl.textContent = `${timeChallengeStreak}×`;
            if (streakBadge) streakBadge.textContent = `${timeChallengeStreak} streak`;

            const feedback = document.getElementById('time-answer-feedback');
            if (feedback) {
                feedback.innerHTML = isCorrect
                    ? `<div class="inline-flex items-center rounded-xl bg-emerald-50 border border-emerald-100 text-emerald-700 px-3 py-2 text-[9px] font-extrabold"><i class="fas fa-check-circle mr-1.5"></i>Benar! +5 XP ${timeChallengeStreak > 1 ? `• Streak ${timeChallengeStreak}×` : ''}</div>`
                    : `<div class="inline-flex items-center rounded-xl bg-rose-50 border border-rose-100 text-rose-700 px-3 py-2 text-[9px] font-extrabold"><i class="fas fa-circle-xmark mr-1.5"></i>Belum tepat • Jawaban: ${q.options[q.correct]}</div>`;
            }

            setTimeout(() => {
                if (!timeChallengeRunning) return;
                if (Date.now() >= timeChallengeEndAt) {
                    finishTimeChallenge();
                } else {
                    renderNextTimeChallengeQuestion();
                }
            }, 520);
        }

