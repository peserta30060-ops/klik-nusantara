        let studentGreetingGalleryStart = 0;
        let studentGreetingGalleryTimer = null;

        function renderStudentGreetingGallery(startIndex = 0) {
            if (!studentGreetingGallery.length) return;

            const total = studentGreetingGallery.length;
            studentGreetingGalleryStart = ((startIndex % total) + total) % total;
            const slotCount = 5;

            for (let i = 0; i < slotCount; i++) {
                const item = studentGreetingGallery[(studentGreetingGalleryStart + i) % total];
                const imgEl = document.getElementById(`greeting-photo-img-${i + 1}`);
                const labelEl = document.getElementById(`greeting-photo-label-${i + 1}`);
                const wrapEl = document.getElementById(`greeting-photo-${i + 1}`);
                if (imgEl) {
                    imgEl.style.display = '';
                    imgEl.src = item.image;
                    imgEl.alt = item.title;
                }
                if (labelEl) labelEl.textContent = item.label;
                if (wrapEl) wrapEl.title = `${item.title} • ${item.label}`;
            }

            const counterEl = document.getElementById('student-greeting-gallery-counter');
            if (counterEl) {
                const current = studentGreetingGallery[studentGreetingGalleryStart];
                counterEl.textContent = `${current.title} • ${current.label} · geser untuk lihat foto lain`;
            }

            const dotsEl = document.getElementById('student-greeting-gallery-dots');
            if (dotsEl) {
                dotsEl.innerHTML = studentGreetingGallery.map((item, idx) =>
                    `<button type="button" onclick="goToStudentGreetingGallery(${idx})" class="${idx === studentGreetingGalleryStart ? 'active' : ''}" aria-label="${item.title}"></button>`
                ).join('');
            }
        }

        function nextStudentGreetingGallery() {
            renderStudentGreetingGallery(studentGreetingGalleryStart + 1);
            restartStudentGreetingGalleryAuto();
        }

        function prevStudentGreetingGallery() {
            renderStudentGreetingGallery(studentGreetingGalleryStart - 1);
            restartStudentGreetingGalleryAuto();
        }

        function goToStudentGreetingGallery(index) {
            renderStudentGreetingGallery(index);
            restartStudentGreetingGalleryAuto();
        }

        function restartStudentGreetingGalleryAuto() {
            if (studentGreetingGalleryTimer) clearInterval(studentGreetingGalleryTimer);
            studentGreetingGalleryTimer = setInterval(() => {
                renderStudentGreetingGallery(studentGreetingGalleryStart + 1);
            }, 5000);
        }

        function setDidYouKnowTheme(fact) {
            const card = document.getElementById('did-you-know-card');
            const iconBox = document.getElementById('did-you-know-iconbox');
            const provinceEl = document.getElementById('did-you-know-province');
            const mainBadge = document.getElementById('did-you-know-main-badge');

            if (!card || !iconBox || !provinceEl || !mainBadge) return;

            card.className = 'relative overflow-hidden rounded-[24px] border shadow-sm p-4';
            iconBox.className = 'w-12 h-12 shrink-0 rounded-2xl text-white flex items-center justify-center shadow-sm';

            const tag = (fact.tag || '').toLowerCase();
            if (tag.includes('budaya') || tag.includes('seni') || tag.includes('arsitektur')) {
                card.classList.add('bg-gradient-to-br', 'from-rose-50', 'via-pink-50', 'to-orange-50', 'border-rose-200');
                iconBox.classList.add('bg-gradient-to-br', 'from-rose-500', 'to-orange-500');
                provinceEl.className = 'shrink-0 bg-white/90 border border-rose-200 text-rose-700 rounded-full px-2.5 py-1 text-[8px] font-extrabold';
                mainBadge.className = 'bg-white/90 text-rose-700 rounded-full px-2.5 py-1 text-[8px] font-extrabold shadow-sm';
            } else if (tag.includes('alam') || tag.includes('geografi') || tag.includes('wisata')) {
                card.classList.add('bg-gradient-to-br', 'from-cyan-50', 'via-sky-50', 'to-emerald-50', 'border-cyan-200');
                iconBox.classList.add('bg-gradient-to-br', 'from-cyan-500', 'to-emerald-500');
                provinceEl.className = 'shrink-0 bg-white/90 border border-cyan-200 text-cyan-700 rounded-full px-2.5 py-1 text-[8px] font-extrabold';
                mainBadge.className = 'bg-white/90 text-cyan-700 rounded-full px-2.5 py-1 text-[8px] font-extrabold shadow-sm';
            } else {
                card.classList.add('bg-gradient-to-br', 'from-amber-50', 'via-yellow-50', 'to-orange-50', 'border-amber-200');
                iconBox.classList.add('bg-gradient-to-br', 'from-amber-400', 'to-orange-500');
                provinceEl.className = 'shrink-0 bg-white/90 border border-amber-200 text-amber-700 rounded-full px-2.5 py-1 text-[8px] font-extrabold';
                mainBadge.className = 'bg-white/90 text-amber-700 rounded-full px-2.5 py-1 text-[8px] font-extrabold shadow-sm';
            }
        }

        function handleFactImageError(img) {
            if (!img) return;
            img.style.display = 'none';
            const wrap = img.parentElement;
            const fallback = wrap?.querySelector('.fact-fallback');
            if (fallback) fallback.classList.remove('hidden');
        }

        function renderFactMediaTarget(fact, gallery, target) {
            const suffix = target === 'mobile' ? '-mobile' : '';
            const imageEl = document.getElementById(`did-you-know-image${suffix}`);
            const captionEl = document.getElementById(`did-you-know-image-caption${suffix}`);
            const indexEl = document.getElementById(`did-you-know-main-index${suffix}`);
            const badgeEl = document.getElementById(`did-you-know-main-badge${suffix}`);
            const galleryWrap = document.getElementById(`did-you-know-gallery${suffix}`);

            if (!imageEl || !captionEl || !indexEl || !badgeEl || !galleryWrap) return;

            const current = gallery[currentFactGalleryIndex];

            imageEl.style.display = '';
            imageEl.src = current.image;
            imageEl.alt = current.caption || fact.title || 'Fakta Nusantara';
            captionEl.textContent = current.caption || fact.title || 'Fakta Nusantara';
            indexEl.textContent = `${currentFactGalleryIndex + 1} / ${gallery.length}`;
            badgeEl.textContent = current.label || 'Foto Utama';

            const fallback = imageEl.parentElement?.querySelector('.fact-fallback');
            if (fallback) fallback.classList.add('hidden');

            galleryWrap.innerHTML = gallery.map((item, idx) => `
                <button type="button"
                        onclick="showDidYouKnowImage(${idx})"
                        class="did-you-know-thumb ${idx === currentFactGalleryIndex ? 'active' : ''}">
                    <img src="${item.image}"
                         alt="${item.label || item.caption || fact.title}"
                         onerror="this.style.visibility='hidden';">
                    <div class="thumb-label">${item.label || ('Foto ' + (idx + 1))}</div>
                </button>
            `).join('');
        }

        function renderDidYouKnowGallery(fact) {
            const gallery = Array.isArray(fact.gallery) && fact.gallery.length ? fact.gallery : [];
            const dotsWrap = document.getElementById('did-you-know-dots');

            if (!gallery.length) {
                const desktopGallery = document.getElementById('did-you-know-gallery');
                const mobileGallery = document.getElementById('did-you-know-gallery-mobile');
                if (desktopGallery) desktopGallery.innerHTML = '';
                if (mobileGallery) mobileGallery.innerHTML = '';
                if (dotsWrap) dotsWrap.innerHTML = '';
                return;
            }

            currentFactGalleryIndex = Math.max(0, Math.min(currentFactGalleryIndex, gallery.length - 1));

            renderFactMediaTarget(fact, gallery, 'desktop');
            renderFactMediaTarget(fact, gallery, 'mobile');

            if (dotsWrap) {
                dotsWrap.innerHTML = gallery.map((_, idx) =>
                    `<span class="did-you-know-dot ${idx === currentFactGalleryIndex ? 'active' : ''}"></span>`
                ).join('');
            }
        }

        function showDidYouKnowImage(index) {
            const fact = nusantaraHomeFacts[nusantaraHomeFactIndex];
            if (!fact || !Array.isArray(fact.gallery)) return;
            currentFactGalleryIndex = Math.max(0, Math.min(index, fact.gallery.length - 1));
            renderDidYouKnowGallery(fact);
        }

        function applyDidYouKnowFact(index) {
            if (!nusantaraHomeFacts.length) return;
            nusantaraHomeFactIndex = index;
            currentFactGalleryIndex = 0;

            const fact = nusantaraHomeFacts[index];
            const provinceEl = document.getElementById('did-you-know-province');
            const titleEl = document.getElementById('did-you-know-title');
            const textEl = document.getElementById('did-you-know-text');
            const tagEl = document.getElementById('did-you-know-tag');
            const subtagEl = document.getElementById('did-you-know-subtag');
            const iconEl = document.getElementById('did-you-know-icon');
            const mini1 = document.getElementById('did-you-know-miniicon-1');
            const mini2 = document.getElementById('did-you-know-miniicon-2');
            const mini3 = document.getElementById('did-you-know-miniicon-3');

            if (provinceEl) provinceEl.textContent = fact.province;
            if (titleEl) titleEl.textContent = fact.title;
            if (textEl) textEl.textContent = fact.text;
            if (tagEl) tagEl.innerHTML = `<i class="fas fa-star mr-1.5"></i>${fact.tag || 'Fakta Menarik'}`;
            if (subtagEl) subtagEl.innerHTML = `<i class="fas fa-book-open mr-1.5 text-amber-500"></i>${fact.subtag || 'Belajar sambil eksplorasi'}`;
            if (iconEl) iconEl.className = `fas ${fact.icon || 'fa-lightbulb'} text-lg`;

            const minis = fact.miniIcons || ['fa-tree', 'fa-utensils', 'fa-landmark'];
            if (mini1) mini1.innerHTML = `<i class="fas ${minis[0] || 'fa-tree'}"></i>`;
            if (mini2) mini2.innerHTML = `<i class="fas ${minis[1] || 'fa-utensils'}"></i>`;
            if (mini3) mini3.innerHTML = `<i class="fas ${minis[2] || 'fa-landmark'}"></i>`;

            setDidYouKnowTheme(fact);
            renderDidYouKnowGallery(fact);
        }

        function showNextNusantaraFact() {
            if (!nusantaraHomeFacts.length) return;

            let nextIndex;
            if (nusantaraHomeFacts.length === 1) {
                nextIndex = 0;
            } else {
                do {
                    nextIndex = Math.floor(Math.random() * nusantaraHomeFacts.length);
                } while (nextIndex === nusantaraHomeFactIndex);
            }

            applyDidYouKnowFact(nextIndex);
        }

        function showPrevNusantaraFact() {
            if (!nusantaraHomeFacts.length) return;
            if (nusantaraHomeFactIndex < 0) {
                applyDidYouKnowFact(0);
                return;
            }
            const prevIndex = (nusantaraHomeFactIndex - 1 + nusantaraHomeFacts.length) % nusantaraHomeFacts.length;
            applyDidYouKnowFact(prevIndex);
        }

