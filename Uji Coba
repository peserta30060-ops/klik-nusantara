        function cultureLearningFocus(item) {
            const type = String(item?.jenis || '').toLowerCase();
            if (type.includes('tari') || type.includes('seni pertunjukan')) {
                return 'Perhatikan gerak, kostum, musik pengiring, fungsi pertunjukan, dan konteks masyarakat yang melestarikannya.';
            }
            if (type.includes('alat musik')) {
                return 'Perhatikan bahan pembuat, cara memainkan, bunyi yang dihasilkan, dan perannya dalam kegiatan budaya masyarakat.';
            }
            if (type.includes('arsitektur') || type.includes('rumah')) {
                return 'Perhatikan bentuk bangunan, bahan, tata ruang, fungsi, serta hubungan arsitektur dengan lingkungan dan kehidupan masyarakat.';
            }
            if (type.includes('kuliner')) {
                return 'Perhatikan bahan utama, cara penyajian, kebiasaan masyarakat, dan hubungan makanan dengan identitas daerah.';
            }
            if (type.includes('kain') || type.includes('pakaian') || type.includes('kerajinan')) {
                return 'Perhatikan bahan, teknik pembuatan, motif atau bentuk, fungsi, serta nilai budaya yang melekat pada karya tersebut.';
            }
            if (type.includes('tradisi') || type.includes('upacara') || type.includes('festival') || type.includes('kearifan')) {
                return 'Perhatikan tujuan kegiatan, siapa yang terlibat, nilai kebersamaan, dan bagaimana tradisi tersebut diwariskan antargenerasi.';
            }
            return 'Perhatikan bentuk, fungsi, nilai, serta hubungan budaya tersebut dengan kehidupan masyarakat daerah asalnya.';
        }

