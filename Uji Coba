        function answerProvinceFactGame(answer) {
            if (provinceGameLocked) return;

            const data = dataProvinsi[currentProvince].quiz.game;
            const item = data[provinceGameIndex];
            if (!item) return;

            provinceGameLocked = true;
            const correct = answer === item.benar;
            const feedback = document.getElementById('fact-game-feedback');
            const trueBtn = document.getElementById('game-true');
            const falseBtn = document.getElementById('game-false');

            provinceGameAnswers.push({
                index: provinceGameIndex,
                selected: answer,
                correct: item.benar,
                isCorrect: correct
            });

            document.querySelectorAll('.fact-game-btn').forEach(b => {
                b.disabled = true;
                b.classList.add('cursor-default');
            });

            const correctBtn = item.benar ? trueBtn : falseBtn;
            const wrongBtn = answer ? trueBtn : falseBtn;

            if (correctBtn) {
                correctBtn.classList.add('ring-2', 'ring-green-400', 'ring-offset-2');
            }
            if (!correct && wrongBtn) {
                wrongBtn.classList.add('opacity-60', 'ring-2', 'ring-red-300', 'ring-offset-2');
            }

            if (correct) {
                provinceGameCorrect++;
                provinceGameScore += 5;
                provinceGameXpEarned += 5;
                currentXp += 5;
                if (typeof updateXP === 'function') updateXP();
            }

            const isLast = provinceGameIndex === data.length - 1;
            feedback.className = `mt-5 rounded-2xl p-4 text-left text-[10px] leading-relaxed border ${
                correct ? 'bg-green-50 text-green-800 border-green-200' : 'bg-red-50 text-red-800 border-red-200'
            }`;

