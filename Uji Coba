        function makeProvinceShapeSvg(provinceName) {
            const data = window.indonesiaGeoJSONData;
            if (!data || !Array.isArray(data.features)) {
                return `<div class="absolute right-3 bottom-2 text-white/20 text-[90px]"><i class="fas fa-map"></i></div>`;
            }

            const target = String(provinceName || '').trim().toLowerCase();
            const feature = data.features.find(f => {
                const n = String(f?.properties?.name || '').trim().toLowerCase();
                return n === target;
            });

            if (!feature || !feature.geometry) {
                return `<div class="absolute right-3 bottom-2 text-white/20 text-[90px]"><i class="fas fa-map"></i></div>`;
            }

            let rings = [];
            const g = feature.geometry;
            if (g.type === 'Polygon') {
                if (g.coordinates?.[0]) rings = [g.coordinates[0]];
            } else if (g.type === 'MultiPolygon') {
                rings = (g.coordinates || []).map(poly => poly?.[0]).filter(Boolean);
            }

            if (!rings.length) {
                return `<div class="absolute right-3 bottom-2 text-white/20 text-[90px]"><i class="fas fa-map"></i></div>`;
            }

            const pts = rings.flat();
            const xs = pts.map(p => p[0]);
            const ys = pts.map(p => p[1]);
            const minX = Math.min(...xs), maxX = Math.max(...xs);
            const minY = Math.min(...ys), maxY = Math.max(...ys);
            const spanX = Math.max(maxX - minX, 0.0001);
            const spanY = Math.max(maxY - minY, 0.0001);
            const W = 260, H = 170, pad = 15;
            const scale = Math.min((W - pad*2) / spanX, (H - pad*2) / spanY);
            const drawW = spanX * scale, drawH = spanY * scale;
            const ox = (W - drawW) / 2;
            const oy = (H - drawH) / 2;

            const paths = rings.map(ring => {
                return ring.map((p, i) => {
                    const x = ox + (p[0] - minX) * scale;
                    const y = H - (oy + (p[1] - minY) * scale);
                    return `${i === 0 ? 'M' : 'L'} ${x.toFixed(2)} ${y.toFixed(2)}`;
                }).join(' ') + ' Z';
            }).join(' ');

            return `
                <svg viewBox="0 0 ${W} ${H}" class="absolute right-[-10px] bottom-[-2px] w-[62%] h-[78%] opacity-30 drop-shadow-xl pointer-events-none" aria-label="Siluet wilayah ${provinceName}">
                    <path d="${paths}" fill="rgba(255,255,255,0.78)" stroke="rgba(255,255,255,0.95)" stroke-width="2.2" stroke-linejoin="round"/>
                </svg>`;
        }



