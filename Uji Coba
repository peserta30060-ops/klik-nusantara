        function deriveClassName(classCode = '') {
            const code = String(classCode || '').trim().toUpperCase();
            const match = code.match(/(?:KLS-|IPS)?(\d{1,2}[A-Z])(?:-|$)/i);
            return match ? `Kelas ${match[1].toUpperCase()}` : (code ? `Kelas ${code}` : 'Belum terhubung kelas');
        }

        function escapeHtml(value = '') {
            return String(value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function getCurrentSession() {
            try {
                const session = JSON.parse(localStorage.getItem(AUTH_SESSION_KEY) || 'null');
                return session && typeof session === 'object' ? session : null;
            } catch (e) {
                return null;
            }
        }

        function getCurrentAccount() {
            const session = getCurrentSession();
            if (!session?.accountId) return null;
            return getLocalAccounts().find(account => account.id === session.accountId) || null;
        }

