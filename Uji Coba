        function getProvinceGameRecord(provinceName) {
            try {
                const raw = localStorage.getItem('klikNusantaraGameRecords');
                const all = raw ? JSON.parse(raw) : {};
                return all[provinceName] || { quiz: 0, game: 0 };
            } catch (e) {
                return { quiz: 0, game: 0 };
            }
        }

        function saveProvinceGameRecord(provinceName, type, pct) {
            try {
                const raw = localStorage.getItem('klikNusantaraGameRecords');
                const all = raw ? JSON.parse(raw) : {};
                if (!all[provinceName]) all[provinceName] = { quiz: 0, game: 0 };
                all[provinceName][type] = Math.max(all[provinceName][type] || 0, pct);
                localStorage.setItem('klikNusantaraGameRecords', JSON.stringify(all));
                if (type === 'quiz') {
                    const session = getCurrentSession();
                    if (session?.role === 'siswa' && session.accountId) saveStudentQuizProgress(session.accountId, provinceName, pct);
                }
            } catch (e) {
                // Prototype tetap berjalan walaupun localStorage diblokir browser.
            }
        }

