            const email = normalizeAuthEmail(document.getElementById('register-email')?.value || '');
            const className = String(document.getElementById('register-class-name')?.value || '').trim();
            const classCode = String(document.getElementById('register-class-code')?.value || '').trim().toUpperCase();
            const password = document.getElementById('register-password')?.value || '';
            const confirmPassword = document.getElementById('register-confirm-password')?.value || '';
            const recoveryPin = String(document.getElementById('register-recovery-pin')?.value || '').trim();

            if (name.length < 2) return setAuthFeedback('register-feedback', 'Masukkan nama lengkap terlebih dahulu.');
            if (!isValidAuthEmail(email)) return setAuthFeedback('register-feedback', 'Masukkan alamat email yang valid.');
            if (currentRole === 'siswa' && !className) return setAuthFeedback('register-feedback', 'Nama Kelas wajib diisi oleh siswa.');
            if (currentRole === 'siswa' && !classCode) return setAuthFeedback('register-feedback', 'Kode Kelas wajib diisi oleh siswa.');
            if (password.length < 6) return setAuthFeedback('register-feedback', 'Kata sandi minimal 6 karakter.');
            if (password !== confirmPassword) return setAuthFeedback('register-feedback', 'Ulangi kata sandi belum sama.');
            if (!/^\d{4,6}$/.test(recoveryPin)) return setAuthFeedback('register-feedback', 'PIN pemulihan harus terdiri dari 4–6 angka.');

            const accounts = getLocalAccounts();
            if (accounts.some(account => account.emailKey === email)) {
                return setAuthFeedback('register-feedback', 'Alamat email tersebut sudah digunakan. Gunakan email lain atau masuk dengan akun yang sudah ada.');
            }

            const knownClass = getTeacherClasses().find(item => String(item.classCode || '').trim().toUpperCase() === classCode);
            const resolvedClassName = knownClass?.className || className;

            accounts.push({
                id: `KN-${Date.now()}`,
                role: 'siswa',
                name,
                email,
                emailKey: email,
                className: resolvedClassName,
                classCode,
                xp: 0,
                password,
                recoveryPin,
                createdAt: new Date().toISOString()
            });
            saveLocalAccounts(accounts);

            document.getElementById('email').value = email;
            document.getElementById('password').value = '';
            ['register-name','register-email','register-class-name','register-class-code','register-password','register-confirm-password','register-recovery-pin']
                .forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });

            closeRegisterModal();
            setAuthFeedback('login-feedback', 'Akun siswa berhasil dibuat. Silakan masukkan kata sandi untuk login.', 'success');
            document.getElementById('password')?.focus();
        }

        function handleResetPassword() {
            const email = normalizeAuthEmail(document.getElementById('forgot-email')?.value || '');
            const pin = String(document.getElementById('forgot-recovery-pin')?.value || '').trim();
            const newPassword = document.getElementById('forgot-new-password')?.value || '';
            const confirmPassword = document.getElementById('forgot-confirm-password')?.value || '';

            if (!email || !pin || !newPassword || !confirmPassword) return setAuthFeedback('forgot-feedback', 'Lengkapi semua data pemulihan akun.');
            if (!isValidAuthEmail(email)) return setAuthFeedback('forgot-feedback', 'Masukkan alamat email yang valid.');
            if (newPassword.length < 6) return setAuthFeedback('forgot-feedback', 'Kata sandi baru minimal 6 karakter.');
            if (newPassword !== confirmPassword) return setAuthFeedback('forgot-feedback', 'Ulangi kata sandi baru belum sama.');

            const accounts = getLocalAccounts();
            const index = accounts.findIndex(account => account.role === currentRole && account.emailKey === email);
            if (index < 0) return setAuthFeedback('forgot-feedback', `Akun ${currentRole === 'siswa' ? 'siswa' : 'guru'} dengan email tersebut tidak ditemukan.`);
            if (String(accounts[index].recoveryPin) !== pin) return setAuthFeedback('forgot-feedback', 'PIN pemulihan tidak sesuai.');

            accounts[index].password = newPassword;
            accounts[index].updatedAt = new Date().toISOString();
            saveLocalAccounts(accounts);

            document.getElementById('email').value = accounts[index].email;
            document.getElementById('password').value = '';
            ['forgot-email','forgot-recovery-pin','forgot-new-password','forgot-confirm-password']
                .forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });

            closeForgotPassword();
            setAuthFeedback('login-feedback', 'Kata sandi berhasil diubah. Silakan login dengan kata sandi baru.', 'success');
            document.getElementById('password')?.focus();
        }

