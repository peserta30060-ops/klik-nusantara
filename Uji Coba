                                <strong id="time-correct-value">${timeChallengeCorrect}/${timeChallengeAnswered}</strong>
                                <span>Benar / Jawab</span>
                            </div>
                            <div class="time-stat-card">
                                <strong id="time-streak-value">${timeChallengeStreak}×</strong>
                                <span>Streak</span>
                            </div>
                        </div>
                    </aside>

                    <section class="time-question-card">
                        <div class="flex items-center justify-between gap-3">
                            <span class="inline-flex items-center rounded-full bg-rose-50 border border-rose-100 text-rose-700 px-3 py-1.5 text-[8px] font-extrabold uppercase tracking-wider">
                                <i class="fas ${q.icon} mr-1.5"></i>${q.category}
                            </span>
                            <span class="time-streak-badge">
                                <i class="fas fa-fire"></i><span id="time-streak-badge-value">${timeChallengeStreak} streak</span>
                            </span>
