        }

        function syncDistributionFileName() {
            const input = document.getElementById('distribution-file');
            const label = document.getElementById('distribution-file-name');
            if (!label) return;
            const file = input?.files?.[0];
            label.textContent = file ? `${file.name} • ${Math.max(1, Math.round(file.size / 1024))} KB` : 'PDF, DOCX, PPTX, gambar, atau file lainnya';
