        function answerProvinceQuiz(index) {
            if (provinceQuizLocked) return;

            const data = dataProvinsi[currentProvince].quiz.questions;
            const q = data[provinceQuizIndex];
            if (!q || index < 0 || index >= q.pilihan.length) return;

            provinceQuizLocked = true;

            const buttons = document.querySelectorAll('.province-quiz-option');
            const feedback = document.getElementById('province-quiz-feedback');
            const correct = index === q.benar;

            provinceQuizAnswers.push({
                index: provinceQuizIndex,
                selected: index,
                correct: q.benar,
                isCorrect: correct
            });

            buttons.forEach((btn, i) => {
                btn.disabled = true;
                btn.classList.add('cursor-default');
                const letter = btn.querySelector('.quiz-letter');

                if (i === q.benar) {
                    btn.classList.remove('bg-gray-50', 'border-gray-200');
                    btn.classList.add('bg-green-50', 'border-green-400', 'text-green-700');
                    if (letter) {
                        letter.classList.add('bg-green-500', 'text-white', 'border-green-500');
                    }
                } else if (i === index) {
                    btn.classList.remove('bg-gray-50', 'border-gray-200');
                    btn.classList.add('bg-red-50', 'border-red-300', 'text-red-600');
                    if (letter) {
                        letter.classList.add('bg-red-500', 'text-white', 'border-red-500');
                    }
                } else {
                    btn.classList.add('opacity-60');
                }
