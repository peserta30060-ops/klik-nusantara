        function setDistributionFeedback(message = '', type = 'success') {
            const el = document.getElementById('distribution-feedback');
            if (!el) return;
            if (!message) { el.classList.add('hidden'); el.textContent = ''; return; }
            el.textContent = message;
            el.className = `mt-3 rounded-xl px-3 py-2 text-[10px] ${type === 'error' ? 'bg-red-50 border border-red-100 text-red-700' : 'bg-emerald-50 border border-emerald-100 text-emerald-700'}`;
        }

        function fileToDataUrl(file) {
            return new Promise(resolve => {
                if (!file || file.size > 700 * 1024) return resolve(null);
                const reader = new FileReader();
                reader.onload = () => resolve(typeof reader.result === 'string' ? reader.result : null);
                reader.onerror = () => resolve(null);
                reader.readAsDataURL(file);
            });
        }

        function formatDistributionDeadline(value = '') {
            if (!value) return '-';
            try {
                return new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(`${value}T00:00:00`));
            } catch (e) { return value; }
        }

        async function handleTeacherDistributionSubmit() {
            const teacher = getCurrentAccount();
            if (!teacher || teacher.role !== 'guru') return showToast('Masuk sebagai guru untuk mengirim materi.', 'bg-red-600');
            const classCode = String(document.getElementById('distribution-class-select')?.value || '').trim().toUpperCase();
            const targetClass = getTeacherManagedClasses(teacher).find(item => String(item.classCode).toUpperCase() === classCode);
            const type = document.getElementById('distribution-type')?.value || 'pengumuman';
            const title = String(document.getElementById('distribution-title')?.value || '').trim();
            const message = String(document.getElementById('distribution-message')?.value || '').trim();
            const file = document.getElementById('distribution-file')?.files?.[0] || null;
            if (!targetClass) return setDistributionFeedback('Pilih atau buat kelas terlebih dahulu.', 'error');
            if (!title) return setDistributionFeedback('Judul kiriman wajib diisi.', 'error');
            if (!message && !file) return setDistributionFeedback('Tuliskan pesan/petunjuk atau unggah lampiran.', 'error');

            const fileData = await fileToDataUrl(file);
            const item = {
                id: `DIST-${Date.now()}`,
                teacherId: teacher.id,
                teacherName: teacher.name || 'Guru',
                classCode: targetClass.classCode,
                className: targetClass.className,
                type,
                title,
                message,
                fileName: file?.name || '',
                fileType: file?.type || '',
                fileSize: file?.size || 0,
                fileData,
                createdAt: new Date().toISOString()
            };

            if (type === 'kuis') {
                item.questionCount = Math.max(0, Number(document.getElementById('distribution-question-count')?.value) || 0);
                item.xpReward = Math.max(0, Number(document.getElementById('distribution-xp-reward')?.value) || 0);
                item.deadline = document.getElementById('distribution-deadline')?.value || '';
            }

            const distributions = getTeacherDistributions();
            distributions.unshift(item);
            localStorage.setItem(TEACHER_DISTRIBUTIONS_STORAGE_KEY, JSON.stringify(distributions.slice(0, 100)));

            if (type === 'kuis') {
                const assignments = getTeacherAssignments();
                assignments.unshift({
                    id: `TUGAS-${Date.now()}`,
                    classCode: targetClass.classCode,
                    className: targetClass.className,
                    title,
                    teacher: teacher.name || 'Guru',
                    subject: 'IPS',
                    description: message || (file ? `Kuis terlampir: ${file.name}` : 'Kuis tambahan dari guru.'),
                    questionCount: item.questionCount,
                    deadline: formatDistributionDeadline(item.deadline),
                    xpReward: item.xpReward,
                    status: 'aktif',
                    sourceDistributionId: item.id,
                    attachmentName: item.fileName || ''
                });
                localStorage.setItem(TEACHER_ASSIGNMENTS_STORAGE_KEY, JSON.stringify(assignments));
            }

            document.getElementById('distribution-title').value = '';
            document.getElementById('distribution-message').value = '';
            const fileInput = document.getElementById('distribution-file');
            if (fileInput) fileInput.value = '';
            syncDistributionFileName();
            setDistributionFeedback(`${type === 'kuis' ? 'Kuis' : type === 'materi' ? 'Materi' : 'Pengumuman'} berhasil dikirim ke ${targetClass.className} (${targetClass.classCode}).${file && !fileData ? ' File berukuran besar dicatat sebagai metadata; penyimpanan file penuh memerlukan backend.' : ''}`);
            renderTeacherDistributionWorkspace(teacher);
            showToast(`Kiriman dikirim ke ${targetClass.className}.`, 'bg-emerald-600');
        }

