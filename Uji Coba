<script>
(function () {
    const BLIND_MAP_GEOJSON_SOURCES = [
        'https://raw.githubusercontent.com/AlfianAliM/Indonesia-GeoJSON/master/provinsi.geojson',
        'https://cdn.jsdelivr.net/gh/AlfianAliM/Indonesia-GeoJSON@master/provinsi.geojson'
    ];

    let blindMapLoadPromise = null;

    function getReadyBlindFeatures() {
        const data = window.indonesiaGeoJSONData;
        if (!data || !Array.isArray(data.features)) return [];
        return data.features.filter(f =>
            f &&
            f.geometry &&
            f.properties &&
            String(f.properties.name || '').trim()
        );
    }

    async function ensureBlindMapGeoData() {
        if (getReadyBlindFeatures().length >= 5) {
            return window.indonesiaGeoJSONData;
        }

        if (blindMapLoadPromise) {
            return blindMapLoadPromise;
        }

        blindMapLoadPromise = (async () => {
            let lastError = null;

            for (const url of BLIND_MAP_GEOJSON_SOURCES) {
                try {
                    const controller = new AbortController();
                    const timer = setTimeout(() => controller.abort(), 20000);

                    const response = await fetch(url, {
                        method: 'GET',
                        cache: 'force-cache',
                        signal: controller.signal
                    });

                    clearTimeout(timer);

                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}`);
                    }

                    const data = await response.json();

                    if (!data || !Array.isArray(data.features) || data.features.length < 5) {
                        throw new Error('Data provinsi tidak lengkap');
                    }

                    window.indonesiaGeoJSONData = data;
                    return data;
                } catch (error) {
                    lastError = error;
                    console.warn('Blind Map: gagal memuat dari', url, error);
                }
            }

            blindMapLoadPromise = null;
            throw lastError || new Error('Data peta tidak dapat dimuat');
        })();

        return blindMapLoadPromise;
    }

    function blindMapLoadingView(message = 'Menyiapkan peta Indonesia...') {
        const stage = document.getElementById('blind-map-stage');
        if (!stage) return;

        stage.innerHTML = `
            <div class="text-center py-10 sm:py-14">
                <div class="w-20 h-20 mx-auto rounded-[24px] bg-gradient-to-br from-teal-50 to-cyan-100 border border-teal-100 flex items-center justify-center text-teal-600 shadow-inner">
                    <i class="fas fa-spinner fa-spin text-2xl"></i>
                </div>
                <p class="text-sm font-black text-slate-800 mt-4">${message}</p>
                <p class="text-[10px] text-slate-500 mt-2 max-w-md mx-auto leading-relaxed">
                    Sistem sedang menyiapkan batas 38 provinsi agar setiap wilayah pada peta dapat diklik.
                </p>
            </div>
        `;
    }

    function blindMapErrorView() {
        const stage = document.getElementById('blind-map-stage');
        if (!stage) return;

        stage.innerHTML = `
            <div class="text-center py-8 sm:py-12">
                <div class="w-20 h-20 mx-auto rounded-[24px] bg-amber-50 border border-amber-100 flex items-center justify-center text-amber-600">
                    <i class="fas fa-triangle-exclamation text-2xl"></i>
                </div>
                <h3 class="text-base font-black text-slate-800 mt-4">Peta belum berhasil dimuat</h3>
                <p class="text-[10px] text-slate-500 leading-relaxed max-w-md mx-auto mt-2">
                    Pastikan perangkat terhubung ke internet. Klik tombol di bawah untuk mencoba memuat peta kembali.
                </p>
                <button type="button" onclick="retryBlindMapLoad()"
                        class="mt-5 bg-teal-600 hover:bg-teal-700 text-white rounded-xl px-6 py-3 text-[10px] font-black active:scale-95 transition">
                    <i class="fas fa-rotate-right mr-1.5"></i>Coba Muat Lagi
                </button>
            </div>
        `;
    }

    window.retryBlindMapLoad = async function () {
        blindMapLoadPromise = null;
        blindMapLoadingView('Memuat ulang peta Indonesia...');

        try {
            await ensureBlindMapGeoData();
            if (typeof window.__renderWorkingBlindMapIntro === 'function') {
                window.__renderWorkingBlindMapIntro();
            } else {
                window.startBlindMapQuiz();
            }
        } catch (error) {
            console.error('Blind Map retry error:', error);
            blindMapErrorView();
        }
    };

    // Simpan fungsi sebelumnya supaya dapat dipakai setelah data sudah tersedia.
    const previousOpenBlindMapPanel = window.openBlindMapPanel;
    const previousStartBlindMapQuiz = window.startBlindMapQuiz;

    // Intro baru: tombol Mulai selalu tersedia.
    window.__renderWorkingBlindMapIntro = function () {
        const stage = document.getElementById('blind-map-stage');
        if (!stage) return;

        const featureCount = getReadyBlindFeatures().length;

        stage.innerHTML = `
            <div class="text-center py-3 sm:py-5">
                <div class="w-20 h-20 rounded-[24px] bg-gradient-to-br from-teal-50 to-cyan-100 text-teal-600 flex items-center justify-center mx-auto shadow-inner border border-teal-100">
                    <i class="fas fa-map-location-dot text-3xl"></i>
                </div>
                <p class="text-[9px] uppercase tracking-[0.16em] font-extrabold text-teal-600 mt-4">Blind Map · Peta Utuh</p>
                <h3 class="font-black text-xl text-gray-800 mt-1">Klik Provinsi pada Peta Indonesia</h3>
                <p class="text-xs text-gray-500 leading-relaxed max-w-lg mx-auto mt-2">
                    Akan muncul nama provinsi, misalnya <b>Aceh</b>. Klik langsung wilayah Aceh pada peta Indonesia.
                    Tidak ada pilihan A, B, C, atau D.
                </p>

                <div class="grid grid-cols-3 gap-2 max-w-md mx-auto mt-5">
                    <div class="blind-map-mini-stat">
                        <i class="fas fa-map text-teal-600"></i>
                        <p class="font-black text-sm text-teal-900 mt-1">${featureCount >= 5 ? featureCount : '38'}</p>
                        <p class="text-[8px] text-teal-700 font-bold">Provinsi</p>
                    </div>
                    <div class="blind-map-mini-stat">
                        <i class="fas fa-hand-pointer text-blue-600"></i>
                        <p class="font-black text-sm text-blue-900 mt-1">Klik</p>
                        <p class="text-[8px] text-blue-700 font-bold">Wilayah</p>
                    </div>
                    <div class="blind-map-mini-stat">
                        <i class="fas fa-star text-amber-500"></i>
                        <p class="font-black text-sm text-amber-900 mt-1">+15</p>
                        <p class="text-[8px] text-amber-700 font-bold">XP / Benar</p>
                    </div>
                </div>

                <button type="button" onclick="startBlindMapQuiz()"
                        class="mt-6 inline-flex items-center justify-center bg-teal-600 hover:bg-teal-700 text-white font-extrabold text-xs px-7 py-3.5 rounded-xl shadow-md shadow-teal-100 active:scale-95 transition">
                    Mulai Blind Map <i class="fas fa-play ml-2"></i>
                </button>

                <p class="text-[8px] text-slate-400 mt-3">
                    <i class="fas fa-circle-info mr-1"></i>
                    Jika data peta belum siap, sistem akan memuatnya otomatis.
                </p>
            </div>
        `;
    };

    window.openBlindMapPanel = async function () {
        const screen = document.getElementById('blind-map-screen');
        if (!screen) return;

        [
            'quick-quiz-screen',
            'image-quiz-screen',
            'matching-quiz-screen',
            'time-challenge-screen',
            'teacher-assignments-section',
            'teacher-assignment-detail-screen',
            'teacher-lms-screen'
        ].forEach(id => document.getElementById(id)?.classList.add('hidden'));

        if (typeof stopTimeChallengeTimer === 'function') {
            stopTimeChallengeTimer();
        }

        screen.classList.remove('hidden');

        const scroller = screen.querySelector('.quiz-page-content');
        if (scroller) scroller.scrollTop = 0;

        // Tampilkan intro segera, lalu preload peta di belakang layar.
        window.__renderWorkingBlindMapIntro();

        if (getReadyBlindFeatures().length < 5) {
            try {
                await ensureBlindMapGeoData();
                // Refresh intro untuk menampilkan jumlah provinsi setelah data siap.
                if (!screen.classList.contains('hidden')) {
                    window.__renderWorkingBlindMapIntro();
                }
            } catch (error) {
                // Tidak mengganti intro menjadi error di sini:
                // pengguna masih bisa menekan Mulai untuk retry eksplisit.
                console.warn('Blind Map preload belum selesai:', error);
            }
        }
    };

    window.startBlindMapQuiz = async function () {
        blindMapLoadingView('Menyiapkan soal dan peta Indonesia...');

        try {
            await ensureBlindMapGeoData();

            if (getReadyBlindFeatures().length < 5) {
                throw new Error('Data provinsi masih belum lengkap');
            }

            if (typeof previousStartBlindMapQuiz === 'function') {
                previousStartBlindMapQuiz();
            }
        } catch (error) {
            console.error('Blind Map start error:', error);
            blindMapErrorView();
        }
    };

    // Preload ringan setelah login/app sudah terbuka agar saat diklik biasanya langsung siap.
    setTimeout(() => {
        ensureBlindMapGeoData().catch(() => {});
    }, 1200);
})();
</script>


<script>
(function () {
    let blindLeafletMap = null;
    let blindLeafletLayer = null;
    let blindLeafletQuestions = [];
    let blindLeafletIndex = 0;
    let blindLeafletCorrect = 0;
    let blindLeafletXp = 0;
    let blindLeafletLocked = false;
    let blindLeafletRewardClaimed = false;
    let blindLeafletClickedName = '';

    const BLIND_INDONESIA_BOUNDS = [[-11.5, 94.2], [6.7, 141.5]];
    const BLIND_PALETTE = ['#60a5fa', '#34d399', '#fbbf24', '#fb7185', '#a78bfa', '#22c55e', '#38bdf8'];

    function bmEscape(value) {
        const d = document.createElement('div');
        d.textContent = String(value ?? '');
        return d.innerHTML;
    }

    function bmNormalizeProvinceName(name) {
        if (!name) return '';
        const trimmed = String(name).trim();
        const key = trimmed.toLowerCase();

        const aliases = {
            'aceh': 'Aceh',
            'nanggroe aceh darussalam': 'Aceh',
            'daerah istimewa aceh': 'Aceh',
            'bangka belitung': 'Kepulauan Bangka Belitung',
            'bangka belitung islands': 'Kepulauan Bangka Belitung',
            'kep. bangka belitung': 'Kepulauan Bangka Belitung',
            'kepulauan bangka-belitung': 'Kepulauan Bangka Belitung',
            'dki jakarta': 'DKI Jakarta',
            'jakarta raya': 'DKI Jakarta',
            'daerah khusus ibukota jakarta': 'DKI Jakarta',
            'di yogyakarta': 'DI Yogyakarta',
            'daerah istimewa yogyakarta': 'DI Yogyakarta',
            'yogyakarta': 'DI Yogyakarta'
        };

        if (aliases[key]) return aliases[key];

        return trimmed
            .toLowerCase()
            .split(/\s+/)
            .map(word => word ? word.charAt(0).toUpperCase() + word.slice(1) : '')
            .join(' ');
    }

    function bmShuffle(arr) {
        const copy = [...arr];
        for (let i = copy.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [copy[i], copy[j]] = [copy[j], copy[i]];
        }
        return copy;
    }

    function getBlindGeoData() {
        const data = window.indonesiaGeoJSONData;
        if (!data || !Array.isArray(data.features)) return null;
        return data;
    }

    function blindProvinceColor(feature) {
        const code = String(feature?.properties?.code || feature?.properties?.name || '');
        const seed = [...code].reduce((sum, ch) => sum + ch.charCodeAt(0), 0);
        return BLIND_PALETTE[Math.abs(seed) % BLIND_PALETTE.length];
    }

    function blindDefaultStyle(feature) {
        return {
            color: '#ffffff',
            weight: 1.6,
            opacity: 1,
            fillColor: blindProvinceColor(feature),
            fillOpacity: .88
        };
    }

    function buildBlindLeafletQuestions() {
        const data = getBlindGeoData();
        if (!data) return [];
        const names = [];
        data.features.forEach(feature => {
            const n = bmNormalizeProvinceName(feature?.properties?.name || '');
            if (n && !names.includes(n)) names.push(n);
        });

        // Utamakan provinsi yang materialnya tersedia di situs, lalu acak.
        const supported = names.filter(name => !window.dataProvinsi || dataProvinsi[name]);
        const pool = supported.length >= 6 ? supported : names;
        return bmShuffle(pool).slice(0, Math.min(8, pool.length));
    }

    function destroyBlindLeafletMap() {
        if (blindLeafletMap) {
            try { blindLeafletMap.remove(); } catch (e) {}
        }
        blindLeafletMap = null;
        blindLeafletLayer = null;
    }

    function createBlindLeafletMap(targetName) {
        const el = document.getElementById('blind-main-leaflet-map');
        const data = getBlindGeoData();
        if (!el || !data || typeof L === 'undefined') return false;

        destroyBlindLeafletMap();

        blindLeafletMap = L.map('blind-main-leaflet-map', {
            zoomControl: false,
            attributionControl: false,
            minZoom: 3,
            maxZoom: 8,
            scrollWheelZoom: true,
            doubleClickZoom: true,
            boxZoom: false,
            keyboard: true,
            dragging: true,
            maxBounds: L.latLngBounds(BLIND_INDONESIA_BOUNDS).pad(.02),
            maxBoundsViscosity: 1.0,
            zoomSnap: .25
        });

        blindLeafletLayer = L.geoJSON(data, {
            style: blindDefaultStyle,
            onEachFeature(feature, layer) {
                // SENGAJA tidak memakai bindTooltip/bindPopup.
                // Inilah perbedaan dengan Peta Utama: nama provinsi tidak diperlihatkan.
                layer.on({
                    mouseover(e) {
                        if (blindLeafletLocked) return;
                        e.target.setStyle({
                            weight: 2.5,
                            color: '#0f4b9b',
                            fillOpacity: 1
                        });
                        try { e.target.bringToFront(); } catch (_) {}
                    },
                    mouseout(e) {
                        if (blindLeafletLocked) return;
                        e.target.setStyle(blindDefaultStyle(feature));
                    },
                    click() {
                        if (blindLeafletLocked) return;
                        const clickedName = bmNormalizeProvinceName(feature?.properties?.name || '');
                        answerBlindLeaflet(clickedName, targetName, layer);
                    }
                });
            }
        }).addTo(blindLeafletMap);

        blindLeafletMap.fitBounds(blindLeafletLayer.getBounds(), {
            paddingTopLeft: [8,8],
            paddingBottomRight: [8,8]
        });

        setTimeout(() => {
            try { blindLeafletMap.invalidateSize(); } catch (_) {}
        }, 100);

        return true;
    }

    function paintBlindResult(clickedName, targetName, clickedLayer) {
        if (!blindLeafletLayer) return;
        blindLeafletLayer.eachLayer(layer => {
            const name = bmNormalizeProvinceName(layer?.feature?.properties?.name || '');
            if (name === targetName) {
                layer.setStyle({
                    color: '#047857',
                    weight: 2.8,
                    fillColor: '#10b981',
                    fillOpacity: 1
                });
                try { layer.bringToFront(); } catch (_) {}
            } else if (name === clickedName && clickedName !== targetName) {
                layer.setStyle({
                    color: '#be123c',
                    weight: 2.8,
                    fillColor: '#fb7185',
                    fillOpacity: 1
                });
                try { layer.bringToFront(); } catch (_) {}
            } else {
                const base = blindDefaultStyle(layer.feature);
                layer.setStyle({
                    ...base,
                    fillOpacity: .42,
                    opacity: .7
                });
            }
        });
    }

    function renderBlindLeafletIntro() {
        const stage = document.getElementById('blind-map-stage');
        if (!stage) return;

        stage.innerHTML = `
            <div class="text-center py-3 sm:py-5">
                <div class="w-20 h-20 rounded-[24px] bg-gradient-to-br from-blue-50 to-cyan-100 text-[#0f4b9b] flex items-center justify-center mx-auto shadow-inner border border-blue-100">
                    <i class="fas fa-map-location-dot text-3xl"></i>
                </div>
                <p class="text-[9px] uppercase tracking-[0.16em] font-extrabold text-teal-600 mt-4">Blind Map · Peta Utama</p>
                <h3 class="font-black text-xl text-gray-800 mt-1">Temukan Provinsi di Peta Indonesia</h3>
                <p class="text-xs text-gray-500 leading-relaxed max-w-lg mx-auto mt-2">
                    Peta menggunakan batas provinsi yang sama dengan <b>fitur Peta Utama</b>,
                    tetapi semua nama provinsinya disembunyikan.
                    Baca nama provinsi pada bar, lalu klik wilayah yang tepat.
                </p>

                <div class="grid grid-cols-3 gap-2 max-w-md mx-auto mt-5">
                    <div class="blind-map-mini-stat">
                        <i class="fas fa-map text-blue-600"></i>
                        <p class="font-black text-sm text-blue-900 mt-1">Utuh</p>
                        <p class="text-[8px] text-blue-700 font-bold">Peta Utama</p>
                    </div>
                    <div class="blind-map-mini-stat">
                        <i class="fas fa-eye-slash text-teal-600"></i>
                        <p class="font-black text-sm text-teal-900 mt-1">Tanpa</p>
                        <p class="text-[8px] text-teal-700 font-bold">Nama</p>
                    </div>
                    <div class="blind-map-mini-stat">
                        <i class="fas fa-hand-pointer text-amber-500"></i>
                        <p class="font-black text-sm text-amber-900 mt-1">Klik</p>
                        <p class="text-[8px] text-amber-700 font-bold">Wilayah</p>
                    </div>
                </div>

                <button type="button" onclick="startBlindMapQuiz()"
                        class="mt-6 inline-flex items-center justify-center bg-[#0f4b9b] hover:bg-blue-800 text-white font-extrabold text-xs px-7 py-3.5 rounded-xl shadow-md shadow-blue-100 active:scale-95 transition">
                    Mulai Blind Map <i class="fas fa-play ml-2"></i>
                </button>
            </div>
        `;
    }

    function renderBlindLeafletQuestion() {
        const stage = document.getElementById('blind-map-stage');
        if (!stage) return;

        if (blindLeafletIndex >= blindLeafletQuestions.length) {
            finishBlindLeafletQuiz();
            return;
        }

        const targetName = blindLeafletQuestions[blindLeafletIndex];
        const total = blindLeafletQuestions.length;
        const number = blindLeafletIndex + 1;
        const progress = Math.round(((number - 1) / total) * 100);

        stage.innerHTML = `
            <div>
                <div class="blind-main-target-bar">
                    <div class="min-w-0">
                        <p class="text-[8px] uppercase tracking-[0.18em] font-black text-teal-100">Temukan Provinsi</p>
                        <p class="blind-main-target-name mt-1">${bmEscape(targetName)}</p>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                        <div class="rounded-xl bg-white/12 border border-white/15 px-3 py-2 text-center">
                            <p class="text-[7px] text-teal-100 font-bold">Soal</p>
                            <p class="text-[11px] font-black">${number}/${total}</p>
                        </div>
                        <div class="rounded-xl bg-white/12 border border-white/15 px-3 py-2 text-center">
                            <p class="text-[7px] text-teal-100 font-bold">XP</p>
                            <p class="text-[11px] font-black">${blindLeafletXp}</p>
                        </div>
                    </div>
                </div>

                <div class="blind-map-progress mt-3">
                    <div style="width:${progress}%"></div>
                </div>

                <div class="mt-3 flex items-center justify-between gap-3">
                    <p class="text-[9px] font-bold text-slate-600">
                        <i class="fas fa-hand-pointer text-[#0f4b9b] mr-1.5"></i>
                        Klik <b>${bmEscape(targetName)}</b> langsung pada peta.
                    </p>
                    <p class="text-[8px] text-slate-400 hidden sm:block">
                        Geser / zoom peta bila diperlukan
                    </p>
                </div>

                <div class="blind-main-map-shell mt-3">
                    <div id="blind-main-leaflet-map"></div>
                    <div class="blind-main-compass">U</div>
                    <div class="blind-main-map-note">
                        <i class="fas fa-eye-slash mr-1"></i>Nama provinsi disembunyikan
                    </div>
                </div>

                <div id="blind-main-feedback" class="mt-3"></div>
            </div>
        `;

        const ok = createBlindLeafletMap(targetName);
        if (!ok) {
            document.getElementById('blind-main-feedback').innerHTML = `
                <div class="blind-main-result wrong">
                    <p class="text-[10px] font-black">Peta belum siap.</p>
                    <p class="text-[9px] mt-1">Klik “Muat Ulang Peta” untuk mencoba lagi.</p>
                    <button onclick="retryBlindMainMap()" class="mt-3 rounded-xl bg-teal-600 text-white px-4 py-2.5 text-[9px] font-black">
                        <i class="fas fa-rotate-right mr-1"></i>Muat Ulang Peta
                    </button>
                </div>`;
        }
    }

    function answerBlindLeaflet(clickedName, targetName, clickedLayer) {
        if (blindLeafletLocked) return;
        blindLeafletLocked = true;
        blindLeafletClickedName = clickedName;

        const correct = clickedName === targetName;
        if (correct) {
            blindLeafletCorrect++;
            blindLeafletXp += 15;
        }

        paintBlindResult(clickedName, targetName, clickedLayer);

        const feedback = document.getElementById('blind-main-feedback');
        const isLast = blindLeafletIndex === blindLeafletQuestions.length - 1;

        if (feedback) {
            feedback.innerHTML = `
                <div class="blind-main-result ${correct ? 'correct' : 'wrong'}">
                    <div class="flex items-start gap-3">
                        <div class="w-9 h-9 rounded-xl bg-white/75 flex items-center justify-center shrink-0">
                            <i class="fas ${correct ? 'fa-circle-check' : 'fa-circle-xmark'}"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-[10px] font-black">
                                ${correct ? 'Benar! Lokasi provinsinya tepat.' : 'Belum tepat.'}
                            </p>
                            <p class="text-[9.5px] leading-relaxed mt-1">
                                ${correct
                                    ? `Wilayah yang kamu klik adalah <b>${bmEscape(targetName)}</b>. +15 XP.`
                                    : `Kamu mengklik <b>${bmEscape(clickedName)}</b>. Wilayah <b>${bmEscape(targetName)}</b> ditandai hijau pada peta.`
                                }
                            </p>
                            <p class="text-[8.5px] font-bold mt-2 opacity-75">
                                <i class="fas fa-spinner fa-spin mr-1"></i>
                                ${isLast ? 'Menyiapkan hasil...' : 'Soal berikutnya akan muncul otomatis...'}
                            </p>
                        </div>
                    </div>
                </div>
            `;
        }

        // Tidak perlu tombol Next. Feedback ditampilkan sebentar,
        // lalu sistem otomatis berpindah ke provinsi berikutnya.
        setTimeout(() => {
            blindLeafletIndex++;
            blindLeafletLocked = false;
            blindLeafletClickedName = '';

            if (blindLeafletIndex >= blindLeafletQuestions.length) {
                finishBlindLeafletQuiz();
            } else {
                renderBlindLeafletQuestion();
            }
        }, 1200);
    }

    window.retryBlindMainMap = async function() {
        if (typeof window.retryBlindMapLoad === 'function') {
            const feedback = document.getElementById('blind-main-feedback');
            if (feedback) {
                feedback.innerHTML = `<div class="rounded-xl bg-blue-50 border border-blue-100 p-3 text-[9px] text-blue-700">
                    <i class="fas fa-spinner fa-spin mr-1"></i>Memuat peta Indonesia...
                </div>`;
            }
            try {
                // retryBlindMapLoad dari patch sebelumnya akan memuat GeoJSON.
                await Promise.resolve(window.retryBlindMapLoad());
                setTimeout(renderBlindLeafletQuestion, 300);
            } catch (_) {}
        } else {
            renderBlindLeafletQuestion();
        }
    };

    window.nextBlindMainMapQuestion = function() {
        blindLeafletIndex++;
        blindLeafletLocked = false;
        blindLeafletClickedName = '';
        renderBlindLeafletQuestion();
    };

    function finishBlindLeafletQuiz() {
        destroyBlindLeafletMap();
        const stage = document.getElementById('blind-map-stage');
        if (!stage) return;

        const total = blindLeafletQuestions.length || 8;
        const score = Math.round((blindLeafletCorrect / total) * 100);

        if (blindLeafletXp > 0 && !blindLeafletRewardClaimed) {
            if (typeof addQuickQuizXpToHeader === 'function') {
                addQuickQuizXpToHeader(blindLeafletXp);
            }
            blindLeafletRewardClaimed = true;
        }

        let emoji = '🗺️';
        let title = 'Terus Berlatih Membaca Peta!';
        if (score >= 80) {
            emoji = '🏆';
            title = 'Hebat, Ahli Peta Nusantara!';
        } else if (score >= 60) {
            emoji = '🧭';
            title = 'Bagus, Penjelajah Nusantara!';
        }

        stage.innerHTML = `
            <div class="text-center py-4 sm:py-6">
                <div class="w-24 h-24 mx-auto rounded-[28px] bg-gradient-to-br from-blue-50 to-teal-100 border border-blue-100 flex items-center justify-center text-4xl shadow-inner">${emoji}</div>
                <p class="text-[9px] uppercase tracking-[0.16em] font-black text-teal-600 mt-4">Blind Map Selesai</p>
                <h3 class="text-xl font-black text-slate-900 mt-1">${title}</h3>
                <p class="text-xs text-slate-500 mt-2">Kamu menemukan ${blindLeafletCorrect} dari ${total} provinsi dengan benar.</p>

                <div class="grid grid-cols-3 gap-2 max-w-md mx-auto mt-5">
                    <div class="rounded-2xl bg-emerald-50 border border-emerald-100 p-3">
                        <p class="text-sm font-black text-emerald-800">${blindLeafletCorrect}/${total}</p>
                        <p class="text-[8px] font-bold text-emerald-600 mt-1">Benar</p>
                    </div>
                    <div class="rounded-2xl bg-blue-50 border border-blue-100 p-3">
                        <p class="text-sm font-black text-blue-800">${score}</p>
                        <p class="text-[8px] font-bold text-blue-600 mt-1">Skor / 100</p>
                    </div>
                    <div class="rounded-2xl bg-amber-50 border border-amber-100 p-3">
                        <p class="text-sm font-black text-amber-800">+${blindLeafletXp}</p>
                        <p class="text-[8px] font-bold text-amber-600 mt-1">XP</p>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-2 justify-center mt-6">
                    <button type="button" onclick="startBlindMapQuiz()"
                            class="rounded-xl bg-[#0f4b9b] hover:bg-blue-800 text-white px-6 py-3 text-[10px] font-black">
                        <i class="fas fa-rotate-right mr-1.5"></i>Main Lagi
                    </button>
                    <button type="button" onclick="closeBlindMapPanel()"
                            class="rounded-xl bg-white border border-slate-200 text-slate-600 px-6 py-3 text-[10px] font-black">
                        <i class="fas fa-arrow-left mr-1.5"></i>Kembali ke Quiz
                    </button>
                </div>
            </div>
        `;
    }

    // OVERRIDE FINAL: semua fungsi lama Blind Map diarahkan ke versi Peta Utama Leaflet.
    window.openBlindMapPanel = function() {
        [
            'quick-quiz-screen',
            'image-quiz-screen',
            'matching-quiz-screen',
            'time-challenge-screen',
            'teacher-assignments-section',
            'teacher-assignment-detail-screen',
            'teacher-lms-screen'
        ].forEach(id => document.getElementById(id)?.classList.add('hidden'));

        if (typeof stopTimeChallengeTimer === 'function') stopTimeChallengeTimer();

        const screen = document.getElementById('blind-map-screen');
        if (!screen) return;
        screen.classList.remove('hidden');
        renderBlindLeafletIntro();

        const scroller = screen.querySelector('.quiz-page-content');
        if (scroller) scroller.scrollTop = 0;
    };

    window.startBlindMapQuiz = async function() {
        const stage = document.getElementById('blind-map-stage');
        if (!stage) return;

        if (!getBlindGeoData()) {
            stage.innerHTML = `
                <div class="text-center py-12">
                    <i class="fas fa-spinner fa-spin text-3xl text-[#0f4b9b]"></i>
                    <p class="text-sm font-black text-slate-800 mt-4">Mengambil peta dari fitur Peta Utama...</p>
                    <p class="text-[9px] text-slate-500 mt-1">Tunggu sebentar, batas provinsi sedang disiapkan.</p>
                </div>
            `;

            try {
                // Gunakan loader yang telah ada pada versi sebelumnya.
                if (typeof window.retryBlindMapLoad === 'function') {
                    await Promise.resolve(window.retryBlindMapLoad());
                }

                // Beri kesempatan loader selesai menulis indonesiaGeoJSONData.
                let tries = 0;
                while (!getBlindGeoData() && tries < 30) {
                    await new Promise(resolve => setTimeout(resolve, 150));
                    tries++;
                }
            } catch (_) {}
        }

        if (!getBlindGeoData()) {
            stage.innerHTML = `
                <div class="text-center py-10">
                    <div class="w-16 h-16 mx-auto rounded-2xl bg-amber-50 border border-amber-100 text-amber-600 flex items-center justify-center">
                        <i class="fas fa-triangle-exclamation text-2xl"></i>
                    </div>
                    <h3 class="text-sm font-black text-slate-800 mt-4">Peta belum berhasil dimuat</h3>
                    <p class="text-[9.5px] text-slate-500 mt-2">Pastikan internet aktif lalu coba lagi.</p>
                    <button onclick="startBlindMapQuiz()" class="mt-4 rounded-xl bg-[#0f4b9b] text-white px-5 py-3 text-[9px] font-black">
                        <i class="fas fa-rotate-right mr-1"></i>Coba Lagi
                    </button>
                </div>`;
            return;
        }

        blindLeafletQuestions = buildBlindLeafletQuestions();
        if (blindLeafletQuestions.length < 4) {
            return;
        }

        blindLeafletIndex = 0;
        blindLeafletCorrect = 0;
        blindLeafletXp = 0;
        blindLeafletLocked = false;
        blindLeafletRewardClaimed = false;
        renderBlindLeafletQuestion();
    };

    window.closeBlindMapPanel = function() {
        destroyBlindLeafletMap();
        document.getElementById('blind-map-screen')?.classList.add('hidden');
    };

    // Kompatibilitas dengan nama fungsi lama.
    window.nextBlindMapQuestion = window.nextBlindMainMapQuestion;
})();
</script>

</body>
</html>
